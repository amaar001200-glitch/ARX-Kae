-- [[ Blox Fruits - Optimized Mega Hitbox (Anti-Lag Version) ]] --

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- إعدادات صندوق التصادم العملاق
local Settings = {
    HitboxSize = Vector3.new(40, 40, 40), 
    HitboxTransparency = 0.6,             
    HitboxColor = Color3.fromRGB(0, 0, 0)  -- تم التغيير إلى الأسود
}

-- جلب الريموت المسؤول عن تسجيل الضربات
local RegisterHitRemote = nil
pcall(function()
    RegisterHitRemote = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit")
end)

-- دالة لتطبيق المربع العملاق بشكل آمن ولمرة واحدة فقط
local function applyCustomHitbox(character)
    if not character or character == LocalPlayer.Character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- التحقق من أن الخصم حي، ولم يتم تعديل الـ Hitbox الخاص به من قبل (لمنع الـ Lag)
    if rootPart and humanoid and humanoid.Health > 0 and not rootPart:GetAttribute("HitboxModified") then
        
        -- وضع علامة لمنع إعادة تكرار الكود على نفس الخصم
        rootPart:SetAttribute("HitboxModified", true)
        
        -- تطبيق الحجم والخصائص المرئية
        rootPart.Size = Settings.HitboxSize
        rootPart.CanCollide = false
        rootPart.Transparency = Settings.HitboxTransparency
        rootPart.Color = Settings.HitboxColor
        rootPart.Material = Enum.Material.ForceField
        
        -- إنشاء حدث اللمس مرة واحدة فقط (يمنع الـ Memory Leak تماماً)
        rootPart.Touched:Connect(function(hit)
            if hit.Parent and hit.Parent:IsA("Tool") and hit.Parent.Parent == LocalPlayer.Character then
                if RegisterHitRemote then
                    pcall(function()
                        RegisterHitRemote:FireServer(rootPart, {}, nil, "747c0deb")
                    end)
                end
            end
        end)
    end
end

-- دالة لتحديث الحجم من الـ GUI
local function UpdateSize(NewSize)
    Settings.HitboxSize = Vector3.new(NewSize, NewSize, NewSize)
end

-- دالة لتشغيل/إيقاف السكريبت
local IsActive = true
local function SetActive(State)
    IsActive = State
end

-- دالة للتحقق إذا كان مفعل
local function IsEnabled()
    return IsActive
end

-- تشغيل الفحص في خلفية اللعبة بشكل ذكي وخفيف (مرة كل ثانية)
task.spawn(function()
    while true do
        if IsActive then
            -- 1. فحص اللاعبين الحقيقيين
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    applyCustomHitbox(player.Character)
                end
            end
            
            -- 2. فحص الأعداء والبوتات في الـ Workspace
            for _, object in pairs(workspace:GetChildren()) do
                if object:IsA("Model") and object:FindFirstChild("HumanoidRootPart") and object:FindFirstChildOfClass("Humanoid") then
                    applyCustomHitbox(object)
                end
            end
        end
        task.wait(1) -- فترة راحة للمعالج تمنع هبوط الفريمات نهائياً
    end
end)

-- API للربط مع الـ GUI الرئيسي
local API = {
    SetEnabled = SetActive,
    SetSize = UpdateSize,
    IsEnabled = IsEnabled
}

return API

print("[+] تم تشغيل السكربت المحسن بنجاح! الفريمات الآن مستقرة وثابتة.")
