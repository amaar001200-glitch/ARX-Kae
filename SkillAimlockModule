-- ============================================================================
-- ██ FIX 2: إضافة تفعيل المهارات المحفوظة داخل ApplyAllConfig
-- ============================================================================
local function ApplyAllConfig()
    pcall(function()
        if SkillAimlockModule then
            -- تفعيل زر الـ Master Toggle
            SkillAimlockModule:SetEnabled(Config.SkillAimlockEnabled)
            -- تفعيل كل مهارة على حدة بناءً على القيم المحفوظة
            SkillAimlockModule:SetSkill("Z", Config.SkillZ)
            SkillAimlockModule:SetSkill("X", Config.SkillX)
            SkillAimlockModule:SetSkill("C", Config.SkillC)
            SkillAimlockModule:SetSkill("V", Config.SkillV)
            SkillAimlockModule:SetSkill("F", Config.SkillF)
            SkillAimlockModule:SetDuration(Config.SkillAimlockDuration or 1)
        end
    end)

    -- ... (باقي الكود الأصلي لـ ApplyAllConfig يبقى كما هو دون تغيير) ...
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = Config.SpeedEnabled and Config.WalkSpeed or 16
        hum.JumpPower = Config.JumpEnabled and Config.JumpPower or 50
    end
    getgenv().AimbotActive = Config.AimbotActive
    pcall(function()
        if AimlockModule then
            AimlockModule:SetPlayerAimlock(Config.AimbotModuleActive)
            AimlockModule:SetNpcAimlock(Config.SilentAimNPC or false)
            AimlockModule:SetPrediction(Config.Prediction)
            if AimlockModule.SetPredictionTime then
                AimlockModule:SetPredictionTime(Config.FastAttackSpeed or 0.05)
            end
        end
    end)
    pcall(function()
        if StuffsModule then
            StuffsModule:SetAntiStun(Config.AntiStun)
            StuffsModule:SetWalkWater(Config.WaterWalk)
            StuffsModule:SetEscape(Config.EscapeActive)
            StuffsModule:SetEscapeHealth(Config.EscapeHealth)
            StuffsModule:SetBoatSpeed(Config.BoatSpeedEnabled)
            StuffsModule:SetBoatSpeedValue(Config.BoatSpeedValue)
            StuffsModule:SetBoatFly(Config.BoatFlyEnabled)
            StuffsModule:SetBoatFlyHeight(Config.BoatFlyHeight)
            StuffsModule:SetFpsBoost(Config.FpsBoost)
            StuffsModule:SetINFEnergy(Config.INFEnergy)
            StuffsModule:SetPingsOrFps(Config.FpsPingDisplay)
            if StuffsModule.SetFog then StuffsModule:SetFog(Config.RemoveFog) end
            if StuffsModule.SetLava then StuffsModule:SetLava(Config.RemoveLava) end
        end
    end)
    pcall(function()
        if Config.FastAttack then
            if StartFastAttack then StartFastAttack() end
        else
            if StopFastAttack then StopFastAttack() end
        end
    end)
    pcall(function()
        if ESPModule then
            ESPModule:SetBuso(Config.BusoEnabled)
            ESPModule:SetV3(Config.V3Enabled)
            ESPModule:SetBunnyhop(Config.BunnyHopEnabled)
            ESPModule:SetNoDodgeCD(Config.DodgeEnabled)
            if ESPModule.SetAntiAfk then ESPModule:SetAntiAfk(Config.AntiAFK or false) end
        end
    end)
    pcall(function()
        if UiSettingsModule then
            UiSettingsModule:SetV4(Config.V4Enabled)
            UiSettingsModule:SetGoToFruit(Config.GoToFruitActive)
            UiSettingsModule:SetAutoRandomFruit(Config.AutoRandomFruit)
            UiSettingsModule:SetFruitCheck(Config.FruitCheck)
            UiSettingsModule:SetTeleportFruit(Config.TeleportFruit)
        end
    end)
    pcall(function()
        if AutoKenModule then AutoKenModule:SetAutoKen(Config.AutoKenEnabled) end
    end)
    pcall(function()
        if ZSkillModule then
            ZSkillModule:SetZSkills(Config.ZSkills)
            ZSkillModule:SetInfo(Config.TargetInfo)
        end
    end)
    pcall(function()
        if Config.FruitCheck then
            if StartFruitNotifier then StartFruitNotifier() end
        else
            if StopFruitNotifier then StopFruitNotifier() end
        end
    end)
    
    -- خط إضافي: تحديث موديل المهارات إذا كان موجوداً
    pcall(function()
        if SkillAimlockModule and SkillAimlockModule.UpdateConfig then
            SkillAimlockModule:UpdateConfig()
        end
    end)
end

