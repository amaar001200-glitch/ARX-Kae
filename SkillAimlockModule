-- █ MODULE: SKILL AIMLOCK (FIXED - المستمر)

return function(env)

local Config = env.Config

-- █ MODULE: SKILL AIMLOCK
local SkillAimlockModule = {}

do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Workspace = game:GetService("Workspace")
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local UserInputService = game:GetService("UserInputService")

    local Enabled = false
    local MaxDistance = 300

    -- متغيرات للضغط المستمر
    local activeSkills = {}  -- تخزين المهارات التي يتم الضغط عليها حالياً
    local currentTarget = nil
    local aimRenderConn = nil
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

    -- دالة للحصول على أقرب هدف
    local function getNearestTarget()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return nil
        end

        local nearest = nil
        local shortest = MaxDistance

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local ehrp = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildOfClass("Humanoid")

                if ehrp and h and h.Health > 0 then
                    -- التحقق من الصديق والتحالف حسب الفريق
                    if p.Team == LocalPlayer.Team then
                        -- نفس الفريق = صديق -> يتجنبه
                        if Config.AvoidFriends then
                            goto skip
                        end
                    end
                    
                    local dist = (ehrp.Position - hrp.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = p.Character
                    end
                end
            end
            ::skip::
        end
        return nearest
    end

    -- دالة إيقاف Aimlock
    local function stopAimlock()
        if aimRenderConn then
            aimRenderConn:Disconnect()
            aimRenderConn = nil
        end
        currentTarget = nil
    end

    -- دالة بدء Aimlock
    local function startAimlock(target)
        if not Enabled or not target then
            return
        end

        local targetHRP = target:FindFirstChild("HumanoidRootPart")
        if not targetHRP then
            return
        end

        currentTarget = target
        
        -- إذا كان الريندر شغال، نوقفه ونشغله من جديد
        if aimRenderConn then
            aimRenderConn:Disconnect()
            aimRenderConn = nil
        end

        aimRenderConn = RunService.RenderStepped:Connect(function()
            if not Enabled then
                stopAimlock()
                return
            end
            
            -- التحقق من وجود المهارات النشطة
            local hasActiveSkill = false
            for skill, isActive in pairs(activeSkills) do
                if isActive then
                    hasActiveSkill = true
                    break
                end
            end
            
            if not hasActiveSkill then
                stopAimlock()
                return
            end
            
            -- التحقق من الهدف الحالي
            local targetHRP = currentTarget and currentTarget:FindFirstChild("HumanoidRootPart")
            if not targetHRP then
                -- محاولة البحث عن هدف جديد
                local newTarget = getNearestTarget()
                if newTarget then
                    currentTarget = newTarget
                    targetHRP = currentTarget:FindFirstChild("HumanoidRootPart")
                end
                
                if not targetHRP then
                    return
                end
            end
            
            -- تثبيت الكاميرا على الهدف
            local camPos = Camera.CFrame.Position
            Camera.CFrame = CFrame.new(camPos, targetHRP.Position)
        end)
    end

    -- هوك المهارات
    if not getgenv().SkillAimlock_Hooked then
        getgenv().SkillAimlock_Hooked = true

        local oldNamecall
        local oldIndex

        -- هوك لالتقاط استدعاءات المهارات
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if (method == "InvokeServer" or method == "FireServer") and Enabled then
                local a1 = args[1]

                if typeof(a1) == "string" then
                    local skillKey = a1:upper()

                    if Config["Skill" .. skillKey] then
                        task.spawn(function()
                            local target = getNearestTarget()
                            if target then
                                startAimlock(target)
                            end
                        end)
                    end
                end
            end

            return oldNamecall(self, ...)
        end)
        
        -- هوك لالتقاط انتهاء المهارة (عندما يرفع اللاعب إصبعه عن المفتاح)
        -- هذا يعتمد على VirtualInputManager أو استخدام InputEnded
        local function onInputEnded(input, gameProcessed)
            if gameProcessed then return end
            
            -- التحقق من المفاتيح المرتبطة بالمهارات
            local keyMap = {
                [Enum.KeyCode.Z] = "Z",
                [Enum.KeyCode.X] = "X", 
                [Enum.KeyCode.C] = "C",
                [Enum.KeyCode.V] = "V",
                [Enum.KeyCode.F] = "F",
                [Enum.KeyCode.One] = "ONE",
                [Enum.KeyCode.Two] = "TWO",
                [Enum.KeyCode.Three] = "THREE",
                [Enum.KeyCode.Four] = "FOUR"
            }
            
            local skillName = keyMap[input.KeyCode]
            if skillName and activeSkills[skillName] then
                activeSkills[skillName] = false
                -- التحقق إذا لم يعد هناك أي مهارة نشطة
                local anyActive = false
                for _, active in pairs(activeSkills) do
                    if active then
                        anyActive = true
                        break
                    end
                end
                if not anyActive then
                    stopAimlock()
                end
            end
        end
        
        -- ربط حدث انتهاء الضغط
        UserInputService.InputEnded:Connect(onInputEnded)
    end

    -- دالة لتسجيل بداية الضغط على مهارة (يتم استدعاؤها من مكان آخر)
    function SkillAimlockModule:RegisterSkillPress(skillKey)
        if not Enabled then return end
        activeSkills[skillKey] = true
        
        -- بدء الـ Aimlock على أقرب هدف
        local target = getNearestTarget()
        if target then
            startAimlock(target)
        end
    end
    
    -- دالة لتسجيل انتهاء الضغط على مهارة
    function SkillAimlockModule:RegisterSkillRelease(skillKey)
        activeSkills[skillKey] = false
        
        -- التحقق إذا لم يعد هناك أي مهارة نشطة
        local anyActive = false
        for _, active in pairs(activeSkills) do
            if active then
                anyActive = true
                break
            end
        end
        if not anyActive then
            stopAimlock()
        end
    end

    function SkillAimlockModule:SetEnabled(state)
        Enabled = state
        Config.SkillAimlockEnabled = state
        if not state then
            stopAimlock()
            activeSkills = {}
        end
    end

    function SkillAimlockModule:SetSkill(skill, state)
        Config["Skill" .. skill] = state
    end

    function SkillAimlockModule:SetMaxDistance(distance)
        MaxDistance = distance
    end

    function SkillAimlockModule:UpdateConfig()
        Enabled = Config.SkillAimlockEnabled
    end

    -- تحديث الإعدادات من Config عند بدء التشغيل
    SkillAimlockModule:UpdateConfig()

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        char = newChar
        stopAimlock()
        activeSkills = {}
    end)
end

return SkillAimlockModule

end
