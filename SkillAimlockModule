-- █ MODULE: SKILL AIMLOCK (FIXED - مراقبة المفاتيح المباشرة)

return function(env)

local Config = env.Config

-- █ MODULE: SKILL AIMLOCK
local SkillAimlockModule = {}

do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Workspace = game:GetService("Workspace")
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local UserInputService = game:GetService("UserInputService")

    local Enabled = false
    local MaxDistance = 300

    -- متغيرات للضغط المستمر
    local activeKeys = {}     -- المفاتيح المضغوطة حالياً
    local currentTarget = nil
    local aimRenderConn = nil
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    
    -- قائمة المفاتيح التي نهتم بها (المهارات)
    local TrackedKeys = {
        [Enum.KeyCode.Z] = "Z",
        [Enum.KeyCode.X] = "X",
        [Enum.KeyCode.C] = "C",
        [Enum.KeyCode.V] = "V",
        [Enum.KeyCode.F] = "F",
        [Enum.KeyCode.One] = "One",
        [Enum.KeyCode.Two] = "Two",
        [Enum.KeyCode.Three] = "Three",
        [Enum.KeyCode.Four] = "Four",
    }

    -- دالة للحصول على أقرب هدف (مع تجنب الأصدقاء)
    local function getNearestTarget()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return nil
        end

        local nearest = nil
        local shortest = MaxDistance

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local ehrp = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildOfClass("Humanoid")

                if ehrp and h and h.Health > 0 then
                    -- تجنب الأصدقاء (نفس الفريق)
                    if p.Team == LocalPlayer.Team then
                        -- إذا كان تفادي الأصدقاء مفعلاً
                        if Config.AvoidFriends then
                            goto skip
                        end
                    end
                    
                    local dist = (ehrp.Position - hrp.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = p.Character
                    end
                end
            end
            ::skip::
        end
        return nearest
    end

    -- دالة إيقاف Aimlock
    local function stopAimlock()
        if aimRenderConn then
            aimRenderConn:Disconnect()
            aimRenderConn = nil
        end
        currentTarget = nil
    end

    -- دالة بدء Aimlock
    local function startAimlock(target)
        if not Enabled or not target then
            return
        end

        local targetHRP = target:FindFirstChild("HumanoidRootPart")
        if not targetHRP then
            return
        end

        currentTarget = target
        
        -- إذا كان الريندر شغال، نوقفه ونشغله من جديد
        if aimRenderConn then
            aimRenderConn:Disconnect()
            aimRenderConn = nil
        end

        aimRenderConn = RunService.RenderStepped:Connect(function()
            if not Enabled then
                stopAimlock()
                return
            end
            
            -- التحقق من وجود أي مفتاح مهارة مضغوط
            local hasActiveKey = false
            for keyCode, isPressed in pairs(activeKeys) do
                if isPressed then
                    local skillName = TrackedKeys[keyCode]
                    if skillName and Config["Skill" .. skillName] then
                        hasActiveKey = true
                        break
                    end
                end
            end
            
            if not hasActiveKey then
                stopAimlock()
                return
            end
            
            -- التحقق من الهدف الحالي
            local targetHRP = currentTarget and currentTarget:FindFirstChild("HumanoidRootPart")
            if not targetHRP then
                -- محاولة البحث عن هدف جديد
                local newTarget = getNearestTarget()
                if newTarget then
                    currentTarget = newTarget
                    targetHRP = currentTarget:FindFirstChild("HumanoidRootPart")
                end
                
                if not targetHRP then
                    return
                end
            end
            
            -- تثبيت الكاميرا على الهدف
            local camPos = Camera.CFrame.Position
            Camera.CFrame = CFrame.new(camPos, targetHRP.Position)
        end)
    end
    
    -- دالة لفحص وتحديث حالة الـ Aimlock بناءً على المفاتيح النشطة
    local function updateAimlockState()
        if not Enabled then
            stopAimlock()
            return
        end
        
        -- البحث عن أي مفتاح مهارة نشط ومفعل في الـ Config
        local anyActiveSkill = false
        for keyCode, isPressed in pairs(activeKeys) do
            if isPressed then
                local skillName = TrackedKeys[keyCode]
                if skillName and Config["Skill" .. skillName] then
                    anyActiveSkill = true
                    break
                end
            end
        end
        
        if anyActiveSkill then
            -- يوجد مفتاح مهارة نشط، شغل الـ Aimlock إذا ما كان شغال
            if not aimRenderConn then
                local target = getNearestTarget()
                if target then
                    startAimlock(target)
                end
            end
        else
            -- ما فيه مفتاح نشط، أوقف الـ Aimlock
            stopAimlock()
        end
    end

    -- ==================================================
    -- مراقبة المفاتيح مباشرة
    -- ==================================================
    
    -- حدث الضغط على المفتاح
    local function onInputBegan(input, gameProcessed)
        if gameProcessed then return end
        
        local keyCode = input.KeyCode
        local skillName = TrackedKeys[keyCode]
        
        if skillName and Config["Skill" .. skillName] then
            activeKeys[keyCode] = true
            updateAimlockState()
        end
    end
    
    -- حدث رفع الإصبع عن المفتاح
    local function onInputEnded(input, gameProcessed)
        local keyCode = input.KeyCode
        local skillName = TrackedKeys[keyCode]
        
        if skillName then
            activeKeys[keyCode] = false
            updateAimlockState()
        end
    end
    
    -- ربط الأحداث
    UserInputService.InputBegan:Connect(onInputBegan)
    UserInputService.InputEnded:Connect(onInputEnded)

    -- هوك المهارات (احتياطي لبعض السيرفرات)
    if not getgenv().SkillAimlock_Hooked then
        getgenv().SkillAimlock_Hooked = true

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if (method == "InvokeServer" or method == "FireServer") and Enabled then
                local a1 = args[1]

                if typeof(a1) == "string" then
                    local skillKey = a1:upper()
                    if Config["Skill" .. skillKey] then
                        -- فقط نتأكد أن الـ Aimlock شغال
                        if not aimRenderConn then
                            local target = getNearestTarget()
                            if target then
                                startAimlock(target)
                            end
                        end
                    end
                end
            end

            return oldNamecall(self, ...)
        end)
    end

    -- دوال التحكم
    function SkillAimlockModule:SetEnabled(state)
        Enabled = state
        Config.SkillAimlockEnabled = state
        if not state then
            stopAimlock()
            activeKeys = {}
        end
    end

    function SkillAimlockModule:SetSkill(skill, state)
        Config["Skill" .. skill] = state
    end

    function SkillAimlockModule:SetMaxDistance(distance)
        MaxDistance = distance
    end

    function SkillAimlockModule:UpdateConfig()
        Enabled = Config.SkillAimlockEnabled
    end

    -- تحديث الإعدادات من Config
    SkillAimlockModule:UpdateConfig()

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        char = newChar
        stopAimlock()
        activeKeys = {}
    end)
end

return SkillAimlockModule

end
