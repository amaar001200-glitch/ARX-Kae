-- █ ARAKS HUB | ESP MODULE (خفيف - نفس الشكل الأصلي)
-- زر واحد للاعبين | زر منفصل للفواكه

local ESPDrawingModule = {}

do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    
    -- ===== الأزرار =====
    local PlayerESP = false   -- زر واحد لكل رادارات اللاعبين
    local FruitESP = false    -- زر منفصل للفواكه
    
    -- ===== عناصر اللاعبين (نفس الشكل الأصلي) =====
    local Boxes = {}
    local NameTags = {}
    local HealthBars = {}
    local LevelTags = {}
    local DistTags = {}
    
    -- ===== عناصر الفواكه =====
    local FruitNames = {"Rocket","Spin","Blade","Spring","Bomb","Smoke","Spike","Flame","Ice","Sand","Dark","Diamond","Light","Magma","Quake","Buddha","Spider","Phoenix","Rumble","Dough","Shadow","Venom","Leopard","Kitsune","Dragon"}
    local FruitText = nil
    local lastFruitUpdate = 0
    local cachedFruits = {}
    
    -- ===== دوال اللاعبين =====
    local function CreatePlayerESP(plr)
        if plr == LocalPlayer then return end
        
        Boxes[plr] = Drawing.new("Square")
        Boxes[plr].Thickness = 1
        Boxes[plr].Filled = false
        Boxes[plr].Color = Color3.fromRGB(255,0,0)
        Boxes[plr].Visible = false
        
        NameTags[plr] = Drawing.new("Text")
        NameTags[plr].Size = 14
        NameTags[plr].Center = true
        NameTags[plr].Outline = true
        NameTags[plr].Color = Color3.new(1,1,1)
        NameTags[plr].Visible = false
        
        HealthBars[plr] = Drawing.new("Square")
        HealthBars[plr].Thickness = 1
        HealthBars[plr].Filled = true
        HealthBars[plr].Color = Color3.fromRGB(0,255,0)
        HealthBars[plr].Visible = false
        
        LevelTags[plr] = Drawing.new("Text")
        LevelTags[plr].Size = 13
        LevelTags[plr].Center = true
        LevelTags[plr].Outline = true
        LevelTags[plr].Color = Color3.fromRGB(255,255,0)
        LevelTags[plr].Visible = false
        
        DistTags[plr] = Drawing.new("Text")
        DistTags[plr].Size = 13
        DistTags[plr].Center = true
        DistTags[plr].Outline = true
        DistTags[plr].Color = Color3.fromRGB(200,200,200)
        DistTags[plr].Visible = false
    end
    
    local function RemovePlayerESP(plr)
        if Boxes[plr] then pcall(function() Boxes[plr]:Remove() end); Boxes[plr] = nil end
        if NameTags[plr] then pcall(function() NameTags[plr]:Remove() end); NameTags[plr] = nil end
        if HealthBars[plr] then pcall(function() HealthBars[plr]:Remove() end); HealthBars[plr] = nil end
        if LevelTags[plr] then pcall(function() LevelTags[plr]:Remove() end); LevelTags[plr] = nil end
        if DistTags[plr] then pcall(function() DistTags[plr]:Remove() end); DistTags[plr] = nil end
    end
    
    -- ===== دوال الفواكه =====
    local function CreateFruitText()
        if FruitText then pcall(function() FruitText:Remove() end) end
        FruitText = Drawing.new("Text")
        FruitText.Size = 14
        FruitText.Center = true
        FruitText.Outline = true
        FruitText.Color = Color3.fromRGB(0,255,100)
        FruitText.Visible = false
    end
    
    -- ===== تجهيز أولي =====
    for _, plr in pairs(Players:GetPlayers()) do CreatePlayerESP(plr) end
    Players.PlayerAdded:Connect(CreatePlayerESP)
    Players.PlayerRemoving:Connect(RemovePlayerESP)
    CreateFruitText()
    
    -- ===== حلقة الرسم (خفيفة جداً) =====
    RunService.RenderStepped:Connect(function()
        -- ===== اللاعبين =====
        if PlayerESP then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and Boxes[plr] then
                    local char = plr.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChild("Humanoid")
                    
                    if char and root and hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        
                        if onScreen then
                            local sizeX = 2300 / pos.Z
                            local sizeY = sizeX * 1.5
                            local boxPos = Vector2.new(pos.X - sizeX/2, pos.Y - sizeY/2)
                            local hpPercent = hum.Health / hum.MaxHealth
                            local boxColor = Color3.fromHSV(hpPercent * 0.3, 1, 1)
                            
                            -- Box
                            Boxes[plr].Visible = true
                            Boxes[plr].Size = Vector2.new(sizeX, sizeY)
                            Boxes[plr].Position = boxPos
                            Boxes[plr].Color = boxColor
                            
                            -- Health Bar
                            HealthBars[plr].Visible = true
                            HealthBars[plr].Size = Vector2.new(3, sizeY)
                            HealthBars[plr].Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                            HealthBars[plr].Color = boxColor
                            
                            -- Name
                            NameTags[plr].Visible = true
                            NameTags[plr].Text = plr.Name
                            NameTags[plr].Position = Vector2.new(pos.X, boxPos.Y - 20)
                            
                            -- Level
                            local data = plr:FindFirstChild("Data") or plr:FindFirstChild("leaderstats")
                            local lvl = data and (data:FindFirstChild("Level") or data:FindFirstChild("Mivai"))
                            LevelTags[plr].Visible = true
                            LevelTags[plr].Text = "Lv. " .. (lvl and lvl.Value or "???")
                            LevelTags[plr].Position = Vector2.new(pos.X, boxPos.Y - 35)
                            
                            -- Distance
                            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if myRoot then
                                local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                                DistTags[plr].Visible = true
                                DistTags[plr].Text = "[" .. dist .. "m]"
                                DistTags[plr].Position = Vector2.new(pos.X, boxPos.Y + sizeY + 5)
                            end
                        else
                            Boxes[plr].Visible = false
                            NameTags[plr].Visible = false
                            HealthBars[plr].Visible = false
                            LevelTags[plr].Visible = false
                            DistTags[plr].Visible = false
                        end
                    else
                        Boxes[plr].Visible = false
                        NameTags[plr].Visible = false
                        HealthBars[plr].Visible = false
                        LevelTags[plr].Visible = false
                        DistTags[plr].Visible = false
                    end
                end
            end
        else
            -- إخفاء كل شيء
            for _, plr in pairs(Players:GetPlayers()) do
                if Boxes[plr] then
                    Boxes[plr].Visible = false
                    NameTags[plr].Visible = false
                    HealthBars[plr].Visible = false
                    LevelTags[plr].Visible = false
                    DistTags[plr].Visible = false
                end
            end
        end
        
        -- ===== الفواكه (منفصل) =====
        if FruitESP then
            if tick() - lastFruitUpdate > 0.5 then
                cachedFruits = {}
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Tool") then
                        for _, name in ipairs(FruitNames) do
                            if string.find(v.Name, name) then
                                cachedFruits[#cachedFruits + 1] = v
                                break
                            end
                        end
                    end
                end
                lastFruitUpdate = tick()
            end
            
            local found = false
            for _, v in pairs(cachedFruits) do
                if v and v.Parent then
                    local handle = v:FindFirstChild("Handle") or v
                    local pos, onScreen = Camera:WorldToViewportPoint(handle.Position)
                    if onScreen then
                        FruitText.Text = v.Name
                        FruitText.Position = Vector2.new(pos.X, pos.Y)
                        FruitText.Visible = true
                        found = true
                        break
                    end
                end
            end
            if not found then FruitText.Visible = false end
        else
            if FruitText then FruitText.Visible = false end
        end
    end)
    
    -- ===== دوال التحكم من واجهتك =====
    function ESPDrawingModule:SetPlayerESP(state)
        PlayerESP = state
    end
    
    function ESPDrawingModule:SetFruitESP(state)
        FruitESP = state
    end
    
    function ESPDrawingModule:GetPlayerESP()
        return PlayerESP
    end
    
    function ESPDrawingModule:GetFruitESP()
        return FruitESP
    end
end

return ESPDrawingModule
