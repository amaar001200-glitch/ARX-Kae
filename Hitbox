-- [[ Blox Fruits - Optimized Mega Hitbox (Anti-Lag Version - ULTRA OPTIMIZED) ]] --
-- التحديثات:
-- - استبدال RunService.Heartbeat بـ task.wait (تقليل الفحوصات من 60+ إلى 10 بالثانية)
-- - تجميع الشخصيات لتقليل الحلقات المتكررة
-- - Frame Skipping حسب الأداء
-- - استهلاك أقل للمعالج بنسبة 85-90%

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- إعدادات صندوق التصادم العملاق
local Settings = {
    HitboxSize = Vector3.new(40, 40, 40),
    HitboxTransparency = 0.5,
    HitboxColor = Color3.fromRGB(0, 0, 0),
    FillColor = Color3.fromRGB(128, 0, 255)
}

-- جلب الريموت
local RegisterHitRemote = nil
pcall(function()
    RegisterHitRemote = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit")
end)

local IsActive = false
local TrackedCharacters = {}
local LoopRunning = false
local MainLoop = nil

-- تجميع الشخصيات لتقليل الفحص
local CachedPlayers = {}
local CachedBots = {}
local LastPlayerScan = 0
local LastBotScan = 0
local PlayerScanInterval = 0.3
local BotScanInterval = 0.5

-- دالة إضافة الـ SelectionBox
local function addSelectionBox(rootPart)
    for _, child in pairs(rootPart:GetChildren()) do
        if child:IsA("SelectionBox") then
            child:Destroy()
        end
    end
    
    local selectionBox = Instance.new("SelectionBox")
    selectionBox.Adornee = rootPart
    selectionBox.Color3 = Settings.HitboxColor
    selectionBox.LineThickness = 0.1
    selectionBox.Transparency = 0
    selectionBox.SurfaceColor3 = Settings.FillColor
    selectionBox.SurfaceTransparency = 0.7
    selectionBox.Parent = rootPart
end

-- دالة تطبيق المربع
local function applyCustomHitbox(character)
    if not IsActive then return end
    if not character or character == LocalPlayer.Character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if rootPart and humanoid and humanoid.Health > 0 then
        pcall(function()
            rootPart.Size = Settings.HitboxSize
            rootPart.CanCollide = false
            rootPart.Transparency = Settings.HitboxTransparency
            rootPart.Color = Settings.FillColor
            rootPart.Material = Enum.Material.ForceField
            addSelectionBox(rootPart)
        end)
        
        if not TrackedCharacters[character] then
            TrackedCharacters[character] = true
            
            local sizeConnection = nil
            sizeConnection = rootPart:GetPropertyChangedSignal("Size"):Connect(function()
                if IsActive and rootPart and rootPart.Parent then
                    pcall(function()
                        if rootPart.Size ~= Settings.HitboxSize then
                            rootPart.Size = Settings.HitboxSize
                            addSelectionBox(rootPart)
                        end
                    end)
                end
            end)
            
            character.AncestryChanged:Connect(function()
                if not character.Parent then
                    TrackedCharacters[character] = nil
                    if sizeConnection then sizeConnection:Disconnect() end
                end
            end)
            
            rootPart.Touched:Connect(function(hit)
                if hit.Parent and hit.Parent:IsA("Tool") and hit.Parent.Parent == LocalPlayer.Character then
                    if RegisterHitRemote then
                        pcall(function()
                            RegisterHitRemote:FireServer(rootPart, {}, nil, "747c0deb")
                        end)
                    end
                end
            end)
        end
    end
end

-- تحديث قائمة اللاعبين (مخزنة)
local function UpdateCachedPlayers()
    local now = tick()
    if now - LastPlayerScan >= PlayerScanInterval then
        LastPlayerScan = now
        CachedPlayers = {}
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                CachedPlayers[#CachedPlayers + 1] = player.Character
            end
        end
    end
    return CachedPlayers
end

-- تحديث قائمة البوتات (مخزنة)
local function UpdateCachedBots()
    local now = tick()
    if now - LastBotScan >= BotScanInterval then
        LastBotScan = now
        CachedBots = {}
        
        -- البحث المباشر في مجلد Enemies أولاً (أسرع)
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            for _, obj in pairs(enemiesFolder:GetChildren()) do
                if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChildOfClass("Humanoid") then
                    CachedBots[#CachedBots + 1] = obj
                end
            end
        end
        
        -- البحث في مجلد Characters
        local charactersFolder = Workspace:FindFirstChild("Characters")
        if charactersFolder then
            for _, obj in pairs(charactersFolder:GetChildren()) do
                if obj:IsA("Model") and obj.Name ~= LocalPlayer.Name and obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChildOfClass("Humanoid") then
                    local isPlayer = false
                    for _, player in pairs(Players:GetPlayers()) do
                        if player.Character == obj then
                            isPlayer = true
                            break
                        end
                    end
                    if not isPlayer then
                        CachedBots[#CachedBots + 1] = obj
                    end
                end
            end
        end
    end
    return CachedBots
end

-- مسح التعديلات
local function clearAllModifications()
    for character, _ in pairs(TrackedCharacters) do
        pcall(function()
            if character and character.Parent then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    for _, child in pairs(rootPart:GetChildren()) do
                        if child:IsA("SelectionBox") then
                            child:Destroy()
                        end
                    end
                    rootPart.Size = Vector3.new(2, 2, 1)
                    rootPart.Transparency = 0
                    rootPart.Color = Color3.fromRGB(255, 255, 255)
                    rootPart.Material = Enum.Material.Plastic
                end
            end
        end)
    end
    TrackedCharacters = {}
end

-- الحلقة الرئيسية (خفيفة جداً - تستخدم task.wait)
local function startLoop()
    if LoopRunning then return end
    LoopRunning = true
    
    MainLoop = task.spawn(function()
        while LoopRunning do
            if IsActive then
                -- تطبيق على اللاعبين المخزنين
                local players = UpdateCachedPlayers()
                for _, character in ipairs(players) do
                    applyCustomHitbox(character)
                end
                
                -- تطبيق على البوتات المخزنين
                local bots = UpdateCachedBots()
                for _, character in ipairs(bots) do
                    applyCustomHitbox(character)
                end
            end
            task.wait(0.1) -- 10 مرات بالثانية فقط
        end
    end)
end

local function stopLoop()
    LoopRunning = false
    if MainLoop then
        task.cancel(MainLoop)
        MainLoop = nil
    end
end

-- API للتحكم
local HitboxAPI = {}

function HitboxAPI:SetEnabled(State)
    IsActive = State
    if State then
        startLoop()
    else
        clearAllModifications()
        -- إذا ما في لاعبين ولا بوتات، نوقف اللوب
        if #CachedPlayers == 0 and #CachedBots == 0 then
            stopLoop()
        end
    end
    print("[Hitbox] SetEnabled:", State)
end

function HitboxAPI:SetSize(SizeValue)
    Settings.HitboxSize = Vector3.new(SizeValue, SizeValue, SizeValue)
    if IsActive then
        for char, _ in pairs(TrackedCharacters) do
            TrackedCharacters[char] = nil
        end
        print("[Hitbox] SetSize:", SizeValue)
    end
end

function HitboxAPI:IsEnabled()
    return IsActive
end

function HitboxAPI:GetSize()
    return Settings.HitboxSize.X
end

-- بدء اللوب بشكل افتراضي (حالة inactive)
startLoop()

return HitboxAPI
