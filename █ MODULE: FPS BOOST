return function(shared)

    local Config = shared.Config
    local Lighting = game:GetService("Lighting")
    local Workspace = game:GetService("Workspace")

    -- █ MODULE: FPS BOOST (with debounce optimization)
    local FpsBoostConnection = nil
    local lastDescendantProcess = 0

    local module = {}

    function module.Start()

        if FpsBoostConnection then
            FpsBoostConnection:Disconnect()
        end

        Lighting.FogEnd = 1e9
        Lighting.FogStart = 1e9
        Lighting.ClockTime = 12
        Lighting.GlobalShadows = false
        Lighting.Brightness = 2
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)

        local Terrain = Workspace:FindFirstChildOfClass("Terrain")

        if Terrain then
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveSpeed = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 1
        end

        for _, v in ipairs(Workspace:GetDescendants()) do

            if v:IsA("BasePart") then

                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
                v.CastShadow = false

            elseif v:IsA("ParticleEmitter") then

                v.Lifetime = NumberRange.new(0, 0)

            elseif v:IsA("Fire") or v:IsA("Smoke") then

                v.Enabled = false

            end
        end

        FpsBoostConnection = Workspace.DescendantAdded:Connect(function(v)

            if not Config.FpsBoost then
                return
            end

            local now = tick()

            if now - lastDescendantProcess < 0.05 then
                return
            end

            lastDescendantProcess = now

            if v:IsA("ParticleEmitter") then

                v.Lifetime = NumberRange.new(0, 0)

            elseif v:IsA("BasePart") then

                v.CastShadow = false

            elseif v:IsA("Fire") or v:IsA("Smoke") then

                v.Enabled = false

            end
        end)

    end

    function module.Stop()

        if FpsBoostConnection then
            FpsBoostConnection:Disconnect()
            FpsBoostConnection = nil
        end

    end

    return module

end
