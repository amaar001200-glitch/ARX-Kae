-- █ MODULE: FPS & PING DISPLAY

return function(env)
    local Config = env.Config
    local LocalPlayer = env.LocalPlayer
    local RunService = env.RunService
    local Stats = env.Stats

    local FPSGui = nil
    local FPSConnection = nil
    local FPSLabel = nil

    local function CreateDisplay()
        if FPSGui then
            pcall(function() FPSGui:Destroy() end)
            FPSGui = nil
        end
        if FPSConnection then
            pcall(function() FPSConnection:Disconnect() end)
            FPSConnection = nil
        end

        local gui = Instance.new("ScreenGui")
        gui.Name = "ARAKS_FPS_GUI"
        gui.ResetOnSpawn = false
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(0, 160, 0, 25)
        label.Position = UDim2.new(1, -170, 0, 10)
        label.AnchorPoint = Vector2.new(1, 0)
        label.BackgroundTransparency = 1
        label.Text = "FPS: 0 | Ping: 0ms"
        label.TextSize = 14
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = Color3.fromRGB(0, 255, 0)

        local frameCount = 0
        local lastTime = tick()

        local conn = RunService.RenderStepped:Connect(function()
            if not gui or not gui.Parent then return end
            frameCount = frameCount + 1
            if tick() - lastTime >= 1 then
                local fps = frameCount
                frameCount = 0
                lastTime = tick()
                local ping = 0
                pcall(function()
                    ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                end)
                label.Text = string.format("FPS: %d  |  Ping: %dms", fps, ping)
                if fps >= 50 then
                    label.TextColor3 = Color3.fromRGB(0, 255, 0)
                elseif fps >= 30 then
                    label.TextColor3 = Color3.fromRGB(255, 255, 0)
                else
                    label.TextColor3 = Color3.fromRGB(255, 0, 0)
                end
            end
        end)

        FPSGui = gui
        FPSConnection = conn
        FPSLabel = label
    end

    local function DestroyDisplay()
        if FPSConnection then
            FPSConnection:Disconnect()
            FPSConnection = nil
        end
        if FPSGui then
            FPSGui:Destroy()
            FPSGui = nil
        end
        FPSLabel = nil
    end

    local module = {}

    function module.Start()
        if Config.FpsPingDisplay then
            CreateDisplay()
        end
    end

    function module.Stop()
        DestroyDisplay()
    end

    function module.Update()
        if Config.FpsPingDisplay then
            CreateDisplay()
        else
            DestroyDisplay()
        end
    end

    -- بدء التشغيل إذا كان مفعلاً في الإعدادات
    if Config.FpsPingDisplay then
        CreateDisplay()
    end

    return module
end
