-- █ AIMBOT (SILENT) - OPTIMIZED (reduced update frequency)
-- تم تصليح الموديول ليكون جاهزاً للرفع والاستخدام
-- تم التعديل: القراصنة يستهدفون الكل، البحرية تستهدف القراصنة فقط
-- تم استبدال Hitbox البوتات بـ Hitbox اللاعبين (حجم 60 - مخفي)

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1500,
        SwordRange = 1000,
    }

    -- ========== Hitbox اللاعبين (جديد) ==========
    local HitboxSettings = {
        Size = Vector3.new(60, 60, 60),
        Transparency = 1,
    }
    local IsHitboxActive = false

    local CombatController = nil
    pcall(function()
        CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    end)

    -- ==================================================
    -- التحقق من العدو/الصديق حسب الفريق (معدل)
    -- ==================================================
    
    local function IsValidEnemy(plr)
        if not plr then return false end
        
        -- لا تستهدف نفسك
        if plr == player then return false end
        
        -- التحقق إذا كان الهدف على قيد الحياة
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        -- ==================================================
        -- القاعدة الجديدة:
        -- القراصنة (Pirates) يستهدفون الكل (بحرية + قراصنة)
        -- البحرية (Marines) تستهدف القراصنة فقط
        -- ==================================================
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        -- إذا كان اللاعب قرصان -> يستهدف الكل
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        -- إذا كان اللاعب بحري -> يستهدف القراصنة فقط
        if myTeam and myTeam.Name == "Marines" then
            if targetTeam and targetTeam.Name == "Pirates" then
                return true
            else
                return false
            end
        end
        
        -- في حال عدم وجود فريق (حماية)
        return true
    end
    
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local DefaultSize = Vector3.new(2,2,1)

    local TargetLine = Drawing.new("Line")
    TargetLine.Color = Color3.fromRGB(180, 0, 255)
    TargetLine.Thickness = 2
    TargetLine.Transparency = 1
    TargetLine.Visible = false

    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myHrp.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end

    task.spawn(function()
        while true do
            if getgenv().AimbotActive then
                local targetCandidate = GetNearestEnemy()
                if targetCandidate and targetCandidate.Character then
                    CurrentTarget = targetCandidate
                    local hrp = targetCandidate.Character:FindFirstChild(AimbotConfig.TargetPart)
                    if hrp then
                        CurrentTargetPos = hrp.Position + Vector3.new(0, 0.5, 0)
                    else
                        CurrentTargetPos = nil
                    end
                else
                    CurrentTarget = nil
                    CurrentTargetPos = nil
                end
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
            end
            task.wait(0.1)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive or not CurrentTargetPos then
            TargetLine.Visible = false
            return
        end
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then TargetLine.Visible = false; return end
        local myPos, myVisible = Camera:WorldToViewportPoint(myHrp.Position)
        local targetPos, targetVisible = Camera:WorldToViewportPoint(CurrentTargetPos)
        if myVisible and targetVisible then
            TargetLine.From = Vector2.new(myPos.X, myPos.Y)
            TargetLine.To = Vector2.new(targetPos.X, targetPos.Y)
            TargetLine.Visible = true
        else
            TargetLine.Visible = false
        end
    end)

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                return CurrentTarget.Character.HumanoidRootPart.CFrame
            end
        end
        return oldIndex(self, index)
    end)

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                if not string.find(remoteName, "m1") and not string.find(remoteName, "click") and not string.find(remoteName, "attack") then
                    local changed = false
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = CurrentTargetPos
                            changed = true
                        end
                    end
                    if changed then return oldNamecall(self, unpack(args)) end
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    -- ========== هـنــــــا: Hitbox اللاعبين بدلاً من Hitbox البوتات ==========
    
    local function modifyPlayerHitbox(targetChar)
        if not IsHitboxActive then return end
        if not targetChar then return end
        if targetChar.Name == player.Name then return end
        
        local rootPart = targetChar:FindFirstChild("HumanoidRootPart")
        local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            pcall(function()
                rootPart.Size = HitboxSettings.Size
                rootPart.Transparency = HitboxSettings.Transparency
                rootPart.CanCollide = false
                
                if CombatController then
                    task.spawn(function()
                        pcall(function()
                            CombatController.runHitDetection(targetChar)
                        end)
                    end)
                end
            end)
        end
    end

    local lastHitboxUpdate = 0
    RunService.Heartbeat:Connect(function()
        if not IsHitboxActive then return end
        
        local now = tick()
        if now - lastHitboxUpdate < 0.2 then return end
        lastHitboxUpdate = now
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= player and pl.Character then
                modifyPlayerHitbox(pl.Character)
            end
        end
    end)

    local function resetPlayerSizes()
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= player and pl.Character then
                pcall(function()
                    local rootPart = pl.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        rootPart.Size = Vector3.new(2, 2, 1)
                        rootPart.Transparency = 0
                    end
                end)
            end
        end
    end

    print("[ARAKS HUB] AIMBOT LOADED - قراصنة: يستهدفون الكل | بحرية: يستهدفون القراصنة فقط")
    print("[ARAKS HUB] Hitbox اللاعبين مثبت - حجم 60 | مخفي")

    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
    end
    
    function AimbotModule:SetHitboxEnabled(state)
        IsHitboxActive = state
        if not state then
            resetPlayerSizes()
        end
    end
    
    function AimbotModule:SetHitboxSize(sizeValue)
        local newSize = math.clamp(sizeValue, 10, 60)
        HitboxSettings.Size = Vector3.new(newSize, newSize, newSize)
    end
    
    function AimbotModule:IsHitboxEnabled()
        return IsHitboxActive
    end
end

return AimbotModule
