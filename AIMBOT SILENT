-- █ AIMBOT (SILENT) - مع هيت بوكس كبير (حجم 80 + KillAura)
-- تم حذف هيت بوكس التكبير القديم ووضع هيت بوكس سكربتك الأول مكانه
-- الحجم: أقصى حد (80) | مخفي بالكامل

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Camera = workspace.CurrentCamera

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1500,
        SwordRange = 1000
    }

    -- ==================================================
    -- هيت بوكس من سكربتك الأول (حجم 80)
    -- ==================================================
    local HitboxSettings = {
        HitboxSize = Vector3.new(80, 80, 80),  -- أقصى حجم 80
        HitboxTransparency = 1,                 -- مخفي بالكامل
        HitboxColor = Color3.fromRGB(255, 0, 0),
        KillAuraEnabled = true
    }

    local CombatController = nil
    local WeaponToolShared = nil

    pcall(function()
        CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
        WeaponToolShared = require(ReplicatedStorage:WaitForChild("SharedComponents"):WaitForChild("WeaponToolShared"))
    end)

    local HitboxActive = true
    local RenderConnection = nil

    local function modifyHitbox(character)
        if not HitboxActive then return end
        if not getgenv().AimbotActive then return end
        if character and character.Name ~= player.Name then
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            if rootPart and humanoid and humanoid.Health > 0 then
                pcall(function()
                    rootPart.Size = HitboxSettings.HitboxSize
                    rootPart.CanCollide = false
                    rootPart.Transparency = HitboxSettings.HitboxTransparency
                    rootPart.Color = HitboxSettings.HitboxColor
                    rootPart.Material = Enum.Material.ForceField
                    
                    if HitboxSettings.KillAuraEnabled and CombatController and type(CombatController.runHitDetection) == "function" then
                        task.spawn(function()
                            pcall(function()
                                CombatController.runHitDetection(character)
                            end)
                        end)
                    end
                end)
            end
        end
    end

    local function startHitboxLoop()
        if RenderConnection then return end
        RenderConnection = RunService.RenderStepped:Connect(function()
            if not HitboxActive or not getgenv().AimbotActive then return end
            for _, pl in pairs(Players:GetPlayers()) do
                if pl ~= player and pl.Character then
                    modifyHitbox(pl.Character)
                end
            end
        end)
    end

    local function stopHitboxAndClear()
        if RenderConnection then
            RenderConnection:Disconnect()
            RenderConnection = nil
        end
        for _, pl in pairs(Players:GetPlayers()) do
            if pl ~= player and pl.Character then
                pcall(function()
                    local rootPart = pl.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        rootPart.Size = Vector3.new(2, 2, 1)
                        rootPart.Transparency = 0
                        rootPart.Color = Color3.fromRGB(255, 255, 255)
                        rootPart.Material = Enum.Material.Plastic
                    end
                end)
            end
        end
    end

    -- ==================================================
    -- باقي كود الـ Aimbot (نفسه ما تغير)
    -- ==================================================
    
    local function IsValidEnemy(plr)
        if not plr then return false end
        if plr == player then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        if myTeam and myTeam.Name == "Marines" then
            if targetTeam and targetTeam.Name == "Pirates" then
                return true
            else
                return false
            end
        end
        
        return true
    end
    
    local CurrentTarget = nil
    local CurrentTargetPos = nil

    local TargetLine = Drawing.new("Line")
    TargetLine.Color = Color3.fromRGB(180, 0, 255)
    TargetLine.Thickness = 2
    TargetLine.Transparency = 1
    TargetLine.Visible = false

    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myHrp.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end

    task.spawn(function()
        while true do
            if getgenv().AimbotActive then
                local targetCandidate = GetNearestEnemy()
                if targetCandidate and targetCandidate.Character then
                    CurrentTarget = targetCandidate
                    local hrp = targetCandidate.Character:FindFirstChild(AimbotConfig.TargetPart)
                    if hrp then
                        CurrentTargetPos = hrp.Position + Vector3.new(0, 0.5, 0)
                    else
                        CurrentTargetPos = nil
                    end
                else
                    CurrentTarget = nil
                    CurrentTargetPos = nil
                end
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
            end
            task.wait(0.1)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive or not CurrentTargetPos then
            TargetLine.Visible = false
            return
        end
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then TargetLine.Visible = false; return end
        local myPos, myVisible = Camera:WorldToViewportPoint(myHrp.Position)
        local targetPos, targetVisible = Camera:WorldToViewportPoint(CurrentTargetPos)
        if myVisible and targetVisible then
            TargetLine.From = Vector2.new(myPos.X, myPos.Y)
            TargetLine.To = Vector2.new(targetPos.X, targetPos.Y)
            TargetLine.Visible = true
        else
            TargetLine.Visible = false
        end
    end)

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
                return CurrentTarget.Character.HumanoidRootPart.CFrame
            end
        end
        return oldIndex(self, index)
    end)

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                if not string.find(remoteName, "m1") and not string.find(remoteName, "click") and not string.find(remoteName, "attack") then
                    local changed = false
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = CurrentTargetPos
                            changed = true
                        end
                    end
                    if changed then return oldNamecall(self, unpack(args)) end
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    -- بدء تشغيل الـ Hitbox
    startHitboxLoop()

    print("[ARAKS HUB] AIMBOT LOADED - قراصنة: الكل | بحرية: القراصنة فقط")
    print("[ARAKS HUB] هيت بوكس حجم 80 مخفي مع KillAura")

    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            stopHitboxAndClear()
        else
            startHitboxLoop()
        end
    end
end

return AimbotModule
