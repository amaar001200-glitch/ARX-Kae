-- █ ARAKS HUB - ADVANCED VIEWPORT EXPERT AIMBOT
-- ✅ التلاعب المباشر ببصمة اللمس عبر الـ Viewport & Screen Rays
-- ✅ يلتف حول حماية إلغاء الريموتات بدون التسبب في تجميد الأزرار

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    
    getgenv().AimbotActive = true

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1000,
        Prediction = 0.05,
    }

    local CurrentTarget = nil
    local CurrentTargetPos = nil

    -- دالة البحث عن أقرب عدو (نفس منطقك الموزون والنظيف)
    local function GetNearestEnemy()
        local char = player.Character
        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= player and pl.Character and pl.Team ~= player.Team then
                local hrp = pl.Character:FindFirstChild(AimbotConfig.TargetPart)
                local hum = pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myHrp.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end

    -- تحديث الهدف المستمر مع التنبؤ
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then CurrentTarget = nil return end
        
        local target = GetNearestEnemy()
        if target and target.Character then
            local hrp = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            if hrp then
                CurrentTarget = target
                local velocity = hrp.AssemblyLinearVelocity or Vector3.new(0,0,0)
                CurrentTargetPos = hrp.Position + (velocity * AimbotConfig.Prediction)
                return
            end
        end
        CurrentTarget = nil
    end)

    -- ==================================================
    -- 🎯 الجذور الجديدة: تزوير أشعة الكاميرا والبصمة المحلية
    -- ==================================================
    
    -- 1. تزوير دالة تحويل نقاط الشاشة إلى أشعة (تستهدف الـ UserInputService الخفي)
    local oldScreenPointToRay
    oldScreenPointToRay = hookmetamethod(Camera, "ScreenPointToRay", function(self, x, y, depth)
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            local origin = Camera.CFrame.Position
            local direction = (CurrentTargetPos - origin).Unit
            return Ray.new(origin, direction)
        end
        return oldScreenPointToRay(self, x, y, depth)
    end)

    -- 2. تزوير دالة الـ Viewport (الأكثر استخداماً في ألعاب الجوال الحديثة لتحديد مكان اللمس)
    local oldViewportPointToRay
    oldViewportPointToRay = hookmetamethod(Camera, "ViewportPointToRay", function(self, x, y, depth)
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            local origin = Camera.CFrame.Position
            local direction = (CurrentTargetPos - origin).Unit
            return Ray.new(origin, direction)
        end
        return oldViewportPointToRay(self, x, y, depth)
    end)

    -- 3. تزوير الـ Mouse.Hit الاحتياطي كخط دفاع أخير
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTargetPos then
                return CFrame.new(CurrentTargetPos)
            end
        end
        return oldIndex(self, index)
    end)

    print("[ARAKS HUB] VIEWPORT SPOOFING ACTIVE - TESTING NEW BASE")
end

return AimbotModule
