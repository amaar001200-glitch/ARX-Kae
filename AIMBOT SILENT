-- █ ARAKS HUB CAMERA LOCK + ANTI-FARM (للاعبين فقط)
-- ✅ تشغيل تلقائي فور الحقن
-- ✅ منع تام للاعبين في المناطق المحظورة
-- ✅ الكاميرا فقط بدون أي توجيه ضربات

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    
    -- 🔥 تفعيل تلقائي فوراً
    getgenv().CamLockActive = true

    -- ==================================================
    -- قائمة الإحداثيات المحظورة (Anti-Farm)
    -- ==================================================
    local BlacklistedPositions = {
        Vector3.new(-11.26, 19.31, 2827.25),
        Vector3.new(-10.01, 35.51, 2732.26),
        Vector3.new(-380.55, 73.05, 303.43),
        Vector3.new(-6471.88, 305.41, -4730.00),
        Vector3.new(-359.07, 20.64, 5535.89),
        Vector3.new(-111.14, 10.64, 5458.43),
        Vector3.new(-484.06, 10.64, 5345.74),
        Vector3.new(-5013.28, 314.55, -3006.84),
        Vector3.new(-12526.82, 336.94, -7491.79),
        Vector3.new(-16228.93, 9.09, 375.49)
    }

    -- ==================================================
    -- التحقق من الموقع المحظور
    -- ==================================================
    local function IsPositionBlacklisted(position)
        if not position then return true end
        for _, blackPos in ipairs(BlacklistedPositions) do
            local distance = (position - blackPos).Magnitude
            if distance < 100 then -- مدى 100 متر
                return true
            end
        end
        return false
    end

    -- ==================================================
    -- التحقق من أن اللاعب صالح
    -- ==================================================
    local function IsValidPlayer(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- 🔥 منع اللاعبين في المناطق المحظورة
        if IsPositionBlacklisted(hrp.Position) then
            return false
        end
        
        return true
    end

    -- ==================================================
    -- الحصول على أقرب لاعب
    -- ==================================================
    local function GetNearestPlayer()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        -- 🔥 إذا كنت في منطقة محظورة، لا تعمل
        if IsPositionBlacklisted(myHrp.Position) then
            return nil
        end
        
        local nearest = nil
        local nearestDist = 1000
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidPlayer(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl.Character
                    end
                end
            end
        end
        return nearest
    end

    -- ==================================================
    -- CAMERA LOCK (تشغيل تلقائي)
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        -- 🔥 تعمل تلقائياً بدون need to set CamLockActive
        if not getgenv().CamLockActive then return end
        
        local char = player.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        
        -- 🔥 إذا كنت في منطقة محظورة، أوقف الكاميرا
        if IsPositionBlacklisted(myHrp.Position) then return end
        
        local target = GetNearestPlayer()
        if target then
            local targetPart = target:FindFirstChild("HumanoidRootPart")
            if targetPart then
                -- 🔥 تأكد أن الهدف ليس في منطقة محظورة
                if IsPositionBlacklisted(targetPart.Position) then
                    return
                end
                
                -- توجيه الكاميرا فقط
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.3)
            end
        end
    end)

    -- ==================================================
    -- API للتحكم اليدوي (اختياري)
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().CamLockActive = state
    end

    print("[ARAKS HUB] ✅ CAMERA LOCK ACTIVATED - الكاميرا تعمل الآن!")
    print("[ARAKS HUB] 🚫 تم منع " .. #BlacklistedPositions .. " منطقة محظورة")
end

return AimbotModule
