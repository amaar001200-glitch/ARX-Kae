-- █ ARAKS HUB AIMBOT - PERFECT AIM EDITION
-- ✅ تصويب دقيق على الصدر (مش الرجلين) ✅ سرعة مهارات فائقة ✅ Hitbox متوازن

local AimbotModule = {}

do

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Camera = workspace.CurrentCamera

local player = Players.LocalPlayer

getgenv().AimbotActive = false

-- =========================
-- CONFIG (معدل للدقة والسرعة)
-- =========================
local Config = {
    TargetPart = "UpperTorso",  -- 🔥 نصوب على الصدر (مش الرجلين) عشان السيف المستقيم
    MaxDistance = 1000,
    Prediction = 0.07,  -- 🔥 أسرع بمرتين عشان المهارات تطلع بسرعة
    HitboxSize = 35,  -- 🔥 35 حجم مثالي (ليس صغيراً ولا يسبب تجميد)
    AimSmoothing = 0.3  -- 🔥 توجيه سلس عشان الضربة تكون قريبة
}

-- =========================
-- STATE
-- =========================
local CurrentTarget = nil
local CurrentTargetPos = nil
local CurrentTargetCFrame = nil

-- =========================
-- TEAM CHECK
-- =========================
local function IsValidEnemy(plr)
    if not plr or plr == player then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local myTeam = player.Team
    local targetTeam = plr.Team

    if myTeam and (myTeam.Name == "Pirates" or myTeam.Name == "Marines") then
        return targetTeam and targetTeam.Name ~= myTeam.Name
    end
    return true
end

-- =========================
-- GET NEAREST TARGET
-- =========================
local function GetNearestEnemy()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest = nil
    local bestDist = Config.MaxDistance
    local rootPos = root.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsValidEnemy(plr) and plr.Character then
            -- 🔥 نستخدم UpperTorso للقياس (أقرب للجسم)
            local targetPart = plr.Character:FindFirstChild(Config.TargetPart)
            if not targetPart then
                targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
            end
            if targetPart then
                local dist = (targetPart.Position - rootPos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

-- =========================
-- 🔥 HITBOX ذكي (يكبر الصدر والرأس فقط عشان الضربة تكون قريبة)
-- =========================
local function ApplySmartHitbox(plr)
    if not plr or not plr.Character then return end
    
    local upperTorso = plr.Character:FindFirstChild("UpperTorso")
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    local head = plr.Character:FindFirstChild("Head")
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    
    if hum and hum.Health > 0 then
        pcall(function()
            -- 🔥 نكبر الصدر فقط (هنا لازم يصيب السيف)
            if upperTorso then
                upperTorso.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                upperTorso.CanCollide = false
                upperTorso.Transparency = 0
            end
            
            -- 🔥 نكبر الرأس كمان
            if head then
                head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                head.CanCollide = false
                head.Transparency = 0
            end
            
            -- الرجلين نتركها صغيرة عشان ما يبعد التصويب
            if root then
                root.Size = Vector3.new(8, 8, 8)
                root.CanCollide = false
            end
        end)
    end
end

-- =========================
-- 🔥 AIMBOT UPDATE (سريع جداً - 60 مرة في الثانية)
-- =========================
RunService.RenderStepped:Connect(function()
    if not getgenv().AimbotActive then
        CurrentTarget = nil
        CurrentTargetPos = nil
        CurrentTargetCFrame = nil
        return
    end

    local target = GetNearestEnemy()
    
    if target and target.Character then
        -- 🔥 نستهدف الصدر أولاً
        local targetPart = target.Character:FindFirstChild(Config.TargetPart)
        if not targetPart then
            targetPart = target.Character:FindFirstChild("HumanoidRootPart")
        end
        
        if targetPart then
            CurrentTarget = target
            
            -- 🔥 حساب السرعة للـ Prediction
            local velocity = targetPart.AssemblyLinearVelocity
            local predictedPos = targetPart.Position + (velocity * Config.Prediction)
            
            -- 🔥 نضيف Aim Smoothing عشان التصويب يكون قريب وسلس
            if CurrentTargetPos then
                CurrentTargetPos = CurrentTargetPos:Lerp(predictedPos, Config.AimSmoothing)
            else
                CurrentTargetPos = predictedPos
            end
            
            -- 🔥 نصنع CFrame للتصويب الدقيق
            CurrentTargetCFrame = CFrame.new(CurrentTargetPos)
            
            -- 🔥 نطبق الهيت بوكس الذكي
            ApplySmartHitbox(target)
        else
            CurrentTarget = nil
            CurrentTargetPos = nil
            CurrentTargetCFrame = nil
        end
    else
        CurrentTarget = nil
        CurrentTargetPos = nil
        CurrentTargetCFrame = nil
    end
end)

-- =========================
-- 🔥 VISUAL LINE (مؤشر على الصدر وليس الرجلين)
-- =========================
local Line = Drawing.new("Line")
Line.Color = Color3.fromRGB(255, 50, 100)
Line.Thickness = 5
Line.Transparency = 1
Line.Visible = false

RunService.RenderStepped:Connect(function()
    if not getgenv().AimbotActive or not CurrentTargetPos then
        Line.Visible = false
        return
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        Line.Visible = false
        return
    end

    local a, va = Camera:WorldToViewportPoint(root.Position)
    local b, vb = Camera:WorldToViewportPoint(CurrentTargetPos)

    if va and vb then
        Line.From = Vector2.new(a.X, a.Y)
        Line.To = Vector2.new(b.X, b.Y)
        Line.Visible = true
    else
        Line.Visible = false
    end
end)

-- =========================
-- 🔥 SILENT AIM (تصويب دقيق على الصدر)
-- =========================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)
    if index == "Hit"
        and getgenv().AimbotActive
        and not checkcaller()
        and CurrentTargetCFrame
    then
        -- 🔥 نرجع CFrame الصدر وليس الرجلين
        return CurrentTargetCFrame
    end
    return oldIndex(self, index)
end)

-- =========================
-- 🔥 REMOTE HOOK (سريع بدون تأخير)
-- =========================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if getgenv().AimbotActive
        and CurrentTargetPos
        and not checkcaller()
        and (method == "FireServer" or method == "InvokeServer")
    then
        local name = tostring(self.Name):lower()
        if not name:find("skill")
            and not name:find("ability")
            and not name:find("combo")
            and not name:find("dash")
        then
            for i, v in ipairs(args) do
                if typeof(v) == "Vector3" then
                    args[i] = CurrentTargetPos
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- =========================
-- API
-- =========================
function AimbotModule:SetState(state)
    getgenv().AimbotActive = state
    if not state then
        CurrentTarget = nil
        CurrentTargetPos = nil
        CurrentTargetCFrame = nil
        Line.Visible = false
    end
end

print("[ARAKS HUB] PERFECT AIM - تصويب على الصدر | سرعة مهارات فائقة | ضربات قريبة")

end

return AimbotModule
