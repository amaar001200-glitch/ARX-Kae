-- █ ARAKS HUB AIMBOT - ULTIMATE EDITION
-- ✅ Hitbox حجم 50 (ضخم جداً) ✅ ظاهر (مش مخفي) ✅ بدون تجميد المهارات

local AimbotModule = {}

do

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Camera = workspace.CurrentCamera
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

getgenv().AimbotActive = false

-- =========================
-- CONFIG (حجم ضخم جداً)
-- =========================
local Config = {
    TargetPart = "HumanoidRootPart",
    MaxDistance = 1000,
    Prediction = 0.14,
    HitboxSize = 50  -- 🔥 حجم ضخم جداً (50x50) مناسب للسيف المستقيم الطويل
}

-- =========================
-- STATE
-- =========================
local CurrentTarget = nil
local CurrentTargetPos = nil
local isUsingSkill = false

-- =========================
-- TEAM CHECK
-- =========================
local function IsValidEnemy(plr)
    if not plr or plr == player then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local myTeam = player.Team
    local targetTeam = plr.Team

    if myTeam and myTeam.Name == "Pirates" then
        return true
    end
    if myTeam and myTeam.Name == "Marines" then
        return targetTeam and targetTeam.Name == "Pirates"
    end
    return true
end

-- =========================
-- GET NEAREST TARGET
-- =========================
local function GetNearestEnemy()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest = nil
    local distLimit = Config.MaxDistance
    local rootPos = root.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsValidEnemy(plr) and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - rootPos).Magnitude
                if dist < distLimit then
                    distLimit = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

-- =========================
-- 🔥 MASSIVE VISIBLE HITBOX (حجم 50 وظاهر)
-- =========================
local function ApplyMassiveHitbox(plr)
    if not plr or not plr.Character then return end
    
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    
    if root and hum and hum.Health > 0 then
        local newSize = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
        
        pcall(function()
            -- 🔥 حجم ضخم 50
            root.Size = newSize
            root.CanCollide = false
            root.Transparency = 0  -- 🔥 ظاهر (مش مخفي)
            root.Material = Enum.Material.Neon
            
            -- 🔥 نكبر كل أجزاء الجسم
            local allParts = plr.Character:GetChildren()
            for _, part in ipairs(allParts) do
                if part:IsA("BasePart") then
                    part.Size = newSize
                    part.CanCollide = false
                    part.Transparency = 0
                    part.Material = Enum.Material.Neon
                end
            end
        end)
    end
end

-- =========================
-- AIMBOT UPDATE LOOP
-- =========================
RunService.RenderStepped:Connect(function()
    if not getgenv().AimbotActive then
        CurrentTarget = nil
        CurrentTargetPos = nil
        return
    end

    local target = GetNearestEnemy()
    
    if target and target.Character then
        local hrp = target.Character:FindFirstChild(Config.TargetPart)
        if hrp then
            CurrentTarget = target
            local velocity = hrp.AssemblyLinearVelocity
            CurrentTargetPos = hrp.Position + (velocity * Config.Prediction)
            
            -- 🔥 نطبق الهيت بوكس الضخم كل مره
            ApplyMassiveHitbox(target)
        else
            CurrentTarget = nil
            CurrentTargetPos = nil
        end
    else
        CurrentTarget = nil
        CurrentTargetPos = nil
    end
end)

-- =========================
-- 🔥 HITBOX FORCE LOOP (يثبت الحجم كل 0.05 ثانية - سريع جداً)
-- =========================
task.spawn(function()
    while task.wait(0.05) do  -- 20 مرة في الثانية
        if getgenv().AimbotActive and CurrentTarget then
            ApplyMassiveHitbox(CurrentTarget)
        end
    end
end)

-- =========================
-- 🔥 منع تجميد المهارات (حل مشكلة الضغط على المهارة)
-- =========================
-- نكتشف لما المستخدم يضغط مهارة
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- نتحقق إذا كان الضغط على مفتاح مهارة (Z, X, C, V, G, إلخ)
    local key = input.KeyCode.Name
    local skillKeys = {"Z", "X", "C", "V", "B", "G", "Q", "E", "R", "T", "F"}
    
    for _, skillKey in ipairs(skillKeys) do
        if key == skillKey then
            isUsingSkill = true
            task.wait(0.2)  -- مدة استخدام المهارة
            isUsingSkill = false
            break
        end
    end
end)

-- =========================
-- VISUAL LINE (أطول وأعرض)
-- =========================
local Line = Drawing.new("Line")
Line.Color = Color3.fromRGB(180, 0, 255)
Line.Thickness = 8  -- أعرض
Line.Transparency = 1
Line.Visible = false

local LineExtension = 300  -- أطول

RunService.RenderStepped:Connect(function()
    if not getgenv().AimbotActive or not CurrentTargetPos then
        Line.Visible = false
        return
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        Line.Visible = false
        return
    end

    local a, va = Camera:WorldToViewportPoint(root.Position)
    local b, vb = Camera:WorldToViewportPoint(CurrentTargetPos)

    if va and vb then
        local fromPoint = Vector2.new(a.X, a.Y)
        local toPoint = Vector2.new(b.X, b.Y)
        local direction = (toPoint - fromPoint).Unit
        local extendedPoint = toPoint + (direction * LineExtension)
        
        Line.From = fromPoint
        Line.To = extendedPoint
        Line.Visible = true
    else
        Line.Visible = false
    end
end)

-- =========================
-- SILENT AIM (مع منع التجميد أثناء المهارات)
-- =========================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)
    if index == "Hit"
        and getgenv().AimbotActive
        and not checkcaller()
        and CurrentTarget
        and CurrentTarget.Character
        and not isUsingSkill  -- 🔥 منع التجميد أثناء استخدام المهارة
    then
        local root = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        if root then
            return root.CFrame
        end
    end
    return oldIndex(self, index)
end)

-- =========================
-- REMOTE HOOK (معدل لمنع التجميد)
-- =========================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if getgenv().AimbotActive
        and CurrentTargetPos
        and not checkcaller()
        and not isUsingSkill  -- 🔥 منع التجميد أثناء استخدام المهارة
        and (method == "FireServer" or method == "InvokeServer")
    then
        local name = tostring(self.Name):lower()
        if not name:find("skill")
            and not name:find("ability")
            and not name:find("combo")
            and not name:find("dash")
        then
            for i, v in ipairs(args) do
                if typeof(v) == "Vector3" and i <= 2 then
                    args[i] = CurrentTargetPos
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- =========================
-- API
-- =========================
function AimbotModule:SetState(state)
    getgenv().AimbotActive = state
    if not state then
        CurrentTarget = nil
        CurrentTargetPos = nil
        Line.Visible = false
    end
end

print("[ARAKS HUB] AIMBOT - حجم 50 ظاهر | بدون تجميد المهارات | ضربات دقيقة")

end

return AimbotModule
