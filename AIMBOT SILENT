-- █ ARAKS HUB AIMBOT - CLEAN FULL VERSION

local AimbotModule = {}

do

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Camera = workspace.CurrentCamera

local player = Players.LocalPlayer

getgenv().AimbotActive = false

-- =========================
-- CONFIG
-- =========================
local Config = {
    TargetPart = "HumanoidRootPart",
    MaxDistance = 900,
    Prediction = 0.14,
    HitboxSize = 18
}

-- =========================
-- STATE
-- =========================
local CurrentTarget = nil
local CurrentTargetPos = nil

-- =========================
-- TEAM CHECK
-- =========================
local function IsValidEnemy(plr)

    if not plr or plr == player then return false end

    local char = plr.Character
    if not char then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local myTeam = player.Team
    local targetTeam = plr.Team

    if myTeam and myTeam.Name == "Pirates" then
        return true
    end

    if myTeam and myTeam.Name == "Marines" then
        return targetTeam and targetTeam.Name == "Pirates"
    end

    return true
end

-- =========================
-- GET NEAREST TARGET
-- =========================
local function GetNearestEnemy()

    local char = player.Character
    if not char then return nil end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest = nil
    local distLimit = Config.MaxDistance

    for _,plr in ipairs(Players:GetPlayers()) do

        if IsValidEnemy(plr) and plr.Character then

            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")

            if hrp then

                local dist = (hrp.Position - root.Position).Magnitude

                if dist < distLimit then
                    distLimit = dist
                    nearest = plr
                end

            end
        end
    end

    return nearest
end

-- =========================
-- UPDATE LOOP (OPTIMIZED)
-- =========================
task.spawn(function()

    while task.wait(0.18) do

        if not getgenv().AimbotActive then
            CurrentTarget = nil
            CurrentTargetPos = nil
            continue
        end

        local target = GetNearestEnemy()

        if target and target.Character then

            local hrp = target.Character:FindFirstChild(Config.TargetPart)

            if hrp then

                CurrentTarget = target

                local velocity = hrp.AssemblyLinearVelocity

                CurrentTargetPos =
                    hrp.Position + (velocity * Config.Prediction)

            else
                CurrentTarget = nil
                CurrentTargetPos = nil
            end

        else
            CurrentTarget = nil
            CurrentTargetPos = nil
        end

    end
end)

-- =========================
-- VISUAL LINE
-- =========================
local Line = Drawing.new("Line")
Line.Color = Color3.fromRGB(180,0,255)
Line.Thickness = 2
Line.Transparency = 1
Line.Visible = false

RunService.RenderStepped:Connect(function()

    if not getgenv().AimbotActive or not CurrentTargetPos then
        Line.Visible = false
        return
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        Line.Visible = false
        return
    end

    local a,va = Camera:WorldToViewportPoint(root.Position)
    local b,vb = Camera:WorldToViewportPoint(CurrentTargetPos)

    if va and vb then
        Line.From = Vector2.new(a.X,a.Y)
        Line.To = Vector2.new(b.X,b.Y)
        Line.Visible = true
    else
        Line.Visible = false
    end
end)

-- =========================
-- SILENT AIM
-- =========================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)

    if index == "Hit"
    and getgenv().AimbotActive
    and not checkcaller()
    and CurrentTarget
    and CurrentTarget.Character
    then

        local root = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")

        if root then
            return root.CFrame
        end
    end

    return oldIndex(self, index)
end)

-- =========================
-- SAFE REMOTE HOOK
-- =========================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)

    local method = getnamecallmethod()
    local args = {...}

    if getgenv().AimbotActive
    and CurrentTargetPos
    and not checkcaller()
    and (method == "FireServer" or method == "InvokeServer")
    then

        local name = tostring(self.Name):lower()

        if not string.find(name,"skill")
        and not string.find(name,"ability")
        and not string.find(name,"combo")
        and not string.find(name,"dash")
        then

            for i,v in ipairs(args) do
                if typeof(v) == "Vector3" and i <= 2 then
                    args[i] = CurrentTargetPos
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end

    return oldNamecall(self, ...)
end)

-- =========================
-- STABLE HITBOX (SAFE)
-- =========================
task.spawn(function()

    while task.wait(0.7) do

        if getgenv().AimbotActive
        and CurrentTarget
        and CurrentTarget.Character
        then

            local root = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
            local hum = CurrentTarget.Character:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then

                pcall(function()

                    root.Size = Vector3.new(
                        Config.HitboxSize,
                        Config.HitboxSize,
                        Config.HitboxSize
                    )

                    root.CanCollide = false
                    root.Transparency = 1

                end)
            end
        end
    end
end)

-- =========================
-- API
-- =========================
function AimbotModule:SetState(state)
    getgenv().AimbotActive = state
end

print("[ARAKS HUB] AIMBOT FULL LOADED (CLEAN VERSION)")

end

return AimbotModule
