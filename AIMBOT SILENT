-- █ ARAKS HUB CAMERA LOCK + ANTI-FARM + PVP RADAR (خلفية فقط)
-- ✅ تشغيل تلقائي فور الحقن
-- ✅ منع تام للاعبين في المناطق المحظورة
-- ✅ الكاميرا فقط بدون أي توجيه ضربات
-- ✅ Hitbox مكبر 95 مع تلوين بنفسجي (نفس النظام القديم)
-- ✅ نظام PVP Radar يعمل في الخلفية (ON/OFF/FIGHT) - غير مرئي
-- ✅ نظام الفرق (Pirates/Marines) يعمل بشكل طبيعي
-- ✅ تأثير الضربات على الفواكه والخوصم طبيعي 100%
-- ✅ عند موت الهدف، ينتقل تلقائياً للهدف التالي

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    
    -- استدعاء موديول اللعبة
    local CombatController = nil
    pcall(function()
        CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    end)

    -- 🔥 تفعيل تلقائي فوراً
    getgenv().CamLockActive = true

    -- ==================================================
    -- قائمة الإحداثيات المحظورة (Anti-Farm)
    -- ==================================================
    local BlacklistedPositions = {
        Vector3.new(-11.26, 19.31, 2827.25),
        Vector3.new(-10.01, 35.51, 2732.26),
        Vector3.new(-380.55, 73.05, 303.43),
        Vector3.new(-6471.88, 305.41, -4730.00),
        Vector3.new(-359.07, 20.64, 5535.89),
        Vector3.new(-111.14, 10.64, 5458.43),
        Vector3.new(-484.06, 10.64, 5345.74),
        Vector3.new(-5013.28, 314.55, -3006.84),
        Vector3.new(-12526.82, 336.94, -7491.79),
        Vector3.new(-16228.93, 9.09, 375.49)
    }

    -- ==================================================
    -- متغيرات PVP Radar
    -- ==================================================
    local FightCache = {}
    local RADAR_SETTINGS = {
        Enabled = true,
        MaxDistance = 99999,
        RefreshRate = 0.35,
        ShowOff = true,
        ShowON = true,
        ShowFight = true,
    }
    local activeRadars = {}

    -- ==================================================
    -- التحقق من الموقع المحظور
    -- ==================================================
    local function IsPositionBlacklisted(position)
        if not position then return true end
        for _, blackPos in ipairs(BlacklistedPositions) do
            local distance = (position - blackPos).Magnitude
            if distance < 100 then
                return true
            end
        end
        return false
    end

    -- ==================================================
    -- الحصول على حالة PVP للاعب
    -- ==================================================
    local function GetPlayerState(plr)
        if not plr or plr == player then
            return nil
        end
        
        local pvpDisabled = false
        pcall(function()
            pvpDisabled = plr:GetAttribute("PvpDisabled")
        end)
        
        if pvpDisabled then
            return "OFF", Color3.fromRGB(255, 70, 70)
        end
        
        local char = plr.Character
        if char then
            local inCombat = false
            pcall(function()
                inCombat = char:GetAttribute("InCombat")
            end)
            
            if inCombat then
                FightCache[plr] = tick()
            end
        end
        
        if FightCache[plr] and (tick() - FightCache[plr]) <= 12 then
            return "FIGHT", Color3.fromRGB(255, 220, 0)
        end
        
        return "ON", Color3.fromRGB(0, 255, 120)
    end

    -- ==================================================
    -- نظام التحقق من العدو (مع نظام الفرق)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- 🔥 منع اللاعبين في المناطق المحظورة
        if IsPositionBlacklisted(hrp.Position) then
            return false
        end
        
        -- 🔥 نظام الفرق (Pirates/Marines)
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        -- القراصنة يستهدفون الكل
        if myTeam and myTeam.Name == "Pirates" then
            -- 🔥 لكن نتأكد من PVP ON
            local state, _ = GetPlayerState(plr)
            if state == "OFF" then
                return false
            end
            return true
        end
        
        -- البحرية تستهدف القراصنة فقط
        if myTeam and myTeam.Name == "Marines" then
            if targetTeam and targetTeam.Name == "Pirates" then
                -- 🔥 نتأكد من PVP ON
                local state, _ = GetPlayerState(plr)
                if state == "OFF" then
                    return false
                end
                return true
            else
                return false
            end
        end
        
        return true
    end

    -- ==================================================
    -- إنشاء رادار PVP (مخفي)
    -- ==================================================
    local function CreateRadar(plr)
        if not RADAR_SETTINGS.Enabled then return end
        if plr == player then return end
        
        local char = plr.Character
        if not char then return end
        
        local head = char:FindFirstChild("Head")
        if not head then return end
        
        local oldRadar = head:FindFirstChild("ARAKS_PVP_RADAR")
        if oldRadar then
            pcall(function() oldRadar:Destroy() end)
        end
        
        local radarGui = Instance.new("BillboardGui")
        radarGui.Name = "ARAKS_PVP_RADAR"
        radarGui.Adornee = head
        radarGui.AlwaysOnTop = true
        radarGui.MaxDistance = RADAR_SETTINGS.MaxDistance
        radarGui.Size = UDim2.new(0, 58, 0, 12)
        radarGui.StudsOffset = Vector3.new(2.8, -2.6, 0)
        -- 🔥 إخفاء الرادار تماماً (يعمل في الخلفية)
        radarGui.Enabled = false
        radarGui.Parent = head
        
        local holder = Instance.new("Frame", radarGui)
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.new(1, 0, 1, 0)
        
        local dot = Instance.new("Frame", holder)
        dot.Size = UDim2.new(0, 4, 0, 4)
        dot.Position = UDim2.new(0, 0, 0.5, -2)
        dot.BorderSizePixel = 0
        local dotCorner = Instance.new("UICorner", dot)
        dotCorner.CornerRadius = UDim.new(1, 0)
        
        local txt = Instance.new("TextLabel", holder)
        txt.BackgroundTransparency = 1
        txt.Position = UDim2.new(0, 7, 0, 0)
        txt.Size = UDim2.new(1, -7, 1, 0)
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 9
        txt.TextStrokeTransparency = 0.45
        txt.TextXAlignment = Enum.TextXAlignment.Left
        
        activeRadars[plr] = {
            Gui = radarGui,
            Dot = dot,
            Text = txt,
            Holder = holder
        }
        
        return radarGui
    end

    -- ==================================================
    -- تحديث الرادارات (يعمل في الخلفية)
    -- ==================================================
    local function UpdateAllRadars()
        if not RADAR_SETTINGS.Enabled then return end
        
        for plr, data in pairs(activeRadars) do
            if not plr or not plr.Parent then
                if data.Gui then pcall(function() data.Gui:Destroy() end) end
                activeRadars[plr] = nil
            else
                local stateText, stateColor = GetPlayerState(plr)
                if stateText then
                    data.Text.Text = stateText
                    data.Text.TextColor3 = stateColor
                    data.Dot.BackgroundColor3 = stateColor
                end
            end
        end
    end

    -- ==================================================
    -- الحصول على أقرب عدو
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        if IsPositionBlacklisted(myHrp.Position) then
            return nil
        end
        
        local nearest = nil
        local nearestDist = 1000
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end

    -- ==================================================
    -- متغيرات Hitbox والتلوين
    -- ==================================================
    local CurrentTarget = nil
    local lastTarget = nil
    local targetCharacter = nil
    
    local PurpleChams = Instance.new("BoxHandleAdornment")
    PurpleChams.Size = Vector3.new(4, 6, 4)
    PurpleChams.Color3 = Color3.fromRGB(165, 0, 255)
    PurpleChams.AlwaysOnTop = true
    PurpleChams.ZIndex = 10
    PurpleChams.Transparency = 0.4
    PurpleChams.Visible = false
    PurpleChams.Parent = game:GetService("CoreGui")

    -- ==================================================
    -- تطبيق Hitbox (نفس النظام القديم)
    -- ==================================================
    local function ApplyHitboxSystem(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            if IsPositionBlacklisted(rootPart.Position) then
                return
            end
            
            pcall(function()
                -- 🔥 Hitbox حجم 95 شفاف
                rootPart.Size = Vector3.new(95, 95, 95)
                rootPart.CanCollide = false
                rootPart.Transparency = 1.0
                rootPart.Material = Enum.Material.ForceField
                
                -- التلوين البنفسجي
                PurpleChams.Adornee = rootPart
                PurpleChams.Visible = true
                
                -- تفعيل CombatController
                if CombatController and type(CombatController.runHitDetection) == "function" then
                    task.spawn(function()
                        pcall(function() CombatController.runHitDetection(plr.Character) end)
                    end)
                end
            end)
        end
    end

    -- ==================================================
    -- إعادة ضبط Hitbox
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            pcall(function()
                -- 🔥 إرجاع الحجم الطبيعي
                rootPart.Size = Vector3.new(2, 2, 2)
                rootPart.CanCollide = true
                rootPart.Transparency = 0
            end)
        end
        
        if rootPart and PurpleChams.Adornee == rootPart then
            PurpleChams.Visible = false
            PurpleChams.Adornee = nil
        end
    end

    -- ==================================================
    -- تحديث الهدف
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().CamLockActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            targetCharacter = nil
            PurpleChams.Visible = false
            return
        end
        
        -- 🔥 التحقق من أن الهدف لا يزال صالحاً
        if lastTarget then
            if not IsValidEnemy(lastTarget) then
                ResetHitbox(lastTarget)
                lastTarget = nil
                CurrentTarget = nil
                targetCharacter = nil
                PurpleChams.Visible = false
            end
        end
        
        -- 🔥 البحث عن هدف جديد
        if not lastTarget then
            local newTarget = GetNearestEnemy()
            if newTarget then
                lastTarget = newTarget
                CurrentTarget = newTarget
                targetCharacter = newTarget.Character
                ApplyHitboxSystem(newTarget)
            else
                CurrentTarget = nil
                targetCharacter = nil
                PurpleChams.Visible = false
            end
        end
    end)

    -- ==================================================
    -- CAMERA LOCK
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().CamLockActive then return end
        
        local char = player.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        
        if IsPositionBlacklisted(myHrp.Position) then return end
        
        if CurrentTarget and lastTarget then
            if not IsValidEnemy(lastTarget) then
                ResetHitbox(lastTarget)
                lastTarget = nil
                CurrentTarget = nil
                targetCharacter = nil
                PurpleChams.Visible = false
                return
            end
            
            local targetPart = lastTarget.Character and lastTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                if IsPositionBlacklisted(targetPart.Position) then
                    ResetHitbox(lastTarget)
                    lastTarget = nil
                    CurrentTarget = nil
                    targetCharacter = nil
                    PurpleChams.Visible = false
                    return
                end
                
                -- توجيه الكاميرا فقط
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.3)
            end
        end
    end)

    -- ==================================================
    -- صيانة Hitbox
    -- ==================================================
    task.spawn(function()
        while task.wait(0.15) do
            if getgenv().CamLockActive and lastTarget then
                if IsValidEnemy(lastTarget) then
                    local hrp = lastTarget.Character and lastTarget.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and not IsPositionBlacklisted(hrp.Position) then
                        ApplyHitboxSystem(lastTarget)
                    else
                        ResetHitbox(lastTarget)
                        lastTarget = nil
                        CurrentTarget = nil
                        targetCharacter = nil
                        PurpleChams.Visible = false
                    end
                else
                    ResetHitbox(lastTarget)
                    lastTarget = nil
                    CurrentTarget = nil
                    targetCharacter = nil
                    PurpleChams.Visible = false
                end
            end
        end
    end)

    -- ==================================================
    -- إعداد الرادار (خلفية)
    -- ==================================================
    local function SetupRadarForPlayer(plr)
        if plr == player then return end
        task.wait(0.5)
        if RADAR_SETTINGS.Enabled then
            CreateRadar(plr)
        end
        
        plr.CharacterAdded:Connect(function()
            task.wait(1)
            if RADAR_SETTINGS.Enabled then
                CreateRadar(plr)
            end
        end)
    end

    -- ==================================================
    -- بدء تشغيل الرادار (خلفية)
    -- ==================================================
    local function StartRadar()
        for _, plr in pairs(Players:GetPlayers()) do
            SetupRadarForPlayer(plr)
        end
        
        Players.PlayerAdded:Connect(SetupRadarForPlayer)
        
        RunService.Heartbeat:Connect(function()
            if RADAR_SETTINGS.Enabled then
                UpdateAllRadars()
            end
        end)
        
        Players.PlayerRemoving:Connect(function(plr)
            if activeRadars[plr] then
                if activeRadars[plr].Gui then
                    pcall(function() activeRadars[plr].Gui:Destroy() end)
                end
                activeRadars[plr] = nil
            end
        end)
    end

    -- ==================================================
    -- تشغيل الرادار (خلفية)
    -- ==================================================
    StartRadar()

    -- ==================================================
    -- API
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().CamLockActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            targetCharacter = nil
            PurpleChams.Visible = false
        end
    end

    print("[ARAKS HUB] ✅ CAMERA LOCK + HITBOX + RADAR ACTIVATED!")
    print("[ARAKS HUB] 🚫 تم منع " .. #BlacklistedPositions .. " منطقة محظورة")
    print("[ARAKS HUB] 📡 PVP Radar يعمل في الخلفية (ON/OFF/FIGHT) - غير مرئي")
    print("[ARAKS HUB] ⚔️ نظام الفرق يعمل (Pirates/Marines)")
end

return AimbotModule
