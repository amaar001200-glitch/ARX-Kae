-- █ ARAKS HUB AIMBOT + COMBAT CONTROLLER + ANTI-KEN BYPASS (للاعبين فقط)
-- ✅ تم إخفاء الهيت بوكس المكبّر (95) عن هاكي التنبؤ (Ken Haki) تماماً 100%
-- ✅ تم خداع الـ OM ومحرك اللعبة بحيث يقرأ حجم اللاعب دائماً طبيعي (2,2,2)
-- ✅ دمج كود الـ Auto Ken المحدث ليعمل بتوافق كامل وبدون تعارض

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local CollectionService = game:GetService("CollectionService")
    
    -- استدعاء موديول اللعبة المسؤول عن كشف الضربات والضرر الفعلي
    local CombatController = nil
    pcall(function()
        CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    end)

    -- ريموت الهاكي والأحداث
    local CommE = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommE")

    getgenv().AimbotActive = false
    getgenv().AutoKenActive = false

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1000,
        HitboxSize = 95,     -- حجم الهيت بوكس المكبّر
        NormalSize = Vector3.new(2, 2, 2), -- الحجم الوهمي الذي يظهر للهاكي وللعبة
        Prediction = 0.07,
    }

    -- ==================================================
    -- نظام التحقق من العدو (لاعبين فقط)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then return true end
        if myTeam and myTeam.Name == "Marines" then
            return targetTeam and targetTeam.Name == "Pirates"
        end
        return true
    end
    
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    
    -- مظهر نيون بنفسجي يظهر لك أنت فقط من خلف الجدران
    local PurpleChams = Instance.new("BoxHandleAdornment")
    PurpleChams.Size = Vector3.new(4, 6, 4)
    PurpleChams.Color3 = Color3.fromRGB(165, 0, 255)
    PurpleChams.AlwaysOnTop = true
    PurpleChams.ZIndex = 10
    PurpleChams.Transparency = 0.4
    PurpleChams.Visible = false
    PurpleChams.Parent = game:GetService("CoreGui")
    
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق الـ Hitbox وتكبير الحجم الفعلي
    -- ==================================================
    local function ApplyHitboxSystem(plr)
        if not plr or not plr.Character then return end
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            pcall(function()
                rootPart.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                rootPart.CanCollide = false
                rootPart.Transparency = 1.0
                rootPart.Material = Enum.Material.ForceField
                
                PurpleChams.Adornee = rootPart
                PurpleChams.Visible = true
                
                if CombatController and type(CombatController.runHitDetection) == "function" then
                    task.spawn(function()
                        pcall(function() CombatController.runHitDetection(plr.Character) end)
                    end)
                end
            end)
        end
    end
    
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            pcall(function()
                rootPart.Size = AimbotConfig.NormalSize
                rootPart.CanCollide = true
                rootPart.Transparency = 0
            end)
        end
        if rootPart and PurpleChams.Adornee == rootPart then
            PurpleChams.Visible = false
            PurpleChams.Adornee = nil
        end
    end
    
    -- ==================================================
    -- LOOP الأيـم بـوت الرئيسي
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then ResetHitbox(lastTarget) lastTarget = nil end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
            return
        end
        
        local target = GetNearestEnemy()
        if target and target.Character then
            local hrp = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            if hrp then
                if target ~= lastTarget then
                    if lastTarget then ResetHitbox(lastTarget) end
                    lastTarget = target
                    ApplyHitboxSystem(target)
                end
                CurrentTarget = target
                local velocity = hrp.AssemblyLinearVelocity
                CurrentTargetPos = hrp.Position + (velocity * AimbotConfig.Prediction)
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
                PurpleChams.Visible = false
            end
        else
            if lastTarget then ResetHitbox(lastTarget) lastTarget = nil end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end)
    
    task.spawn(function()
        while task.wait(0.15) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then ApplyHitboxSystem(lastTarget) end
            end
        end
    end)
    
    -- ==================================================
    -- حماية وإخفاء الحجم عن هاكي التنبؤ وعن السيرفر (ANTI-KEN BYPASS)
    -- ==================================================
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        -- خداع كامل: إذا حاول أي سكربت أو هاكي قراءة حجم الـ HumanoidRootPart نرجعلوا الحجم الطبيعي 2،2،2
        if tostring(self) == "HumanoidRootPart" and index == "Size" and not checkcaller() then
            return AimbotConfig.NormalSize
        end
        
        -- توجيه ضربات الماوس (Silent Aim)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character then
                local targetPart = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
                if targetPart then return targetPart.CFrame end
            end
        end
        return oldIndex(self, index)
    end)
    
    -- ==================================================
    -- حماية الريموتات وتوجيه المهارات للهدف
    -- ==================================================
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") and not remoteName:find("spawn") then
                    local changed = false
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = CurrentTargetPos
                            changed = true
                        end
                    end
                    if changed then return oldNamecall(self, unpack(args)) end
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    -- ==================================================
    -- موديول الـ AUTO KEN HAKI (مستورد ومصلح)
    -- ==================================================
    local function getKenButton()
        local PlayerGui = player:FindFirstChild("PlayerGui")
        if not PlayerGui then return nil end
        local mobileButtons = PlayerGui:FindFirstChild("MobileContextButtons")
        if not mobileButtons then return nil end
        local contextFrame = mobileButtons:FindFirstChild("ContextButtonFrame")
        if not contextFrame then return nil end
        return contextFrame:FindFirstChild("BoundActionKen")
    end
    
    task.spawn(function()
        local kenButton = nil
        while true do
            task.wait(0.12)
            if getgenv().AutoKenActive then
                pcall(function()
                    local char = player.Character
                    if char and CollectionService:HasTag(char, "Ken") then
                        if not kenButton or not kenButton.Parent then kenButton = getKenButton() end
                        if kenButton and kenButton:GetAttribute("Selected") ~= true then 
                            kenButton:SetAttribute("Selected", true) 
                        end
                        local om = getrenv()._G.OM
                        if om and not om.active then
                            -- إخفاء وتصفير النطاق لمنع رسم الدائرة الكبيرة للهاكي
                            om.radius = 0
                            om:setActive(true)
                            if CommE then CommE:FireServer("Ken", true) end
                        end
                    end
                end)
            end
        end
    end)
    
    -- تنظيف البيانات عند خروج اللاعب
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- API التحكم الخارجي لـ ARAKS HUB
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then ResetHitbox(lastTarget) lastTarget = nil end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end
    
    function AimbotModule:SetAutoKen(state)
        getgenv().AutoKenActive = state
    end
    
    print("[ARAKS HUB] ANTI-KEN HAKI BYPASS INSTALLED SUCCESSFULLY!")
end

return AimbotModule
