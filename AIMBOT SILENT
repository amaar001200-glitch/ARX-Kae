-- █ ARAKS HUB AIMBOT (للاعبين فقط + مدى 1000)
-- ✅ الـ Hitbox مخفي وشفاف بالكامل
-- ✅ لون الخصم يتحول للبنفسجي عند استهدافه (تم إلغاء الخط)
-- ✅ تصويب قوي جداً بدون تجميد أو بطء للمهارات

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1000,  -- مدى 1000
        HitboxSize = 25,     -- حجم مثالي لضمان الإصابة بدون جليتش أو حظر ضربات
        Prediction = 0.05,   -- تنبؤ محسّن لمنع تضييع الضربات
    }

    -- ==================================================
    -- التحقق من العدو (لاعبين فقط - بدون بوتات)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        if myTeam and myTeam.Name == "Marines" then
            return targetTeam and targetTeam.Name == "Pirates"
        end
        
        return true
    end
    
    -- ==================================================
    -- المتغيرات والتأثيرات
    -- ==================================================
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    
    -- إنشاء التأثير البنفسجي حول اللاعب
    local TargetHighlight = Instance.new("Highlight")
    TargetHighlight.FillColor = Color3.fromRGB(150, 0, 255)   -- لون بنفسجي داخل الجسم
    TargetHighlight.OutlineColor = Color3.fromRGB(255, 0, 255) -- تحديد بنفسجي مضيء
    TargetHighlight.FillTransparency = 0.5
    TargetHighlight.OutlineTransparency = 0
    TargetHighlight.Enabled = false
    TargetHighlight.Parent = game:GetService("CoreGui") -- لضمان عدم حذفه من اللعبة
    
    -- ==================================================
    -- الحصول على أقرب لاعب
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق Hitbox (شفاف بالكامل لللاعبين فقط)
    -- ==================================================
    local function ApplyHitbox(plr)
        if not plr or not plr.Character then return end
        if not plr:IsA("Player") then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and hum and hum.Health > 0 then
            pcall(function()
                rootPart.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                rootPart.CanCollide = false
                rootPart.Transparency = 1.0 -- 1.0 تعني شفاف بالكامل ولا يظهر أبداً
                
                -- تفعيل التأثير البنفسجي على شخصية الخصم
                TargetHighlight.Adornee = plr.Character
                TargetHighlight.Enabled = true
            end)
        end
    end
    
    -- ==================================================
    -- إعادة ضبط Hitbox والتأثيرات
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            pcall(function()
                rootPart.Size = Vector3.new(2, 2, 2)
                rootPart.CanCollide = true
                rootPart.Transparency = 0 -- إعادته لشروطه الطبيعية
            end)
        end
        
        if TargetHighlight.Adornee == plr.Character then
            TargetHighlight.Enabled = false
            TargetHighlight.Adornee = nil
        end
    end
    
    -- ==================================================
    -- AIMBOT UPDATE
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            TargetHighlight.Enabled = false
            return
        end
        
        local target = GetNearestEnemy()
        
        if target and target.Character then
            local hrp = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            
            if hrp then
                if target ~= lastTarget then
                    if lastTarget then
                        ResetHitbox(lastTarget)
                    end
                    lastTarget = target
                    ApplyHitbox(target)
                end
                
                CurrentTarget = target
                
                -- حساب التنبؤ الذكي لحركة الخصم
                local velocity = hrp.AssemblyLinearVelocity
                CurrentTargetPos = hrp.Position + (velocity * AimbotConfig.Prediction)
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
                TargetHighlight.Enabled = false
            end
        else
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            TargetHighlight.Enabled = false
        end
    end)
    
    -- ==================================================
    -- تثبيت الـ Hitbox بشكل مستمر
    -- ==================================================
    task.spawn(function()
        while task.wait(0.3) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then 
                    ApplyHitbox(lastTarget)
                end
            end
        end
    end)
    
    -- ==================================================
    -- SILENT AIM (تعديل دقيق لمنع تضييع الضربات)
    -- ==================================================
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character then
                local targetPart = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
                if targetPart then
                    return targetPart.CFrame
                end
            end
        end
        return oldIndex(self, index)
    end)
    
    -- ==================================================
    -- REMOTE HOOK (تم إصلاح مشكلة تجميد المهارات والبطء هنا)
    -- ==================================================
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                
                -- فلاتر صارمة لمنع التعديل على ريموتات حركة اللاعب الخاص بك
                if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") and not remoteName:find("spawn") then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            -- التحقق من أن المسافة قريبة من الخصم المستهدف لمنع تغيير إحداثيات خاطئة
                            if (v - CurrentTargetPos).Magnitude < 150 or remoteName:find("skill") or remoteName:find("use") then
                                args[i] = CurrentTargetPos
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    
    -- ==================================================
    -- تنظيف عند مغادرة اللاعب
    -- ==================================================
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
            TargetHighlight.Enabled = false
        end
    end)
    
    -- ==================================================
    -- تشغيل / إيقاف الأداة
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            TargetHighlight.Enabled = false
        end
    end
    
    print("[ARAKS HUB] FIXED - تم إصلاح البطء والتجميد | الـ Hitbox مخفي | لون الخصم بنفسجي")
end

return AimbotModule
