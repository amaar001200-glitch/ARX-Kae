-- █ ARAKS HUB AIMBOT + CAMERA LOCK + ANTI-FARM (للاعبين فقط)
-- ✅ تحسين سرعة التتبع لتناسب حركة الشخصيات السريعة
-- ✅ إضافة نظام منع الإحداثيات (Anti-Farm) لتجاهل اللاعبين في المناطق المحظورة
-- ✅ تكبير Hitbox إلى 95 مع تلوين بنفسجي
-- ✅ تتبع الكاميرا الناعم مع سرعة استجابة محسّنة

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    
    -- استدعاء موديول اللعبة
    local CombatController = nil
    pcall(function()
        CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    end)

    getgenv().AimbotActive = false

    -- ==================================================
    -- قائمة الإحداثيات المحظورة (Anti-Farm)
    -- ==================================================
    local BlacklistedPositions = {
        Vector3.new(-11.26, 19.31, 2827.25),
        Vector3.new(-10.01, 35.51, 2732.26),
        Vector3.new(-380.55, 73.05, 303.43),
        Vector3.new(-6471.88, 305.41, -4730.00),
        Vector3.new(-359.07, 20.64, 5535.89),
        Vector3.new(-111.14, 10.64, 5458.43),
        Vector3.new(-484.06, 10.64, 5345.74),
        Vector3.new(-5013.28, 314.55, -3006.84),
        Vector3.new(-12526.82, 336.94, -7491.79),
        Vector3.new(-16228.93, 9.09, 375.49)
    }

    -- ==================================================
    -- التحقق من أن الموقع ليس محظوراً
    -- ==================================================
    local function IsPositionBlacklisted(position)
        for _, blackPos in ipairs(BlacklistedPositions) do
            local distance = (position - blackPos).Magnitude
            if distance < 50 then -- مدى 50 متر حول الإحداثية المحظورة
                return true
            end
        end
        return false
    end

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1000,
        HitboxSize = 95,
        Prediction = 0.15,    -- زيادة التنبؤ لسرعة الحركة
        Smoothness = 0.35,    -- زيادة سرعة تتبع الكاميرا
        AntiFarmRange = 50,   -- مدى منع الإحداثيات
    }

    -- ==================================================
    -- نظام التحقق من العدو
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- التحقق من الإحداثيات المحظورة
        if IsPositionBlacklisted(hrp.Position) then
            return false
        end
        
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        if myTeam and myTeam.Name == "Marines" then
            if targetTeam and targetTeam.Name == "Pirates" then
                return true
            else
                return false
            end
        end
        
        return true
    end
    
    -- ==================================================
    -- المتغيرات والتلوين البنفسجي
    -- ==================================================
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    local lastTargetPos = nil
    
    local PurpleChams = Instance.new("BoxHandleAdornment")
    PurpleChams.Size = Vector3.new(4, 6, 4)
    PurpleChams.Color3 = Color3.fromRGB(165, 0, 255)
    PurpleChams.AlwaysOnTop = true
    PurpleChams.ZIndex = 10
    PurpleChams.Transparency = 0.4
    PurpleChams.Visible = false
    PurpleChams.Parent = game:GetService("CoreGui")
    
    -- ==================================================
    -- الحصول على أقرب لاعب مع تجنب المناطق المحظورة
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق الـ Hitbox
    -- ==================================================
    local function ApplyHitboxSystem(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            -- التحقق من أن الهدف ليس في منطقة محظورة
            if IsPositionBlacklisted(rootPart.Position) then
                return
            end
            
            pcall(function()
                rootPart.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                rootPart.CanCollide = false
                rootPart.Transparency = 1.0
                rootPart.Material = Enum.Material.ForceField
                
                PurpleChams.Adornee = rootPart
                PurpleChams.Visible = true
                
                if CombatController and type(CombatController.runHitDetection) == "function" then
                    task.spawn(function()
                        pcall(function() CombatController.runHitDetection(plr.Character) end)
                    end)
                end
            end)
        end
    end
    
    -- ==================================================
    -- إعادة ضبط الـ Hitbox
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            pcall(function()
                rootPart.Size = Vector3.new(2, 2, 2)
                rootPart.CanCollide = true
                rootPart.Transparency = 0
            end)
        end
        
        if rootPart and PurpleChams.Adornee == rootPart then
            PurpleChams.Visible = false
            PurpleChams.Adornee = nil
        end
    end
    
    -- ==================================================
    -- تحديث الهدف مع تنبؤ محسّن للسرعة
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
            return
        end
        
        local target = GetNearestEnemy()
        
        if target and target.Character then
            local hrp = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            
            if hrp then
                if target ~= lastTarget then
                    if lastTarget then
                        ResetHitbox(lastTarget)
                    end
                    lastTarget = target
                    ApplyHitboxSystem(target)
                end
                
                CurrentTarget = target
                
                -- تنبؤ محسّن لسرعة الحركة
                local velocity = hrp.AssemblyLinearVelocity
                local currentPos = hrp.Position
                
                -- إذا كان الهدف يتحرك بسرعة، نزيد التنبؤ
                local speed = velocity.Magnitude
                local predictionMultiplier = 1
                if speed > 50 then
                    predictionMultiplier = 1.5
                elseif speed > 100 then
                    predictionMultiplier = 2
                end
                
                CurrentTargetPos = currentPos + (velocity * AimbotConfig.Prediction * predictionMultiplier)
                lastTargetPos = currentPos
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
                PurpleChams.Visible = false
            end
        else
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- CAMERA LOCK مع سرعة استجابة محسّنة
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then return end
        
        if CurrentTarget and CurrentTarget.Character then
            local targetPart = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
            if targetPart and CurrentTargetPos then
                -- استخدام الموقع المتوقع بدلاً من الموقع الحالي
                local targetCFrame = CFrame.new(Camera.CFrame.Position, CurrentTargetPos)
                
                -- تحسين سرعة التتبع بناءً على سرعة الهدف
                local smoothness = AimbotConfig.Smoothness
                local velocity = targetPart.AssemblyLinearVelocity
                local speed = velocity.Magnitude
                
                if speed > 50 then
                    smoothness = smoothness * 1.3 -- تتبع أسرع للأهداف السريعة
                elseif speed > 100 then
                    smoothness = smoothness * 1.6
                end
                
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.min(smoothness, 1))
            end
        end
    end)
    
    -- ==================================================
    -- صيانة دورية للهيت بوكس
    -- ==================================================
    task.spawn(function()
        while task.wait(0.1) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then 
                    -- التحقق من أن الهدف ليس في منطقة محظورة
                    local hrp = lastTarget.Character and lastTarget.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and not IsPositionBlacklisted(hrp.Position) then
                        ApplyHitboxSystem(lastTarget)
                    else
                        ResetHitbox(lastTarget)
                        lastTarget = nil
                        CurrentTarget = nil
                    end
                end
            end
        end
    end)
    
    -- ==================================================
    -- تنظيف عند خروج اللاعب
    -- ==================================================
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- API
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end
    
    print("[ARAKS HUB] CAMERA LOCK + ANTI-FARM ACTIVATED!")
    print("[ARAKS HUB] تم منع " .. #BlacklistedPositions .. " منطقة محظورة")
end

return AimbotModule
