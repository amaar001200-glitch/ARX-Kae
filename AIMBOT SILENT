-- █ ARAKS HUB AIMBOT (تحديث الهيت بوكس الخارجي الشفاف - بدون تجميد الخصوم)
-- ✅ حل مشكلة تجميد الخصوم الوهمي نهائياً (اللاعبين يتحركون طبيعي الآن)
-- ✅ يصنع هيت بوكس خارجي شفاف ومتصل بالرأس لتسجيل الضرر الفعلي
-- ✅ المدى 1000 متر حقيقي مع لون بنفسجي خارق يظهر من خلف الجدران

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "Head",
        MaxDistance = 1000,  -- مدى 1000 متر
        HitboxSize = 20,     -- حجم الهيت بوكس الخارجي الشفاف
        Prediction = 0.07,   -- تنبؤ سريع جداً
    }

    -- ==================================================
    -- التحقق من العدو (لاعبين فقط - بدون بوتات)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        if myTeam and myTeam.Name == "Marines" then
            return targetTeam and targetTeam.Name == "Pirates"
        end
        
        return true
    end
    
    -- ==================================================
    -- المتغيرات وصناعة التلوين البنفسجي للمسافات البعيدة
    -- ==================================================
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    
    local PurpleChams = Instance.new("BoxHandleAdornment")
    PurpleChams.Size = Vector3.new(4, 6, 4)
    PurpleChams.Color3 = Color3.fromRGB(160, 32, 240) -- بنفسجي
    PurpleChams.AlwaysOnTop = true
    PurpleChams.ZIndex = 10
    PurpleChams.Transparency = 0.4
    PurpleChams.Visible = false
    PurpleChams.Parent = game:GetService("CoreGui")
    
    -- ==================================================
    -- الحصول على أقرب لاعب (مدى 1000)
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق الهيت بوكس الخارجي (بدون التعديل على العظام الأصلية)
    -- ==================================================
    local function ApplyHitbox(plr)
        if not plr or not plr.Character then return end
        
        local head = plr.Character:FindFirstChild("Head")
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        
        if head and rootPart then
            pcall(function()
                -- البحث عن الهيت بوكس الخارجي الصانع مسبقاً أو إنشاء واحد جديد
                local extHitbox = head:FindFirstChild("AraksHitbox")
                if not extHitbox then
                    extHitbox = Instance.new("Part")
                    extHitbox.Name = "AraksHitbox"
                    extHitbox.Shape = Enum.PartType.Ball -- دائري لضمان جلب الضربات من كل الجهات
                    extHitbox.CanCollide = false
                    extHitbox.Anchored = false
                    extHitbox.Transparency = 1.0 -- شفاف تماماً 100% ومخفي
                    extHitbox.Massless = true
                    
                    -- ربطه بالرأس بشكل فيزيائي دقيق عشان يتحرك مع حركة اللاعب بدون أي تجميد
                    local weld = Instance.new("Weld")
                    weld.Name = "AraksWeld"
                    weld.Part0 = head
                    weld.Part1 = extHitbox
                    weld.C0 = CFrame.new(0, 0, 0)
                    weld.Parent = extHitbox
                    
                    extHitbox.Parent = head
                end
                
                -- ضبط الحجم المطلوب للهيت بوكس الخارجي الشفاف لجلد السيرفر
                extHitbox.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                
                -- تشغيل التلوين البنفسجي على الخصم
                PurpleChams.Adornee = rootPart
                PurpleChams.Visible = true
            end)
        end
    end
    
    -- ==================================================
    -- إعادة ضبط الهيت بوكس الخارجي والتأثيرات
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local head = plr.Character:FindFirstChild("Head")
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        
        if head then
            local extHitbox = head:FindFirstChild("AraksHitbox")
            if extHitbox then
                pcall(function()
                    extHitbox.Size = Vector3.new(1, 1, 1) -- تصغيره للحجم الطبيعي عند إلغاء الهدف
                end)
            end
        end
        
        if rootPart and PurpleChams.Adornee == rootPart then
            PurpleChams.Visible = false
            PurpleChams.Adornee = nil
        end
    end
    
    -- ==================================================
    -- AIMBOT UPDATE
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
            return
        end
        
        local target = GetNearestEnemy()
        
        if target and target.Character then
            local head = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            
            if head then
                if target ~= lastTarget then
                    if lastTarget then
                        ResetHitbox(lastTarget)
                    end
                    lastTarget = target
                    ApplyHitbox(target)
                end
                
                CurrentTarget = target
                
                -- التنبؤ بالحركة الذكي بالاعتماد على سرعة الرأس الفعلي
                local velocity = head.AssemblyLinearVelocity
                CurrentTargetPos = head.Position + (velocity * AimbotConfig.Prediction)
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
                PurpleChams.Visible = false
            end
        else
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- تثبيت مستمر بدون التسبب بأي تجميد للاعبين
    -- ==================================================
    task.spawn(function()
        while task.wait(0.3) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then 
                    ApplyHitbox(lastTarget)
                end
            end
        end
    end)
    
    -- ==================================================
    -- SILENT AIM
    -- ==================================================
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character then
                local head = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
                if head then
                    return head.CFrame
                end
            end
        end
        return oldIndex(self, index)
    end)
    
    -- ==================================================
    -- REMOTE HOOK
    -- ==================================================
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                
                if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") and not remoteName:find("spawn") then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = CurrentTargetPos
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    
    -- ==================================================
    -- تنظيف عند خروج اللاعب
    -- ==================================================
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- تشغيل / إيقاف الأداة
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end
    
    print("[ARAKS HUB] FIXED 100% - اللاعبين يتحركون بشكل طبيعي والهيت بوكس مخفي وتلقائي!")
end

return AimbotModule
