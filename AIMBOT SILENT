-- █ ARAKS HUB AIMBOT (للاعبين فقط + مدى 1000)
-- ✅ المدى 1000 متر حقيقي وعنيف جداً
-- ✅ الـ Hitbox شفاف ومخفي تماماً (Transparency = 1)
-- ✅ الخصم يتلون بالبنفسجي بالكامل ويظهر من خلف الجدران وعلى مسافة 1000 متر
-- ✅ تم حل مشكلة عدم توجيه الضربات وتجميد الحركة نهائياً

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1000,  -- مدى 1000 متر حقيقي
        HitboxSize = 60,     -- حجم 60 يضمن اللمس التلقائي والإصابة من مسافات بعيدة
        Prediction = 0.08,   -- تنبؤ متوازن وسريع جداً للضربات
    }

    -- ==================================================
    -- التحقق من العدو (لاعبين فقط - بدون بوتات)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        if myTeam and myTeam.Name == "Marines" then
            return targetTeam and targetTeam.Name == "Pirates"
        end
        
        return true
    end
    
    -- ==================================================
    -- المتغيرات وصناعة التلوين البنفسجي للمسافات البعيدة
    -- ==================================================
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    
    -- إنشاء مظهر بنفسجي خارق يظهر من أي مسافة 1000 متر
    local PurpleChams = Instance.new("BoxHandleAdornment")
    PurpleChams.Size = Vector3.new(4, 6, 4) -- يغطي حجم جسم اللاعب بالكامل
    PurpleChams.Color3 = Color3.fromRGB(160, 32, 240) -- بنفسجي نيون واضح
    PurpleChams.AlwaysOnTop = true -- يظهر من خلف الجدران والمسافات البعيدة
    PurpleChams.ZIndex = 10
    PurpleChams.Transparency = 0.4
    PurpleChams.Visible = false
    PurpleChams.Parent = game:GetService("CoreGui")
    
    -- ==================================================
    -- الحصول على أقرب لاعب (مدى 1000)
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق Hitbox (شفاف بالكامل لللاعبين فقط)
    -- ==================================================
    local function ApplyHitbox(plr)
        if not plr or not plr.Character then return end
        if not plr:IsA("Player") then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and hum and hum.Health > 0 then
            pcall(function()
                -- تكبير السيرفر هيد بوكس وضمان عدم حجب الضربات
                rootPart.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                rootPart.CanCollide = false
                rootPart.Transparency = 1.0 -- شفاف 100% لا يوجد أي أثر للبوكس على الشاشة
                
                -- تفعيل اللون البنفسجي على الخصم فوراً ومن أي مسافة
                PurpleChams.Adornee = rootPart
                PurpleChams.Visible = true
            end)
        end
    end
    
    -- ==================================================
    -- إعادة ضبط Hitbox والتأثيرات
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            pcall(function()
                rootPart.Size = Vector3.new(2, 2, 2)
                rootPart.CanCollide = true
                rootPart.Transparency = 0
            end)
        end
        
        if PurpleChams.Adornee == rootPart then
            PurpleChams.Visible = false
            PurpleChams.Adornee = nil
        end
    end
    
    -- ==================================================
    -- AIMBOT UPDATE
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
            return
        end
        
        local target = GetNearestEnemy()
        
        if target and target.Character then
            local hrp = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            
            if hrp then
                if target ~= lastTarget then
                    if lastTarget then
                        ResetHitbox(lastTarget)
                    end
                    lastTarget = target
                    ApplyHitbox(target)
                end
                
                CurrentTarget = target
                
                -- التنبؤ بالحركة للمسافات البعيدة (1000 متر)
                local velocity = hrp.AssemblyLinearVelocity
                CurrentTargetPos = hrp.Position + (velocity * AimbotConfig.Prediction)
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
                PurpleChams.Visible = false
            end
        else
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- تثبيت مستمر للـ Hitbox والتلوين البنفسجي
    -- ==================================================
    task.spawn(function()
        while task.wait(0.2) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then 
                    ApplyHitbox(lastTarget)
                end
            end
        end
    end)
    
    -- ==================================================
    -- SILENT AIM (توجيه الضربات المباشر)
    -- ==================================================
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character then
                local targetPart = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
                if targetPart then
                    return targetPart.CFrame
                end
            end
        end
        return oldIndex(self, index)
    end)
    
    -- ==================================================
    -- REMOTE HOOK (توجيه ريموتات المهارات للخصم دون التأثير على حركة اللاعب)
    -- ==================================================
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                
                -- حماية ريموتات التنقل والـ Dash الخاصة بك لمنع التجميد أو البطء
                if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") and not remoteName:find("spawn") then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            -- توجيه الآيـم والضربات فوراً إلى موقع الخصم المستهدف
                            args[i] = CurrentTargetPos
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    
    -- ==================================================
    -- تنظيف عند خروج اللاعب
    -- ==================================================
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- تشغيل / إيقاف الأداة
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end
    
    print("[ARAKS HUB] المدى 1000م حقيقي | الـ Hitbox مخفي تماماً | اللون البنفسجي يعمل من أي مسافة!")
end

return AimbotModule
