-- █ ARAKS HUB AIMBOT (للاعبين فقط + مدى 1000)
-- ✅ الـ Hitbox فقط للاعبين (مو البوتات) ✅ مدى 1000 ✅ تصويب قوي

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "HumanoidRootPart",
        MaxDistance = 1000,  -- مدى 1000
        HitboxSize = 90,     -- حجم 90
        Prediction = 0.12,
    }

    -- ==================================================
    -- التحقق من العدو (لاعبين فقط - بدون بوتات)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr then return false end
        if plr == player then return false end
        
        -- ❌ منع استهداف البوتات
        if plr:IsA("Player") == false then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        -- تجنب البوتات (NPCs) عن طريق التحقق من اسم عشوائي
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        if myTeam and myTeam.Name == "Marines" then
            return targetTeam and targetTeam.Name == "Pirates"
        end
        
        return true
    end
    
    -- ==================================================
    -- المتغيرات
    -- ==================================================
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    
    -- الخط المرئي
    local TargetLine = Drawing.new("Line")
    TargetLine.Color = Color3.fromRGB(255, 0, 150)
    TargetLine.Thickness = 6
    TargetLine.Transparency = 1
    TargetLine.Visible = false
    
    -- ==================================================
    -- الحصول على أقرب لاعب
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق Hitbox (لللاعبين فقط)
    -- ==================================================
    local function ApplyHitbox(plr)
        if not plr or not plr.Character then return end
        
        -- تأكيد أنه لاعب مش بوت
        if plr:IsA("Player") == false then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and hum and hum.Health > 0 then
            pcall(function()
                rootPart.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                rootPart.CanCollide = false
                rootPart.Transparency = 0.3
                rootPart.Material = Enum.Material.Neon
            end)
        end
    end
    
    -- ==================================================
    -- إعادة ضبط Hitbox
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            pcall(function()
                rootPart.Size = Vector3.new(2, 2, 2)
                rootPart.CanCollide = true
            end)
        end
    end
    
    -- ==================================================
    -- AIMBOT UPDATE
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            return
        end
        
        local target = GetNearestEnemy()
        
        if target and target.Character then
            local hrp = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            
            if hrp then
                if target ~= lastTarget then
                    if lastTarget then
                        ResetHitbox(lastTarget)
                    end
                    lastTarget = target
                    ApplyHitbox(target)
                end
                
                CurrentTarget = target
                
                local velocity = hrp.AssemblyLinearVelocity
                CurrentTargetPos = hrp.Position + (velocity * AimbotConfig.Prediction)
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
            end
        else
            CurrentTarget = nil
            CurrentTargetPos = nil
        end
    end)
    
    -- ==================================================
    -- تثبيت الـ Hitbox
    -- ==================================================
    task.spawn(function()
        while task.wait(0.3) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then  -- بس للاعبين
                    ApplyHitbox(lastTarget)
                end
            end
        end
    end)
    
    -- ==================================================
    -- رسم الخط
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive or not CurrentTargetPos then
            TargetLine.Visible = false
            return
        end
        
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then
            TargetLine.Visible = false
            return
        end
        
        local myPos, myVisible = Camera:WorldToViewportPoint(myHrp.Position)
        local targetPos, targetVisible = Camera:WorldToViewportPoint(CurrentTargetPos)
        
        if myVisible and targetVisible then
            local fromPoint = Vector2.new(myPos.X, myPos.Y)
            local toPoint = Vector2.new(targetPos.X, targetPos.Y)
            local direction = (toPoint - fromPoint).Unit
            local extendedPoint = toPoint + (direction * 200)
            
            TargetLine.From = fromPoint
            TargetLine.To = extendedPoint
            TargetLine.Visible = true
        else
            TargetLine.Visible = false
        end
    end)
    
    -- ==================================================
    -- SILENT AIM
    -- ==================================================
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character then
                local targetPart = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
                if targetPart then
                    return targetPart.CFrame
                end
            end
        end
        return oldIndex(self, index)
    end)
    
    -- ==================================================
    -- REMOTE HOOK
    -- ==================================================
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                if not remoteName:find("m1") and not remoteName:find("click") and not remoteName:find("attack") then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = CurrentTargetPos
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    
    -- ==================================================
    -- تنظيف
    -- ==================================================
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
        end
    end)
    
    -- ==================================================
    -- API
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            TargetLine.Visible = false
        end
    end
    
    print("[ARAKS HUB] AIMBOT - لاعبين فقط | مدى 1000 | حجم 90")
end

return AimbotModule
