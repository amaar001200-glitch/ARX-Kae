-- █ ARAKS HUB AIMBOT (تحديث الـ Hitbox الفعلي للرأس)
-- ✅ تم حذف تكبير الـ HumanoidRootPart نهائياً لمنع جليتش عدم تسجيل الضرر
-- ✅ تم تكبير الـ Head (الرأس) لأنه الـ Hitbox الفعلي والأساسي للضرر
-- ✅ الـ Hitbox مخفي وشفاف تماماً (Transparency = 1)
-- ✅ المدى 1000 متر واللون البنفسجي يعمل بوضوح كامل من أي مسافة

local AimbotModule = {}

do
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera

    getgenv().AimbotActive = false

    local AimbotConfig = {
        TargetPart = "Head",  -- الاعتماد على الرأس لتسجيل الضرر الفعلي
        MaxDistance = 1000,   -- مدى 1000 متر حقيقي
        HitboxSize = 20,      -- الحجم المثالي للرأس لضمان الجلد بدون حجب السيرفر للضرر
        Prediction = 0.08,    -- تنبؤ متوازن وسريع
    }

    -- ==================================================
    -- التحقق من العدو (لاعبين فقط - بدون بوتات)
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == player then return false end
        if not plr:IsA("Player") then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local userId = plr.UserId
        if userId <= 0 or userId == nil then return false end
        
        local myTeam = player.Team
        local targetTeam = plr.Team
        
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        if myTeam and myTeam.Name == "Marines" then
            return targetTeam and targetTeam.Name == "Pirates"
        end
        
        return true
    end
    
    -- ==================================================
    -- المتغيرات وصناعة التلوين البنفسجي للمسافات البعيدة
    -- ==================================================
    local CurrentTarget = nil
    local CurrentTargetPos = nil
    local lastTarget = nil
    
    local PurpleChams = Instance.new("BoxHandleAdornment")
    PurpleChams.Size = Vector3.new(4, 6, 4) -- يغطي حجم الخصم بالكامل
    PurpleChams.Color3 = Color3.fromRGB(160, 32, 240) -- بنفسجي نيون
    PurpleChams.AlwaysOnTop = true
    PurpleChams.ZIndex = 10
    PurpleChams.Transparency = 0.4
    PurpleChams.Visible = false
    PurpleChams.Parent = game:GetService("CoreGui")
    
    -- ==================================================
    -- الحصول على أقرب لاعب (مدى 1000)
    -- ==================================================
    local function GetNearestEnemy()
        local char = player.Character
        if not char then return nil end
        
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil end
        
        local nearest = nil
        local nearestDist = AimbotConfig.MaxDistance
        local myPos = myHrp.Position
        
        for _, pl in ipairs(Players:GetPlayers()) do
            if IsValidEnemy(pl) then
                local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = pl
                    end
                end
            end
        end
        return nearest
    end
    
    -- ==================================================
    -- تطبيق الـ Hitbox الفعلي (تكبير الرأس وتصفيره مرئياً)
    -- ==================================================
    local function ApplyHitbox(plr)
        if not plr or not plr.Character then return end
        if not plr:IsA("Player") then return end
        
        local targetPart = plr.Character:FindFirstChild(AimbotConfig.TargetPart) -- الرأس
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        
        if targetPart and hum and hum.Health > 0 then
            pcall(function()
                -- تكبير الرأس وهو الـ Hitbox الفعلي للضرر
                targetPart.Size = Vector3.new(AimbotConfig.HitboxSize, AimbotConfig.HitboxSize, AimbotConfig.HitboxSize)
                targetPart.CanCollide = false
                targetPart.Transparency = 1.0 -- شفاف تماماً ومخفي 100%
                
                -- تشغيل التلوين البنفسجي على الخصم من أي مسافة
                if rootPart then
                    PurpleChams.Adornee = rootPart
                    PurpleChams.Visible = true
                end
            end)
        end
    end
    
    -- ==================================================
    -- إعادة ضبط الـ Hitbox الفعلي والتأثيرات
    -- ==================================================
    local function ResetHitbox(plr)
        if not plr or not plr.Character then return end
        
        local targetPart = plr.Character:FindFirstChild(AimbotConfig.TargetPart)
        local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
        
        if targetPart then
            pcall(function()
                targetPart.Size = Vector3.new(2, 1, 1) -- الحجم الطبيعي للرأس في روبلوكس
                targetPart.CanCollide = true
                targetPart.Transparency = 0
            end)
        end
        
        if rootPart and PurpleChams.Adornee == rootPart then
            PurpleChams.Visible = false
            PurpleChams.Adornee = nil
        end
    end
    
    -- ==================================================
    -- AIMBOT UPDATE
    -- ==================================================
    RunService.RenderStepped:Connect(function()
        if not getgenv().AimbotActive then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
            return
        end
        
        local target = GetNearestEnemy()
        
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild(AimbotConfig.TargetPart)
            
            if targetPart then
                if target ~= lastTarget then
                    if lastTarget then
                        ResetHitbox(lastTarget)
                    end
                    lastTarget = target
                    ApplyHitbox(target)
                end
                
                CurrentTarget = target
                
                -- التنبؤ بحركة الرأس للمسافات البعيدة
                local velocity = targetPart.AssemblyLinearVelocity
                CurrentTargetPos = targetPart.Position + (velocity * AimbotConfig.Prediction)
            else
                CurrentTarget = nil
                CurrentTargetPos = nil
                PurpleChams.Visible = false
            end
        else
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- تثبيت مستمر للـ Hitbox الجديد والتلوين البنفسجي
    -- ==================================================
    task.spawn(function()
        while task.wait(0.2) do
            if getgenv().AimbotActive and lastTarget then
                if lastTarget:IsA("Player") then 
                    ApplyHitbox(lastTarget)
                end
            end
        end
    end)
    
    -- ==================================================
    -- SILENT AIM (توجيه الضربات المباشر للرأس المكبّر)
    -- ==================================================
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if index == "Hit" and getgenv().AimbotActive and not checkcaller() then
            if CurrentTarget and CurrentTarget.Character then
                local targetPart = CurrentTarget.Character:FindFirstChild(AimbotConfig.TargetPart)
                if targetPart then
                    return targetPart.CFrame
                end
            end
        end
        return oldIndex(self, index)
    end)
    
    -- ==================================================
    -- REMOTE HOOK (توجيه ريموتات المهارات دون أي تجميد أو بطء للاعب)
    -- ==================================================
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if getgenv().AimbotActive and CurrentTargetPos and not checkcaller() then
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self.Name):lower()
                
                if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") and not remoteName:find("spawn") then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = CurrentTargetPos
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    
    -- ==================================================
    -- تنظيف عند خروج اللاعب
    -- ==================================================
    Players.PlayerRemoving:Connect(function(plr)
        if lastTarget == plr then
            ResetHitbox(plr)
            lastTarget = nil
            CurrentTarget = nil
            PurpleChams.Visible = false
        end
    end)
    
    -- ==================================================
    -- تشغيل / إيقاف الأداة
    -- ==================================================
    function AimbotModule:SetState(state)
        getgenv().AimbotActive = state
        if not state then
            if lastTarget then
                ResetHitbox(lastTarget)
                lastTarget = nil
            end
            CurrentTarget = nil
            CurrentTargetPos = nil
            PurpleChams.Visible = false
        end
    end
    
    print("[ARAKS HUB] HEAD HITBOX FIXED - تم تعديل الهيت بوكس الفعلي للرأس بنجاح وجعله شفافاً!")
end

return AimbotModule
