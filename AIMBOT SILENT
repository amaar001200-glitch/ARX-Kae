-- █ ARAKS HUB AIMBOT - FULL FIXED (HITBOX VISIBLE & LARGE)
-- ✅ الـ Hitbox كبير جداً 30x30 ✅ ظاهر ومكشوف ✅ بدون تجميد

local AimbotModule = {}

do

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Camera = workspace.CurrentCamera

local player = Players.LocalPlayer

getgenv().AimbotActive = false

-- =========================
-- CONFIG
-- =========================
local Config = {
    TargetPart = "HumanoidRootPart",
    MaxDistance = 1000,
    Prediction = 0.14,
    HitboxSize = 30  -- ✅ حجم كبير جداً 30x30 (يضمن إصابة السيف المستقيم والسريع)
}

-- =========================
-- STATE
-- =========================
local CurrentTarget = nil
local CurrentTargetPos = nil
local lastTarget = nil

-- =========================
-- TEAM CHECK
-- =========================
local function IsValidEnemy(plr)
    if not plr or plr == player then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local myTeam = player.Team
    local targetTeam = plr.Team

    if myTeam and myTeam.Name == "Pirates" then
        return true
    end
    if myTeam and myTeam.Name == "Marines" then
        return targetTeam and targetTeam.Name == "Pirates"
    end
    return true
end

-- =========================
-- GET NEAREST TARGET
-- =========================
local function GetNearestEnemy()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest = nil
    local distLimit = Config.MaxDistance
    local rootPos = root.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if IsValidEnemy(plr) and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - rootPos).Magnitude
                if dist < distLimit then
                    distLimit = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

-- =========================
-- ✅ MASSIVE VISIBLE HITBOX SYSTEM (30x30 - مكشوف وكبير)
-- =========================
local EnlargedTargets = {}

local function ApplyMassiveHitbox(plr)
    if not plr or not plr.Character then return end
    
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    
    if root and hum and hum.Health > 0 then
        local newSize = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
        
        pcall(function()
            -- ✅ نجعل الـ Hitbox كبير وظاهر (مخفي مشكلة)
            root.Size = newSize
            root.CanCollide = false
            root.Transparency = 0  -- ✅ ظاهر وليس مخفي (عشان السيف السريع يشوفه)
            root.Material = Enum.Material.Neon  -- ✅ يلمع عشان يبان أكثر
            
            -- ✅ نكبر كل أجزاء الجسم عشان السيف السريع ما يخطئ
            local allParts = plr.Character:GetChildren()
            for _, part in ipairs(allParts) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Size = newSize
                    part.CanCollide = false
                    part.Transparency = 0  -- ✅ ظاهر
                end
            end
            
            EnlargedTargets[plr] = true
        end)
    end
end

local function ResetHitbox(plr)
    if not plr or not plr.Character then return end
    
    if EnlargedTargets[plr] then
        pcall(function()
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                root.Size = Vector3.new(2, 2, 2)
                root.CanCollide = true
                root.Transparency = 1  -- ✅ نرجع مخفي
                root.Material = Enum.Material.Plastic
            end
            
            local allParts = plr.Character:GetChildren()
            for _, part in ipairs(allParts) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Size = Vector3.new(2, 2, 2)
                    part.CanCollide = true
                    part.Transparency = 1
                end
            end
            
            EnlargedTargets[plr] = nil
        end)
    end
end

-- =========================
-- AIMBOT UPDATE LOOP (سريع جداً لمنع ضياع الضربات)
-- =========================
RunService.RenderStepped:Connect(function()
    if not getgenv().AimbotActive then
        CurrentTarget = nil
        CurrentTargetPos = nil
        if lastTarget then
            ResetHitbox(lastTarget)
            lastTarget = nil
        end
        return
    end

    local target = GetNearestEnemy()
    
    if target and target.Character then
        local hrp = target.Character:FindFirstChild(Config.TargetPart)
        if hrp then
            CurrentTarget = target
            local velocity = hrp.AssemblyLinearVelocity
            CurrentTargetPos = hrp.Position + (velocity * Config.Prediction)
            
            -- ✅ نطبق الهيت بوكس الضخم فوراً
            if target ~= lastTarget then
                if lastTarget then
                    ResetHitbox(lastTarget)
                end
                ApplyMassiveHitbox(target)
                lastTarget = target
            else
                -- ✅ نتأكد أن الهيت بوكس باقي كبير وظاهر (مهم للسيف السريع)
                local root = target.Character:FindFirstChild("HumanoidRootPart")
                if root and (root.Size.X < Config.HitboxSize - 5 or root.Transparency == 1) then
                    ApplyMassiveHitbox(target)
                end
            end
        else
            CurrentTarget = nil
            CurrentTargetPos = nil
        end
    else
        CurrentTarget = nil
        CurrentTargetPos = nil
    end
end)

-- =========================
-- VISUAL LINE
-- =========================
local Line = Drawing.new("Line")
Line.Color = Color3.fromRGB(180, 0, 255)
Line.Thickness = 6
Line.Transparency = 1
Line.Visible = false

local LineExtension = 250

RunService.RenderStepped:Connect(function()
    if not getgenv().AimbotActive or not CurrentTargetPos then
        Line.Visible = false
        return
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        Line.Visible = false
        return
    end

    local a, va = Camera:WorldToViewportPoint(root.Position)
    local b, vb = Camera:WorldToViewportPoint(CurrentTargetPos)

    if va and vb then
        local fromPoint = Vector2.new(a.X, a.Y)
        local toPoint = Vector2.new(b.X, b.Y)
        local direction = (toPoint - fromPoint).Unit
        local extendedPoint = toPoint + (direction * LineExtension)
        
        Line.From = fromPoint
        Line.To = extendedPoint
        Line.Visible = true
    else
        Line.Visible = false
    end
end)

-- =========================
-- SILENT AIM
-- =========================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, index)
    if index == "Hit"
        and getgenv().AimbotActive
        and not checkcaller()
        and CurrentTarget
        and CurrentTarget.Character
    then
        local root = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        if root then
            return root.CFrame
        end
    end
    return oldIndex(self, index)
end)

-- =========================
-- REMOTE HOOK
-- =========================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if getgenv().AimbotActive
        and CurrentTargetPos
        and not checkcaller()
        and (method == "FireServer" or method == "InvokeServer")
    then
        local name = tostring(self.Name):lower()
        if not name:find("skill")
            and not name:find("ability")
            and not name:find("combo")
            and not name:find("dash")
        then
            for i, v in ipairs(args) do
                if typeof(v) == "Vector3" and i <= 2 then
                    args[i] = CurrentTargetPos
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- =========================
-- تنظيف
-- =========================
Players.PlayerRemoving:Connect(function(plr)
    ResetHitbox(plr)
    if CurrentTarget == plr then
        CurrentTarget = nil
        CurrentTargetPos = nil
        lastTarget = nil
    end
end)

local function onCharacterAdded(plr, char)
    char:WaitForChild("Humanoid").Died:Connect(function()
        if CurrentTarget == plr then
            CurrentTarget = nil
            CurrentTargetPos = nil
            ResetHitbox(plr)
            lastTarget = nil
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr.Character then
        onCharacterAdded(plr, plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        onCharacterAdded(plr, char)
    end)
end

-- =========================
-- API
-- =========================
function AimbotModule:SetState(state)
    getgenv().AimbotActive = state
    if not state then
        CurrentTarget = nil
        CurrentTargetPos = nil
        if lastTarget then
            ResetHitbox(lastTarget)
            lastTarget = nil
        end
        Line.Visible = false
    end
end

print("[ARAKS HUB] AIMBOT - Hitbox 30x30 ظاهر وكبير | السيف السريع سيصيب الآن")

end

return AimbotModule
