-- █ HAKI HARDENING (FIXED)

return function(env)
    local Config = env.Config
    local LocalPlayer = env.LocalPlayer
    local RunService = env.RunService
    local ReplicatedStorage = env.ReplicatedStorage

    local HakiModule = {}
    local BusoConnection = nil
    local CommF_ = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes.CommF_

    local function IsBusoActive()
        local character = LocalPlayer.Character
        if character then
            return character:FindFirstChild("HasBuso") ~= nil
        end
        return false
    end

    local function ActivateBuso()
        pcall(function()
            if CommF_ and not IsBusoActive() then
                CommF_:InvokeServer("Buso")
            end
        end)
    end

    function HakiModule.Start()
        if BusoConnection then
            BusoConnection:Disconnect()
            BusoConnection = nil
        end
        BusoConnection = RunService.Heartbeat:Connect(function()
            if Config.BusoEnabled and not IsBusoActive() then
                ActivateBuso()
            end
        end)
    end

    function HakiModule.Stop()
        if BusoConnection then
            BusoConnection:Disconnect()
            BusoConnection = nil
        end
    end

    function HakiModule.Update()
        if Config.BusoEnabled then
            HakiModule.Start()
        else
            HakiModule.Stop()
        end
    end

    return HakiModule
end
