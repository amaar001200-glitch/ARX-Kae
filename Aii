-- =============================================================================
-- █ ARAKS HUB | AUTO HUNT MODULE (KILL SYSTEM + SKILLS)
-- version 1.4_FIXED (Fully Compatible with Old UI Buttons & New Logic)
-- =============================================================================

local AutoHuntModule = {}

do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local TweenService = game:GetService("TweenService")
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    
    -- Remotes
    local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules.Net
    local RegisterAttack = Net and Net["RE/RegisterAttack"]
    local RegisterHit = Net and Net["RE/RegisterHit"]
    
    -- بيانات AutoHunt الأصلية (محفوظة كما هي لتعمل الأزرار معاً)
    local Enabled = false
    local KillNearest = false
    local SelectedPlayer = nil
    local SkillBusy = false
    
    local lastHitTick = 0
    local FightCache = {}

    -- الإحداثيات المحظورة للأمان لمنع الحظر والجليتشات
    local BlacklistedZones = {
        Vector3.new(-11.26, 19.31, 2827.25),
        Vector3.new(-10.01, 35.51, 2732.26),
        Vector3.new(-380.55, 73.05, 303.43),
        Vector3.new(-6471.88, 305.41, -4730.00),
        Vector3.new(-359.07, 20.64, 5535.89),
        Vector3.new(-111.14, 10.64, 5458.43),
        Vector3.new(-484.06, 10.64, 5345.74),
        Vector3.new(-5013.28, 314.55, -3006.84),
        Vector3.new(-12526.82, 336.94, -7491.79),
        Vector3.new(-16228.93, 9.09, 375.49)
    }

    local function IsInBlacklistedZone(targetPos)
        if not targetPos then return true end
        for _, zonePos in ipairs(BlacklistedZones) do
            if (targetPos - zonePos).Magnitude <= 150 then return true end 
        end
        return false
    end

    -- فحص حالة الـ PVP والقتال بدقة
    local function GetPlayerState(plr)
        if not plr or plr == LocalPlayer then return "OFF" end
        local pvpDisabled = false
        pcall(function()
            pvpDisabled = plr:GetAttribute("PvpDisabled") or plr:GetAttribute("PvpEnable") == false
        end)
        if pvpDisabled then return "OFF" end
        
        local char = plr.Character
        if char then
            local inCombat = false
            pcall(function() inCombat = char:GetAttribute("InCombat") end)
            if inCombat then FightCache[plr] = tick() end
        end
        
        if FightCache[plr] and (tick() - FightCache[plr]) <= 12 then
            return "FIGHT"
        end
        return "ON"
    end
    
    -- ==================================================
    -- نظام تجنب الأصدقاء والتحالفات المطور
    -- ==================================================
    local function IsValidEnemy(plr)
        if not plr or plr == LocalPlayer then return false end
        
        local char = plr.Character
        if not char then return false end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        
        -- تجنب المناطق الأمنية
        if IsInBlacklistedZone(hrp.Position) then return false end
        
        local myTeam = LocalPlayer.Team
        local targetTeam = plr.Team
        local state = GetPlayerState(plr)
        
        if state == "OFF" then return false end
        
        -- القراصنة يصيدون أي شخص مشغل الـ PVP
        if myTeam and myTeam.Name == "Pirates" then
            return true
        end
        
        -- البحرية يتجنبون بعضهم ويصيدون القراصنة أو من في نمط القتال
        if myTeam and myTeam.Name == "Marines" then
            if targetTeam and targetTeam.Name == "Marines" then return false end
            if (targetTeam and targetTeam.Name == "Pirates") or state == "FIGHT" then
                return true
            end
        end
        
        return false
    end
    
    -- ==================================================
    -- نظام الطيران عند انخفاض الدم (يشتغل فقط لما الموديل شغال)
    -- ==================================================
    local LOW_HEALTH_FLY = 5000
    local SAFE_HEALTH_RETURN = 8000
    local FlyMode = false
    local SavedTarget = nil
    local FlyPosition = nil
    
    -- منصة السماء
    local SkyPlatform = Instance.new("Part")
    SkyPlatform.Name = "ARAKS_SkyPlatform"
    SkyPlatform.Size = Vector3.new(35, 1, 35)
    SkyPlatform.Transparency = 0.5
    SkyPlatform.Material = Enum.Material.ForceField
    SkyPlatform.Color = Color3.fromRGB(255, 85, 85)
    SkyPlatform.Anchored = true
    SkyPlatform.CanCollide = true
    SkyPlatform.Parent = workspace
    SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
    
    -- مفاتيح المهارات
    local HotbarKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local SkillKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}
    
    -- متغيرات التشغيل
    local currentTween = nil
    
    -- المنصة
    local platform = Instance.new("Part")
    platform.Name = "ARAKS_Platform"
    platform.Size = Vector3.new(35, 1, 35)
    platform.Transparency = 0.5
    platform.Material = Enum.Material.ForceField
    platform.Color = Color3.fromRGB(88, 55, 175)
    platform.Anchored = true
    platform.CanCollide = true
    platform.Parent = workspace
    platform.CFrame = CFrame.new(0, -1000, 0)
    
    -- دوال داخلية
    local function IsAlive()
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChild("Humanoid")
        return hum and hum.Health > 0
    end
    
    local function GetMyHealth()
        local char = LocalPlayer.Character
        if not char then return 0 end
        local hum = char:FindFirstChild("Humanoid")
        return hum and hum.Health or 0
    end
    
    local function IsModuleActive()
        return Enabled or KillNearest or (SelectedPlayer ~= nil)
    end
    
    local function TapKey(key)
        if not IsAlive() then return end
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.018)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end
    
    local function UseSkill(skill)
        if not IsAlive() then return end
        TapKey(skill)
        task.wait(0.04)
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
        task.wait(0.1)
    end
    
    local function GetNearestEnemy()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local nearest = nil
        local shortestDist = 5000
        for _, p in pairs(Players:GetPlayers()) do
            if IsValidEnemy(p) then
                local c = p.Character
                local root = c and c:FindFirstChild("HumanoidRootPart")
                local hum = c and c:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (root.Position - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = p
                    end
                end
            end
        end
        return nearest
    end
    
    local function GetCurrentTarget()
        if not IsModuleActive() then
            return nil
        end
        
        if FlyMode then
            return SavedTarget
        end
        
        local target = nil
        if KillNearest then
            target = GetNearestEnemy()
        elseif Enabled and SelectedPlayer then
            if IsValidEnemy(SelectedPlayer) then
                target = SelectedPlayer
            else
                target = nil
            end
        end
        return target
    end
    
    local function FlyToSky()
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        
        FlyPosition = myHrp.Position + Vector3.new(0, 7000, 0)
        
        SkyPlatform.CFrame = CFrame.new(FlyPosition.X, FlyPosition.Y - 3, FlyPosition.Z)
        SkyPlatform.CanCollide = true
        
        myHrp.CFrame = CFrame.new(FlyPosition)
        myHrp.Velocity = Vector3.zero
        myHrp.RotVelocity = Vector3.zero
        
        platform.CFrame = CFrame.new(0, -1000, 0)
    end
    
    local function ReturnToGround(target)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        
        local targetChar = target and target.Character
        local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        
        if targetHrp then
            -- النزول بمسافة 12 ستاذ فوق الخصم لتأمين دقة التثبيت والجلد
            myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 12, 0)
        end
        
        myHrp.Velocity = Vector3.zero
        myHrp.RotVelocity = Vector3.zero
        
        SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
    end
    
    local function GetSessionID()
        local ok, result = pcall(function()
            local SendHitsToServer = getrenv()._G.SendHitsToServer
            local CombatThread = getupvalues(SendHitsToServer)[1]
            return tostring(LocalPlayer.UserId):sub(2,4)..tostring(CombatThread):sub(11,15)
        end)
        return ok and result or ""
    end
    
    local function Attack(target)
        if not target or not target:FindFirstChild("HumanoidRootPart") then return end
        if RegisterAttack and RegisterHit then
            pcall(function()
                RegisterAttack:FireServer(0.5)
                RegisterHit:FireServer(target.HumanoidRootPart, {}, nil, GetSessionID())
                if tick() - lastHitTick > 0.12 then
                    lastHitTick = tick()
                    RegisterHit:FireServer(target.HumanoidRootPart, {{target, target.HumanoidRootPart}})
                    RegisterHit:FireServer(target.HumanoidRootPart, {}, "Melee", "")
                end
            end)
        end
    end
    
    local function MoveToEnemy(targetChar, hrp)
        if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then
            platform.CFrame = CFrame.new(0, -1000, 0)
            return false
        end
        local enemyRoot = targetChar.HumanoidRootPart
        
        if IsInBlacklistedZone(enemyRoot.Position) then
            if currentTween then currentTween:Cancel() end
            return false
        end

        -- التوين يحافظ على مسافة 12 ستاذ فوق رأس الخصم تماماً
        local targetCFrame = enemyRoot.CFrame * CFrame.new(0, 12, 0)
        local distance = (targetCFrame.Position - hrp.Position).Magnitude
        
        platform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.5, hrp.Position.Z)
        platform.CanCollide = true
        
        if distance > 10 then
            if currentTween then pcall(function() currentTween:Cancel() end) end
            currentTween = TweenService:Create(hrp, TweenInfo.new(distance / 350, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
            currentTween:Play()
            currentTween.Completed:Wait()
            currentTween = nil
        end
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        return true
    end
    
    -- ==================================================
    -- نظام مراقبة الدم والطيران (يشتغل فقط لما الموديل شغال)
    -- ==================================================
    task.spawn(function()
        while true do
            task.wait(0.1)
            
            if not IsModuleActive() or not IsAlive() then
                if FlyMode then
                    FlyMode = false
                    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp then
                        SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
                    end
                end
                continue
            end
            
            local myHealth = GetMyHealth()
            local currentTarget = GetCurrentTarget()
            
            -- حالة انخفاض الدم
            if myHealth <= LOW_HEALTH_FLY and not FlyMode and IsModuleActive() then
                FlyMode = true
                SavedTarget = currentTarget
                FlyToSky()
            end
            
            -- حالة العودة بعد تعبئة الدم
            if FlyMode and myHealth >= SAFE_HEALTH_RETURN then
                FlyMode = false
                ReturnToGround(SavedTarget)
            end
            
            -- تثبيت في السماء
            if FlyMode then
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myHrp and FlyPosition then
                    myHrp.CFrame = CFrame.new(FlyPosition)
                    myHrp.Velocity = Vector3.zero
                    myHrp.RotVelocity = Vector3.zero
                    SkyPlatform.CFrame = CFrame.new(FlyPosition.X, FlyPosition.Y - 3, FlyPosition.Z)
                end
            end
        end
    end)
    
    -- لوب المهارات
    task.spawn(function()
        while true do
            task.wait(0.2)
            if not IsAlive() then continue end
            if not IsModuleActive() then continue end
            if FlyMode then continue end
            
            local target = GetCurrentTarget()
            
            if target and target.Character then
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
                if myHrp and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= 35 then
                    if not SkillBusy then
                        SkillBusy = true
                        pcall(function()
                            for _, slot in ipairs(HotbarKeys) do
                                if not IsAlive() then break end
                                if FlyMode then break end
                                if not IsModuleActive() then break end
                                TapKey(slot)
                                task.wait(0.05)
                                for _, skill in ipairs(SkillKeys) do
                                    if not IsAlive() then break end
                                    if FlyMode then break end
                                    if not IsModuleActive() then break end
                                    UseSkill(skill)
                                end
                                task.wait(0.05)
                            end
                        end)
                        SkillBusy = false
                    end
                end
            end
        end
    end)
    
    -- لوب القتال الرئيسي
    task.spawn(function()
        while true do
            task.wait()
            if not IsAlive() then 
                platform.CFrame = CFrame.new(0, -1000, 0)
                continue 
            end
            
            if not IsModuleActive() or FlyMode then
                platform.CFrame = CFrame.new(0, -1000, 0)
                task.wait(0.1)
                continue
            end
            
            local huntTarget = GetCurrentTarget()
            
            if huntTarget and huntTarget.Character then
                local enemy = huntTarget.Character
                local humanoid = enemy:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 and IsValidEnemy(huntTarget) then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        MoveToEnemy(enemy, hrp)
                        Attack(enemy)
                    end
                end
            else
                platform.CFrame = CFrame.new(0, -1000, 0)
            end
        end
    end)
    
    -- ==================================================
    -- دوال التحكم الأصلية (ثابتة تماماً للتوافق مع واجهتك)
    -- ==================================================
    function AutoHuntModule:SetEnabled(state)
        Enabled = state
        if state then
            KillNearest = false
            FlyMode = false  
            SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
        end
        if not state then
            if currentTween then pcall(function() currentTween:Cancel() end) end
            currentTween = nil
            platform.CFrame = CFrame.new(0, -1000, 0)
            FlyMode = false
            SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
        end
    end
    
    function AutoHuntModule:SetKillNearest(state)
        KillNearest = state
        if state then
            Enabled = false
            FlyMode = false
            SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
        end
        if not state then
            if currentTween then pcall(function() currentTween:Cancel() end) end
            currentTween = nil
            platform.CFrame = CFrame.new(0, -1000, 0)
        end
    end
    
    -- تم تعديلها لتقبل الاسم النصي من الـ Dropdown وتحوله للاعب حقيقي تلقائياً
    function AutoHuntModule:SetSelectedPlayer(playerOrName)
        local targetPlayer = nil
        
        if typeof(playerOrName) == "string" then
            targetPlayer = Players:FindFirstChild(playerOrName)
        elseif typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") then
            targetPlayer = playerOrName
        end

        if playerOrName == nil then
            SelectedPlayer = nil
            return
        end

        if targetPlayer and not IsValidEnemy(targetPlayer) then
            print("[ARAKS HUB] لا يمكن تحديد هذا اللاعب (صديق، نفس الفريق، أو حظر مناطق)")
            SelectedPlayer = nil
            return
        end
        
        SelectedPlayer = targetPlayer
        KillNearest = false
        if targetPlayer then
            FlyMode = false
            SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
        end
    end
    
    function AutoHuntModule:GetSelectedPlayer()
        return SelectedPlayer
    end
    
    function AutoHuntModule:GetState()
        return {
            Enabled = Enabled,
            KillNearest = KillNearest,
            SelectedPlayer = SelectedPlayer,
            FlyMode = FlyMode
        }
    end
    
    function AutoHuntModule:Stop()
        if currentTween then pcall(function() currentTween:Cancel() end) end
        currentTween = nil
        platform.CFrame = CFrame.new(0, -1000, 0)
        SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
        Enabled = false
        KillNearest = false
        FlyMode = false
        SelectedPlayer = nil
        SavedTarget = nil
    end
end

return AutoHuntModule
