function AutoHuntModule:SetEnabled(state)
    AutoHuntModule.Enabled = state
    if state then 
        AutoHuntModule.KillNearest = false 
        FlyMode = false
        SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
    else 
        self:Stop() 
    end
end

function AutoHuntModule:SetKillNearest(state)
    AutoHuntModule.KillNearest = state
    if state then 
        AutoHuntModule.Enabled = false 
        FlyMode = false
        SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
    else 
        self:Stop() 
    end
end

function AutoHuntModule:SetSelectedPlayer(player)
    if player == nil then
        AutoHuntModule.SelectedPlayer = nil
        self:Stop()
        return
    end
    
    AutoHuntModule.SelectedPlayer = player
    AutoHuntModule.KillNearest = false
    AutoHuntModule.Enabled = false 
    FlyMode = false
    SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
    
    print("[ARAKS] Target set to: " .. player.Name)
end

function AutoHuntModule:ResetAllHitboxes() self:Stop() end
function AutoHuntModule:GetSelectedPlayer() return AutoHuntModule.SelectedPlayer end

function AutoHuntModule:Stop()
    if currentTween then pcall(function() currentTween:Cancel() end) end
    if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
    if platformLoop then platformLoop:Disconnect(); platformLoop = nil end
    platform.CFrame = CFrame.new(0, -1000, 0)
    SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
    AutoHuntModule.Enabled = false
    AutoHuntModule.KillNearest = false
    FlyMode = false
    GlobalTargetPos = nil
end

return AutoHuntModule
