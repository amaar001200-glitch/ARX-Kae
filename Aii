-- ███ إعدادات نظام الطيران والهروب للسماء ███
-- ============================================================
local LOW_HEALTH_FLY = 5000
local SAFE_HEALTH_RETURN = 8000
local FlyMode = false
local SavedTarget = nil
local FlyPosition = nil

