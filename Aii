local AutoHuntModule = {}

AutoHuntModule.Enabled = false
AutoHuntModule.KillNearest = false
AutoHuntModule.SelectedPlayer = nil

-- إعدادات الـ Fast Attack المدمجة
AutoHuntModule.FastAttack = true
AutoHuntModule.FastAttackSpeed = 0.015 -- سرعة الضرب (Ultra Fast)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules.Net
local RegisterAttack = Net and Net["RE/RegisterAttack"]
local RegisterHit = Net and Net["RE/RegisterHit"]
local ShootGunEvent = Net and Net["RE/ShootGunEvent"]

local CombatController = nil
pcall(function()
    CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
end)

local EnemyBlockSize = 500 
local MyScaleSize = 500 
local TweenSpeed = 350 
local currentTween = nil
local GlobalTargetPos = nil
local GlobalTargetCFrame = nil
local CurrentSkillThread = nil 

local lastFastAttack = 0
local fastCombo = 0
local lastFastCombo = 0

local BlacklistedZones = {
    Vector3.new(-11.26, 19.31, 2827.25),
    Vector3.new(-10.01, 35.51, 2732.26),
    Vector3.new(-380.55, 73.05, 303.43),
    Vector3.new(-6471.88, 305.41, -4730.00),
    Vector3.new(-359.07, 20.64, 5535.89),
    Vector3.new(-111.14, 10.64, 5458.43),
    Vector3.new(-484.06, 10.64, 5345.74),
    Vector3.new(-5013.28, 314.55, -3006.84),
    Vector3.new(-12526.82, 336.94, -7491.79),
    Vector3.new(-16228.93, 9.09, 375.49)
}

local function IsInBlacklistedZone(targetPos)
    for _, zonePos in ipairs(BlacklistedZones) do
        if (targetPos - zonePos).Magnitude <= 120 then return true end
    end
    return false
end

local function IsValidEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    
    local pvpDisabled = false
    pcall(function() 
        pvpDisabled = plr:GetAttribute("PvpDisabled") or plr:GetAttribute("PvpEnable") == false
    end)
    if pvpDisabled then return false end 
    
    local char = plr.Character
    if not char then return false end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or not root then return false end
    if IsInBlacklistedZone(root.Position) then return false end
    
    local myTeam = LocalPlayer.Team
    local targetTeam = plr.Team
    if myTeam and myTeam.Name == "Pirates" then return true end
    if myTeam and myTeam.Name == "Marines" then
        if targetTeam and targetTeam.Name == "Pirates" then return true else return false end
    end
    return true
end

local platform = Instance.new("Part")
platform.Name = "ARAKS_Platform"
platform.Size = Vector3.new(35, 1, 35)
platform.Transparency = 0.5
platform.Material = Enum.Material.ForceField
platform.Color = Color3.fromRGB(255, 0, 255)
platform.Anchored = true
platform.CanCollide = true
platform.Parent = Workspace
platform.CFrame = CFrame.new(0, -1000, 0)

local function IsAlive()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
end

local function IsModuleActive()
    return AutoHuntModule.Enabled or AutoHuntModule.KillNearest or (AutoHuntModule.SelectedPlayer ~= nil)
end

local function TapKey(key)
    if not IsAlive() then return end
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function ScaleLocalPlayer(makeGiant)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    
    pcall(function()
        if makeGiant then
            if root then
                root.Size = Vector3.new(MyScaleSize, MyScaleSize, MyScaleSize)
                root.CanCollide = false
            end
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and part ~= root and not part:FindFirstChild("MyScaleMark") then
                    local m = Instance.new("BoolValue", part)
                    m.Name = "MyScaleMark"
                    part.Size = part.Size * 30 
                end
            end
        else
            if root then
                root.Size = Vector3.new(2, 2, 2)
                root.CanCollide = true
            end
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and part:FindFirstChild("MyScaleMark") then
                    part.MyScaleMark:Destroy()
                    part.Size = part.Size / 30
                end
            end
        end
    end)
end

local function ApplyHitboxSystem(plr)
    if not plr or not plr.Character or plr == LocalPlayer then return end
    local char = plr.Character
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if rootPart and humanoid and humanoid.Health > 0 then
        pcall(function()
            rootPart.Size = Vector3.new(EnemyBlockSize, EnemyBlockSize, EnemyBlockSize)
            rootPart.CanCollide = false
            rootPart.Transparency = 0.5
            rootPart.Color = Color3.fromRGB(255, 120, 0) 
            rootPart.Material = Enum.Material.Neon
            
            if CombatController and type(CombatController.runHitDetection) == "function" then
                CombatController.runHitDetection(char)
            end
        end)
    end
end

local function ResetHitbox(plr)
    if not plr or not plr.Character or plr == LocalPlayer then return end
    local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        pcall(function()
            rootPart.Size = Vector3.new(2, 2, 2)
            rootPart.CanCollide = true
            rootPart.Transparency = 0
            rootPart.Material = Enum.Plastic
        end)
    end
end

local function ResetAllServerHitboxes()
    ScaleLocalPlayer(false)
    for _, pl in ipairs(Players:GetPlayers()) do ResetHitbox(pl) end
end

-- ==================================================
-- دالة الـ FAST ATTACK المأخوذة والمطورة لتتخطى المسافة
-- ==================================================
local function DynamicFastAttack(targetChar)
    if not AutoHuntModule.FastAttack then return end
    if tick() - lastFastAttack < AutoHuntModule.FastAttackSpeed then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("Humanoid") or character.Humanoid.Health <= 0 then return end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end
    
    lastFastAttack = tick()
    if tick() - lastFastCombo > 0.4 then fastCombo = 0 end
    fastCombo = fastCombo + 1
    if fastCombo > 4 then fastCombo = 1 end
    lastFastCombo = tick()
    
    local toolTip = tool.ToolTip
    local enemyRoot = targetChar.HumanoidRootPart
    
    -- حل مشكلة السيوف والأساليب (Melee) لتضرب من أي مسافة وتفعل الهيت بوكس الكبير
    if toolTip == "Sword" or toolTip == "Melee" then
        if RegisterAttack and RegisterHit then
            RegisterAttack:FireServer(0)
            -- الحل الجذري: إرسال الريموت معدل بالكامل ومباشر إلى أجزاء الخصم لإجبار السيرفر على احتساب الضرر
            RegisterHit:FireServer(enemyRoot, {{targetChar, enemyRoot}}, "Melee", "")
            RegisterHit:FireServer(enemyRoot, {{targetChar, enemyRoot}}, "Sword", "")
        end
    -- حل كليكات الفواكه (Blox Fruit)
    elseif toolTip == "Blox Fruit" and tool:FindFirstChild("LeftClickRemote") then
        local dir = (enemyRoot.Position - character.HumanoidRootPart.Position).Unit
        tool.LeftClickRemote:FireServer(dir, fastCombo)
    -- حل المسدسات
    elseif toolTip == "Gun" then
        if ShootGunEvent then ShootGunEvent:FireServer(enemyRoot.Position) end
    end
end

local SkillKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}
local function FireTimedSkills(targetPlayer)
    if CurrentSkillThread then task.cancel(CurrentSkillThread) end

    CurrentSkillThread = task.spawn(function()
        while IsModuleActive() and IsAlive() and IsValidEnemy(targetPlayer) do
            TapKey(Enum.KeyCode.One)
            task.wait(0.15)
            
            local startTime1 = tick()
            while tick() - startTime1 < 6 do
                if not IsAlive() or not IsModuleActive() or not IsValidEnemy(targetPlayer) then return end
                for _, skill in ipairs(SkillKeys) do
                    TapKey(skill)
                    task.wait(0.2)
                end
                task.wait(0.1)
            end

            TapKey(Enum.KeyCode.Two)
            task.wait(0.15)
            
            local startTime2 = tick()
            while tick() - startTime2 < 4 do
                if not IsAlive() or not IsModuleActive() or not IsValidEnemy(targetPlayer) then return end
                for _, skill in ipairs(SkillKeys) do
                    TapKey(skill)
                    task.wait(0.2)
                end
                task.wait(0.1)
            end
            task.wait(0.05)
        end
    end)
end

local function SmoothMoveTo(targetChar, myHrp)
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end
    local enemyRoot = targetChar.HumanoidRootPart
    
    if IsInBlacklistedZone(enemyRoot.Position) then 
        if currentTween then currentTween:Cancel() end
        return 
    end

    local targetCFrame = enemyRoot.CFrame * CFrame.new(0, 55, 0)
    local distance = (targetCFrame.Position - myHrp.Position).Magnitude
    
    GlobalTargetPos = enemyRoot.Position
    GlobalTargetCFrame = enemyRoot.CFrame
    
    local platformLoop = RunService.Heartbeat:Connect(function()
        if myHrp and myHrp.Parent then
            platform.CFrame = CFrame.new(myHrp.Position.X, myHrp.Position.Y - 5, myHrp.Position.Z)
        end
    end)
    
    local duration = distance / TweenSpeed
    if currentTween then pcall(function() currentTween:Cancel() end) end
    
    currentTween = TweenService:Create(myHrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()
    currentTween.Completed:Wait()
    
    platformLoop:Disconnect()
    currentTween = nil
    
    myHrp.Velocity = Vector3.new(0,0,0)
end

-- اللوب الأساسي المشغل للـ Fast Attack والـ Hitbox
task.spawn(function()
    while true do
        RunService.Stepped:Wait()
        
        if not IsAlive() or not IsModuleActive() then
            platform.CFrame = CFrame.new(0, -1000, 0)
            GlobalTargetPos = nil
            GlobalTargetCFrame = nil
            if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
            continue
        end
        
        ScaleLocalPlayer(true)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local huntTarget = nil
        
        if myHrp then
            if AutoHuntModule.KillNearest then
                local enemies = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if IsValidEnemy(p) then table.insert(enemies, p) end
                end
                
                table.sort(enemies, function(a, b)
                    local distA = (a.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                    local distB = (b.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                    return distA < distB
                end)
                huntTarget = enemies[1]
            elseif AutoHuntModule.Enabled and AutoHuntModule.SelectedPlayer and IsValidEnemy(AutoHuntModule.SelectedPlayer) then
                huntTarget = AutoHuntModule.SelectedPlayer
            end
        end
        
        if huntTarget and myHrp then
            local enemy = huntTarget.Character
            local humanoid = enemy and enemy:FindFirstChild("Humanoid")
            
            if humanoid and humanoid.Health > 0 and IsValidEnemy(huntTarget) then
                ApplyHitboxSystem(huntTarget)
                SmoothMoveTo(enemy, myHrp)
                
                if (myHrp.Position - enemy.HumanoidRootPart.Position).Magnitude < 750 then
                    if not CurrentSkillThread then
                        FireTimedSkills(huntTarget)
                    end
                end
                
                -- تشغيل الفاست أتاك المطور مباشرة على الـ Character المستهدف
                DynamicFastAttack(enemy)
            else
                if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
            end
        else
            if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
        end
    end
end)

task.spawn(function()
    while true do
        if IsModuleActive() then
            ScaleLocalPlayer(true)
            for _, pl in ipairs(Players:GetPlayers()) do
                if IsValidEnemy(pl) then ApplyHitboxSystem(pl) end
            end
        end
        task.wait(0.5)
    end
end)

-- ==================================================
-- الـ REMOTE HOOK والتلاعب بالماوس لإصابة الهيت بوكس الكبير
-- ==================================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if IsModuleActive() and GlobalTargetPos and not checkcaller() then
        local remoteName = tostring(self.Name)
        
        -- التلاعب بريموت الـ RegisterHit ليعتبر كل ضربات الأساليب (Melee) قادمة من مسافة صفر ومصيبة للـ Hitbox الكبير
        if remoteName == "RE/RegisterHit" or remoteName == "RegisterHit" then
            if typeof(args[1]) == "Instance" and args[1]:IsA("BasePart") then
                -- إجبار السيرفر على قبول الـ Melee والـ Sword معاً وتخطي فحص البعد
                if args[3] == nil or args[3] == "" or args[3] == "Melee" then
                    args[3] = "Melee"
                end
                return oldNamecall(self, unpack(args))
            end
        end
        
        if method == "FireServer" or method == "InvokeServer" then
            local remoteLower = remoteName:lower()
            if not remoteLower:find("dash") and not remoteLower:find("move") and not remoteLower:find("teleport") then
                local changed = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = GlobalTargetPos
                        changed = true
                    elseif typeof(v) == "CFrame" then
                        args[i] = GlobalTargetCFrame or v
                        changed = true
                    end
                end
                if changed then return oldNamecall(self, unpack(args)) end
            end
        end
    end
    return oldNamecall(self, ...)
end)

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if IsModuleActive() and GlobalTargetPos and not checkcaller() then
        if self:IsA("Mouse") then
            if key == "Hit" then
                return GlobalTargetCFrame or CFrame.new(GlobalTargetPos)
            elseif key == "Target" then
                if AutoHuntModule.SelectedPlayer and AutoHuntModule.SelectedPlayer.Character then
                    return AutoHuntModule.SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
                end
            end
        end
    end
    return oldIndex(self, key)
end)

function AutoHuntModule:SetEnabled(state)
    AutoHuntModule.Enabled = state
    if state then AutoHuntModule.KillNearest = false else self:Stop() end
end

function AutoHuntModule:SetKillNearest(state)
    AutoHuntModule.KillNearest = state
    if state then AutoHuntModule.Enabled = false else self:Stop() end
end

function AutoHuntModule:SetSelectedPlayer(player)
    if player and not IsValidEnemy(player) then return end
    AutoHuntModule.SelectedPlayer = player
    AutoHuntModule.KillNearest = false
    if not player then self:Stop() end
end

function AutoHuntModule:ResetAllHitboxes() self:Stop() end
function AutoHuntModule:GetSelectedPlayer() return AutoHuntModule.SelectedPlayer end

function AutoHuntModule:Stop()
    if currentTween then currentTween:Cancel() end
    if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
    platform.CFrame = CFrame.new(0, -1000, 0)
    AutoHuntModule.Enabled = false
    AutoHuntModule.KillNearest = false
    AutoHuntModule.SelectedPlayer = nil
    GlobalTargetPos = nil
    GlobalTargetCFrame = nil
    ResetAllServerHitboxes()
end

return AutoHuntModule
