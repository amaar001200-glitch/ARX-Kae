local BlacklistedZones = {
    Vector3.new(-11.26, 19.31, 2827.25),
    Vector3.new(-10.01, 35.51, 2732.26),
    Vector3.new(-380.55, 73.05, 303.43),
    Vector3.new(-6471.88, 305.41, -4730.00),
    Vector3.new(-359.07, 20.64, 5535.89),
    Vector3.new(-111.14, 10.64, 5458.43),
    Vector3.new(-484.06, 10.64, 5345.74),
    Vector3.new(-5013.28, 314.55, -3006.84),
    Vector3.new(-12526.82, 336.94, -7491.79),
    Vector3.new(-16228.93, 9.09, 375.49)
}

local function IsInBlacklistedZone(targetPos)
    if not targetPos then return true end
    for _, zonePos in ipairs(BlacklistedZones) do
        if (targetPos - zonePos).Magnitude <= 150 then return true end 
    end
    return false
end

local function GetPlayerState(plr)
    if not plr or plr == LocalPlayer then
        return "OFF"
    end
    
    local pvpDisabled = false
    pcall(function()
        pvpDisabled = plr:GetAttribute("PvpDisabled") or plr:GetAttribute("PvpEnable") == false
    end)
    
    if pvpDisabled then
        return "OFF"
    end
    
    local char = plr.Character
    if char then
        local inCombat = false
        pcall(function()
            inCombat = char:GetAttribute("InCombat")
        end)
        
        if inCombat then
            FightCache[plr] = tick()
        end
    end
    
    if FightCache[plr] and (tick() - FightCache[plr]) <= 12 then
        return "FIGHT"
    end
    
    return "ON"
end

local function IsValidEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    if not plr:IsA("Player") then return false end
    
    local char = plr.Character
    if not char then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    if IsInBlacklistedZone(hrp.Position) then
        return false
    end
    
    local myTeam = LocalPlayer.Team
    local targetTeam = plr.Team
    local state = GetPlayerState(plr)
    
    if state == "OFF" then return false end
    
    if AutoHuntModule.SelectedPlayer and AutoHuntModule.SelectedPlayer == plr then
        return state == "ON" or state == "FIGHT"
    end
    
    if myTeam and myTeam.Name == "Pirates" then
        return state == "ON" or state == "FIGHT"
    end
    
    if myTeam and myTeam.Name == "Marines" then
        if targetTeam and targetTeam.Name == "Marines" then
            return false
        end
        
        if (targetTeam and targetTeam.Name == "Pirates") or state == "FIGHT" then
            return true
        end
        
        if not targetTeam or targetTeam.Name ~= "Marines" then
            return state == "ON"
        end
    end
    
    return false
end

local platform = Instance.new("Part")
platform.Name = "ARAKS_Platform"
platform.Size = Vector3.new(35, 1, 35)
platform.Transparency = 0.5
platform.Material = Enum.Material.ForceField
platform.Color = Color3.fromRGB(255, 0, 255)
platform.Anchored = true
platform.CanCollide = true
platform.Parent = workspace
platform.CFrame = CFrame.new(0, -1000, 0)

local function IsAlive()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
end

local function GetMyHealth()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    return hum and hum.Health or 0
end

local function IsModuleActive()
    return AutoHuntModule.Enabled or AutoHuntModule.KillNearest or (AutoHuntModule.SelectedPlayer ~= nil)
end

local function TapKey(key)
    if not IsAlive() then return end
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.03) 
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function Attack(target)
    if not target or not target:FindFirstChild("HumanoidRootPart") then return end
    if RegisterAttack and RegisterHit then
        pcall(function()
            RegisterAttack:FireServer(0.5)
            RegisterHit:FireServer(target.HumanoidRootPart, {}, nil, "")
            
            if tick() - lastHitTick > 0.12 then
                lastHitTick = tick()
                RegisterHit:FireServer(target.HumanoidRootPart, {{target, target.HumanoidRootPart}})
                RegisterHit:FireServer(target.HumanoidRootPart, {}, "Melee", "")
            end
        end)
    end
end

-- ============================================================
-- ███ دوال تحريك الطيران والنزول للأرض ███
-- ============================================================
local function FlyToSky()
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    FlyPosition = myHrp.Position + Vector3.new(0, 7000, 0)
    SkyPlatform.CFrame = CFrame.new(FlyPosition.X, FlyPosition.Y - 3, FlyPosition.Z)
    
    if currentTween then pcall(function() currentTween:Cancel() end) end
    myHrp.CFrame = CFrame.new(FlyPosition)
    myHrp.Velocity = Vector3.zero
    platform.CFrame = CFrame.new(0, -1000, 0)
end

local function ReturnToGround(target)
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    local targetHrp = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if targetHrp then
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 12, 0)
    end
    myHrp.Velocity = Vector3.zero
    SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
end

local SkillKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}
local function FireTimedSkills(targetPlayer)
    if CurrentSkillThread then task.cancel(CurrentSkillThread) end

    CurrentSkillThread = task.spawn(function()
        while IsModuleActive() and IsAlive() and IsValidEnemy(targetPlayer) and not FlyMode do
            
            TapKey(Enum.KeyCode.One)
            task.wait(0.05) 
            
            local startTime1 = tick()
            while tick() - startTime1 < 6 do 
                if not IsAlive() or not IsModuleActive() or not IsValidEnemy(targetPlayer) or FlyMode then return end
                for _, skill in ipairs(SkillKeys) do
                    TapKey(skill)
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end) end
                    task.wait(0.1) 
                end
                task.wait(0.05)
            end

            TapKey(Enum.KeyCode.Two)
            task.wait(0.05)
            
            local startTime2 = tick()
            while tick() - startTime2 < 4 do
                if not IsAlive() or not IsModuleActive() or not IsValidEnemy(targetPlayer) or FlyMode then return end
                for _, skill in ipairs(SkillKeys) do
                    TapKey(skill)
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end) end
                    task.wait(0.1)
                end
                task.wait(0.05)
            end
            task.wait(0.02)
        end
    end)
end

local function SmoothMoveTo(targetChar, myHrp)
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end
    local enemyRoot = targetChar.HumanoidRootPart
    
    if IsInBlacklistedZone(enemyRoot.Position) then 
        if currentTween then currentTween:Cancel() end
        return 
    end

    local targetCFrame = enemyRoot.CFrame * CFrame.new(0, 12, 0)
    local distance = (targetCFrame.Position - myHrp.Position).Magnitude
    
    GlobalTargetPos = enemyRoot.Position
    
    if platformLoop then platformLoop:Disconnect() end
    platformLoop = RunService.Heartbeat:Connect(function()
        if myHrp and myHrp.Parent and not FlyMode then
            platform.CFrame = CFrame.new(myHrp.Position.X, myHrp.Position.Y - 3.5, myHrp.Position.Z)
        end
    end)
    
    local duration = distance / TweenSpeed
    if currentTween then pcall(function() currentTween:Cancel() end) end
    
    currentTween = TweenService:Create(myHrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()
    currentTween.Completed:Wait()
    
    if platformLoop then platformLoop:Disconnect(); platformLoop = nil end
    currentTween = nil
    
    myHrp.Velocity = Vector3.new(0,0,0)
end

-- ============================================================
-- ███ لوب مراقبة الدم والطيران المستقل ███
-- ============================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        
        if not IsModuleActive() or not IsAlive() then
            if FlyMode then
                FlyMode = false
                SkyPlatform.CFrame = CFrame.new(0, -1000, 0)
            end
            continue
        end
        
        local myHealth = GetMyHealth()
        
        -- حالة انخفاض الدم (الهروب)
        if myHealth <= LOW_HEALTH_FLY and not FlyMode then
            FlyMode = true
            if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
            FlyToSky()
        end
        
        -- حالة العودة (امتلاء الدم)
        if FlyMode and myHealth >= SAFE_HEALTH_RETURN then
            FlyMode = false
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                local currentTarget = nil
                if AutoHuntModule.SelectedPlayer and IsValidEnemy(AutoHuntModule.SelectedPlayer) then
                    currentTarget = AutoHuntModule.SelectedPlayer
                end
                ReturnToGround(currentTarget)
            end
        end
        
        -- التثبيت الصارم بالسماء
        if FlyMode then
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHrp and FlyPosition then
                myHrp.CFrame = CFrame.new(FlyPosition)
                myHrp.Velocity = Vector3.zero
                SkyPlatform.CFrame = CFrame.new(FlyPosition.X, FlyPosition.Y - 3, FlyPosition.Z)
            end
        end
    end
end)

-- ============================================================
-- ███ اللوب الأساسي للقتال والملاحقة ███
-- ============================================================
task.spawn(function()
    while true do
        task.wait()
        
        if not IsAlive() or not IsModuleActive() or FlyMode then
            if not FlyMode then platform.CFrame = CFrame.new(0, -1000, 0) end
            GlobalTargetPos = nil
            if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
            if platformLoop then platformLoop:Disconnect(); platformLoop = nil end
            task.wait(0.2)
            continue
        end
        
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local huntTarget = nil
        
        if myHrp then
            if AutoHuntModule.SelectedPlayer and IsValidEnemy(AutoHuntModule.SelectedPlayer) then
                huntTarget = AutoHuntModule.SelectedPlayer
            elseif AutoHuntModule.KillNearest then
                local enemies = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if IsValidEnemy(p) then 
                        table.insert(enemies, p) 
                    end
                end
                
                table.sort(enemies, function(a, b)
                    local distA = (a.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                    local distB = (b.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                    return distA < distB
                end)
                huntTarget = enemies[1]
            elseif AutoHuntModule.Enabled and AutoHuntModule.SelectedPlayer and IsValidEnemy(AutoHuntModule.SelectedPlayer) then
                huntTarget = AutoHuntModule.SelectedPlayer
            end
        end
        
        if huntTarget and myHrp then
            local enemy = huntTarget.Character
            local humanoid = enemy and enemy:FindFirstChild("Humanoid")
            
            if humanoid and humanoid.Health > 0 and IsValidEnemy(huntTarget) and not IsInBlacklistedZone(enemy.HumanoidRootPart.Position) then
                SmoothMoveTo(enemy, myHrp)
                
                if (myHrp.Position - enemy.HumanoidRootPart.Position).Magnitude < 750 then
                    if not CurrentSkillThread then
                        FireTimedSkills(huntTarget)
                    end
                end
                
                Attack(enemy)
                task.wait(0.12) 
            else
                if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
            end
        else
            if CurrentSkillThread then task.cancel(CurrentSkillThread); CurrentSkillThread = nil end
        end
    end
end)

-- REMOTE HOOK
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if IsModuleActive() and GlobalTargetPos and not checkcaller() then
        if method == "FireServer" or method == "InvokeServer" then
            local remoteName = tostring(self.Name):lower()
            if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") then
                local changed = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = GlobalTargetPos
                        changed = true
                    end
                end
                if changed then return oldNamecall(self, unpack(args)) end
            end
        end
    end
    return oldNamecall(self, ...)
end)

