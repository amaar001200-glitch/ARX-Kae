-- █ ARAKS HUB | AUTO HUNT MODULE (TIMED SLOTS + BALANCED SKILLS + GIANT CHARACTER MESH)
-- version 1.9 (Fixed: Slot1 12s + Slot2 6s + Slow Skills + Full Enemy Character Scaling)

local AutoHuntModule = {}

-- بيانات التشغيل الأساسية
AutoHuntModule.Enabled = false
AutoHuntModule.KillNearest = false
AutoHuntModule.SelectedPlayer = nil

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Remotes
local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules.Net
local RegisterAttack = Net and Net["RE/RegisterAttack"]
local RegisterHit = Net and Net["RE/RegisterHit"]

-- موديول الضربات الفعلي
local CombatController = nil
pcall(function()
    CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
end)

local TargetScaleSize = 15 -- حجم التكبير المجسم لجسم اللاعب الخصم
local TweenSpeed = 320 
local currentTween = nil
local GlobalTargetPos = nil

-- نظام تصفية الفرق (قراصنة ضد الكل / بحرية ضد قراصنة)
local function IsValidEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    if not plr:IsA("Player") then return false end
    
    local char = plr.Character
    if not char then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    local myTeam = LocalPlayer.Team
    local targetTeam = plr.Team
    
    if myTeam and myTeam.Name == "Pirates" then
        return true
    end
    
    if myTeam and myTeam.Name == "Marines" then
        if targetTeam and targetTeam.Name == "Pirates" then
            return true
        else
            return false
        end
    end
    
    return true
end

-- المنصة الأمنية لمنع السقوط
local platform = Instance.new("Part")
platform.Name = "ARAKS_Platform"
platform.Size = Vector3.new(15, 1, 15)
platform.Transparency = 0.5
platform.Material = Enum.Material.ForceField
platform.Color = Color3.fromRGB(165, 0, 255)
platform.Anchored = true
platform.CanCollide = true
platform.Parent = workspace
platform.CFrame = CFrame.new(0, -1000, 0)

local function IsAlive()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
end

local function IsModuleActive()
    return AutoHuntModule.Enabled or AutoHuntModule.KillNearest or (AutoHuntModule.SelectedPlayer ~= nil)
end

local function TapKey(key)
    if not IsAlive() then return end
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.05) 
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

-- ==================================================
-- نظام تكبير مظهر وجسم اللاعب الخصم ليكون عملاقاً ومجسماً وواضحاً
-- ==================================================
local function ApplyHitboxSystem(plr)
    if not plr or not plr.Character or plr == LocalPlayer then return end
    local char = plr.Character
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if humanoid and humanoid.Health > 0 then
        pcall(function()
            -- تكبير أجزاء الجسم الأساسية لجعل اللاعب مجسم ضخم وواضح جداً بدل المربع البنفسجي
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") and (part.Name:find("Torso") or part.Name:find("Leg") or part.Name:find("Arm") or part.Name == "Head" or part.Name == "HumanoidRootPart") then
                    part.CanCollide = false
                    if part.Name == "HumanoidRootPart" then
                        part.Size = Vector3.new(TargetScaleSize, TargetScaleSize, TargetScaleSize)
                        part.Transparency = 0.7
                    else
                        -- تكبير مجسم واضح ومظهري للأطراف والجسم
                        if not part:FindFirstChild("AraksScaled") then
                            local mark = Instance.new("BoolValue", part)
                            mark.Name = "AraksScaled"
                            part.Size = part.Size * 4 -- تكبير حجم الأطراف المرئية ليصبح عملاقاً وواضحاً
                        end
                    end
                end
            end
            
            if CombatController and type(CombatController.runHitDetection) == "function" then
                CombatController.runHitDetection(char)
            end
        end)
    end
end

-- إرجاع مجسم اللاعب لحجمه الطبيعي فوراً عند الإطفاء
local function ResetHitbox(plr)
    if not plr or not plr.Character or plr == LocalPlayer then return end
    local char = plr.Character
    pcall(function()
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                if part.Name == "HumanoidRootPart" then
                    part.Size = Vector3.new(2, 2, 2)
                    part.Transparency = 0
                elseif part:FindFirstChild("AraksScaled") then
                    part.AraksScaled:Destroy()
                    part.Size = part.Size / 4
                end
                part.CanCollide = true
            end
        end
    end)
end

local function ResetAllServerHitboxes()
    for _, pl in ipairs(Players:GetPlayers()) do
        ResetHitbox(pl)
    end
end

local function GetAllEnemies()
    local enemies = {}
    for _, p in pairs(Players:GetPlayers()) do
        if IsValidEnemy(p) then table.insert(enemies, p) end
    end
    return enemies
end

local function Attack(target)
    if not target or not target:FindFirstChild("HumanoidRootPart") then return end
    if RegisterAttack and RegisterHit then
        pcall(function()
            RegisterAttack:FireServer(0.5)
            RegisterHit:FireServer(target.HumanoidRootPart, {}, nil, "")
        end)
    end
end

-- مفاتيح المهارات
local SkillKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}

-- ==================================================
-- نظام المهارات الذكي والموقوت لتبديل الأسلحة (سلوت 1 = 12ث | سلوت 2 = 6ث)
-- ==================================================
local function FireTimedSkills()
    task.spawn(function()
        if not IsAlive() or not IsModuleActive() then return end

        -- 1️⃣ السلاح الأول: يثبت عليه لمدة 12 ثانية ويجلد بالمهارات هادئ
        TapKey(Enum.KeyCode.One)
        local startTime1 = tick()
        while tick() - startTime1 < 12 do
            if not IsAlive() or not IsModuleActive() then return end
            for _, skill in ipairs(SkillKeys) do
                if not IsAlive() or not IsModuleActive() then return end
                TapKey(skill)
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
                task.wait(0.6) -- تهدئة وتبطئة الضرب ليكون موزوناً
            end
            task.wait(0.5)
        end

        -- 2️⃣ السلاح الثاني: ينتقل له ويثبت عليه لمدة 6 ثوانٍ كاملة
        TapKey(Enum.KeyCode.Two)
        local startTime2 = tick()
        while tick() - startTime2 < 6 do
            if not IsAlive() or not IsModuleActive() then return end
            for _, skill in ipairs(SkillKeys) do
                if not IsAlive() or not IsModuleActive() then return end
                TapKey(skill)
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
                task.wait(0.6) -- تباطؤ متزن وممتاز لحساب الضرر
            end
            task.wait(0.5)
        end

        -- 3️⃣ باقي الأسلحة (السلوت 3 و 4): يمر عليها بشكل عادي وسلس
        for _, slot in ipairs({Enum.KeyCode.Three, Enum.KeyCode.Four}) do
            if not IsAlive() or not IsModuleActive() then return end
            TapKey(slot)
            task.wait(0.4)
            for _, skill in ipairs(SkillKeys) do
                if not IsAlive() or not IsModuleActive() then return end
                TapKey(skill)
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
                task.wait(0.6)
            end
        end
    end)
end

-- حركة تدريجية ناعمة ومحمية
local function SmoothMoveTo(targetChar, myHrp)
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return end
    
    local enemyRoot = targetChar.HumanoidRootPart
    local targetCFrame = enemyRoot.CFrame * CFrame.new(0, 6, 0)
    local distance = (targetCFrame.Position - myHrp.Position).Magnitude
    
    GlobalTargetPos = enemyRoot.Position
    
    local platformLoop = RunService.Heartbeat:Connect(function()
        if myHrp and myHrp.Parent then
            platform.CFrame = CFrame.new(myHrp.Position.X, myHrp.Position.Y - 3.5, myHrp.Position.Z)
        end
    end)
    
    local duration = distance / TweenSpeed
    if currentTween then pcall(function() currentTween:Cancel() end) end
    
    currentTween = TweenService:Create(myHrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()
    currentTween.Completed:Wait()
    
    platformLoop:Disconnect()
    currentTween = nil
    
    myHrp.Velocity = Vector3.new(0,0,0)
    myHrp.RotVelocity = Vector3.new(0,0,0)
end

-- ==================================================
-- اللوب الرئيسي للجلد: يركز على الخصم حتى يموت تماماً
-- ==================================================
task.spawn(function()
    while true do
        task.wait()
        
        if not IsAlive() then 
            platform.CFrame = CFrame.new(0, -1000, 0)
            GlobalTargetPos = nil
            continue 
        end
        
        if not IsModuleActive() then
            platform.CFrame = CFrame.new(0, -1000, 0)
            GlobalTargetPos = nil
            task.wait(0.2)
            continue
        end
        
        local targets = {}
        if AutoHuntModule.KillNearest then
            targets = GetAllEnemies()
        elseif AutoHuntModule.Enabled and AutoHuntModule.SelectedPlayer and IsValidEnemy(AutoHuntModule.SelectedPlayer) then
            table.insert(targets, AutoHuntModule.SelectedPlayer)
        end
        
        if #targets > 0 then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, huntTarget in ipairs(targets) do
                    while IsModuleActive() and IsAlive() and IsValidEnemy(huntTarget) do
                        local enemy = huntTarget.Character
                        local humanoid = enemy and enemy:FindFirstChild("Humanoid")
                        
                        if humanoid and humanoid.Health > 0 then
                            ApplyHitboxSystem(huntTarget)
                            SmoothMoveTo(enemy, hrp)
                            FireTimedSkills() -- استدعاء نظام تبديل الأسلحة الموقوت والمهارات الموزونة
                            Attack(enemy)
                            task.wait(0.2) 
                        else
                            break 
                        end
                    end
                    if not IsModuleActive() or not IsAlive() then break end
                end
            end
        else
            platform.CFrame = CFrame.new(0, -1000, 0)
            GlobalTargetPos = nil
        end
    end
end)

-- ==================================================
-- لوب الهيت بوكس المجسم: يكبر الخصوم كلاعبين عمالقة عند التشغيل فقط
-- ==================================================
task.spawn(function()
    while true do
        if IsModuleActive() then
            for _, pl in ipairs(Players:GetPlayers()) do
                if IsValidEnemy(pl) then 
                    ApplyHitboxSystem(pl) 
                end
            end
        end
        task.wait(0.6)
    end
end)

-- ==================================================
-- REMOTE HOOK (تأمين وتوجيه المقذوفات والمهارات)
-- ==================================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if IsModuleActive() and GlobalTargetPos and not checkcaller() then
        if method == "FireServer" or method == "InvokeServer" then
            local remoteName = tostring(self.Name):lower()
            if not remoteName:find("dash") and not remoteName:find("move") and not remoteName:find("teleport") then
                local changed = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = GlobalTargetPos
                        changed = true
                    end
                end
                if changed then return oldNamecall(self, unpack(args)) end
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- ==================================================
-- دوال التحكم الخارجية للواجهة لضمان الإطفاء الفوري والكامل
-- ==================================================
function AutoHuntModule:SetEnabled(state)
    AutoHuntModule.Enabled = state
    if state then 
        AutoHuntModule.KillNearest = false 
    else
        if currentTween then currentTween:Cancel() end
        platform.CFrame = CFrame.new(0, -1000, 0) 
        GlobalTargetPos = nil
        ResetAllServerHitboxes()
    end
end

function AutoHuntModule:SetKillNearest(state)
    AutoHuntModule.KillNearest = state
    if state then 
        AutoHuntModule.Enabled = false 
    else
        if currentTween then currentTween:Cancel() end
        platform.CFrame = CFrame.new(0, -1000, 0) 
        GlobalTargetPos = nil
        ResetAllServerHitboxes()
    end
end

function AutoHuntModule:SetSelectedPlayer(player)
    if player and not IsValidEnemy(player) then return end
    AutoHuntModule.SelectedPlayer = player
    AutoHuntModule.KillNearest = false
    if not player then
        ResetAllServerHitboxes()
    end
end

function AutoHuntModule:ResetAllHitboxes()
    ResetAllServerHitboxes()
end

function AutoHuntModule:GetSelectedPlayer() 
    return AutoHuntModule.SelectedPlayer 
end

function AutoHuntModule:GetState()
    return {
        Enabled = AutoHuntModule.Enabled, 
        KillNearest = AutoHuntModule.KillNearest, 
        SelectedPlayer = AutoHuntModule.SelectedPlayer
    }
end

function AutoHuntModule:Stop()
    if currentTween then currentTween:Cancel() end
    platform.CFrame = CFrame.new(0, -1000, 0)
    AutoHuntModule.Enabled = false
    AutoHuntModule.KillNearest = false
    AutoHuntModule.SelectedPlayer = nil
    GlobalTargetPos = nil
    ResetAllServerHitboxes()
end

return AutoHuntModule
