-- [[ Blox Fruits - HITBOX ON EVERYTHING (Except Real Players) ]] --

local PlayersService = game:GetService("Players")
local ReplicatedStorageService = game:GetService("ReplicatedStorage")
local LocalPlayerService = PlayersService.LocalPlayer
local RunServiceService = game:GetService("RunService")

-- إعدادات المربع
local HitboxData = {
    BoxSize = Vector3.new(40, 40, 40),
    BoxAlpha = 0.5,
    BorderColor = Color3.fromRGB(0, 0, 0),
    BodyColor = Color3.fromRGB(128, 0, 255)
}

-- جلب الريموت
local HitRegisterRemote = nil
pcall(function()
    HitRegisterRemote = ReplicatedStorageService:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit")
end)

-- حالة التشغيل
local IsHitboxActive = false
local TrackedObjects = {}

-- دالة إضافة الإطار المرئي
local function AddVisualFrame(rootPart)
    for _, child in pairs(rootPart:GetChildren()) do
        if child:IsA("SelectionBox") and child.Name == "HitboxFrame" then
            child:Destroy()
        end
    end

    local visualFrame = Instance.new("SelectionBox")
    visualFrame.Name = "HitboxFrame"
    visualFrame.Adornee = rootPart
    visualFrame.Color3 = HitboxData.BorderColor
    visualFrame.LineThickness = 0.15
    visualFrame.Transparency = 0
    visualFrame.SurfaceColor3 = HitboxData.BodyColor
    visualFrame.SurfaceTransparency = 0.7
    visualFrame.Parent = rootPart
end

-- دالة تطبيق المربع
local function ApplyToObject(object)
    if not IsHitboxActive then return end
    if not object then return end

    -- استبعاد اللاعب الحقيقي فقط
    local isRealPlayer = false
    for _, player in pairs(PlayersService:GetPlayers()) do
        if player.Character == object then
            isRealPlayer = true
            break
        end
    end
    
    -- إذا كان لاعب حقيقي، لا نطبق عليه
    if isRealPlayer then return end

    local objectRoot = object:FindFirstChild("HumanoidRootPart")
    local objectHumanoid = object:FindFirstChildOfClass("Humanoid")

    if objectRoot and objectHumanoid and objectHumanoid.Health > 0 then
        pcall(function()
            objectRoot.Size = HitboxData.BoxSize
            objectRoot.CanCollide = false
            objectRoot.Transparency = HitboxData.BoxAlpha
            objectRoot.Color = HitboxData.BodyColor
            objectRoot.Material = Enum.Material.ForceField
            AddVisualFrame(objectRoot)
        end)

        if not TrackedObjects[object] then
            TrackedObjects[object] = true

            local sizeChangeConnection = nil
            sizeChangeConnection = objectRoot:GetPropertyChangedSignal("Size"):Connect(function()
                if IsHitboxActive and objectRoot and objectRoot.Parent then
                    pcall(function()
                        if objectRoot.Size ~= HitboxData.BoxSize then
                            objectRoot.Size = HitboxData.BoxSize
                            AddVisualFrame(objectRoot)
                        end
                    end)
                end
            end)

            object.AncestryChanged:Connect(function()
                if not object.Parent then
                    TrackedObjects[object] = nil
                    if sizeChangeConnection then sizeChangeConnection:Disconnect() end
                end
            end)

            objectRoot.Touched:Connect(function(hit)
                if hit.Parent and hit.Parent:IsA("Tool") and hit.Parent.Parent == LocalPlayerService.Character then
                    if HitRegisterRemote then
                        pcall(function()
                            HitRegisterRemote:FireServer(objectRoot, {}, nil, "747c0deb")
                        end)
                    end
                end
            end)
        end
    end
end

-- مسح جميع التعديلات
local function ClearAllModifications()
    for obj, _ in pairs(TrackedObjects) do
        pcall(function()
            if obj and obj.Parent then
                local objectRoot = obj:FindFirstChild("HumanoidRootPart")
                if objectRoot then
                    for _, child in pairs(objectRoot:GetChildren()) do
                        if child:IsA("SelectionBox") and child.Name == "HitboxFrame" then
                            child:Destroy()
                        end
                    end
                    objectRoot.Size = Vector3.new(2, 2, 1)
                    objectRoot.Transparency = 0
                    objectRoot.Color = Color3.fromRGB(255, 255, 255)
                    objectRoot.Material = Enum.Material.Plastic
                end
            end
        end)
    end
    TrackedObjects = {}
end

-- الحلقة الرئيسية (تفحص جميع الكائنات في workspace)
local DetectionLoop = nil
local function StartLoop()
    if DetectionLoop then return end
    DetectionLoop = RunServiceService.Heartbeat:Connect(function()
        if IsHitboxActive then
            for _, gameObject in pairs(workspace:GetChildren()) do
                if gameObject:IsA("Model") and gameObject:FindFirstChild("HumanoidRootPart") and gameObject:FindFirstChildOfClass("Humanoid") then
                    ApplyToObject(gameObject)
                end
            end
        end
    end)
end

StartLoop()

-- API للتحكم من الواجهة الرئيسية
local HitboxController = {}

function HitboxController:SetEnabled(State)
    IsHitboxActive = State
    if not State then
        ClearAllModifications()
    end
    print("[Hitbox] State:", State)
end

function HitboxController:SetSize(SizeValue)
    HitboxData.BoxSize = Vector3.new(SizeValue, SizeValue, SizeValue)
    if IsHitboxActive then
        for obj, _ in pairs(TrackedObjects) do
            TrackedObjects[obj] = nil
        end
        print("[Hitbox] Size:", SizeValue)
    end
end

function HitboxController:IsEnabled()
    return IsHitboxActive
end

function HitboxController:GetSize()
    return HitboxData.BoxSize.X
end

return HitboxController
