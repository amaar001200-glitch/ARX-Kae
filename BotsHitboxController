-- [[ Blox Fruits - Custom Hitbox Visualizer & Combat Script ]] --

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- إعدادات الـ Hitbox (يمكنك التعديل عليها حسب رغبتك)
local Settings = {
    HitboxSize = Vector3.new(20, 20, 20), -- حجم المربع (كلما زاد، زادت مسافة الضرب)
    HitboxTransparency = 0.6,             -- شفافية المربع (0 مرئي بالكامل، 1 مخفي)
    HitboxColor = Color3.fromRGB(255, 0, 0), -- لون المربع (أحمر)
    KillAuraEnabled = true                 -- تفعيل الضرب التلقائي عند لمس المربع
}

-- استدعاء دوال اللعبة الأساسية التي تم تحديدها في الملفات
local CombatController = nil
local WeaponToolShared = nil

pcall(function()
    -- محاولة جلب وحدات التحكم بالقتال والأسلحة من الـ ReplicatedStorage
    CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    WeaponToolShared = require(ReplicatedStorage:WaitForChild("SharedComponents"):WaitForChild("WeaponToolShared"))
end)

-- وظيفة تعديل وتكبير الـ Hitbox للخصم
local function modifyHitbox(character)
    if character and character.Name ~= LocalPlayer.Name then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            -- 1. تكبير حجم صندوق التصادم الأساسي (RootPart)
            rootPart.Size = Settings.HitboxSize
            rootPart.CanCollide = false -- لمنع حدوث مشاكل في الحركة أو التعثر بالخصم
            
            -- 2. تلوين المربع وتوضيحه برمجياً (Visualizer)
            rootPart.Transparency = Settings.HitboxTransparency
            rootPart.Color = Settings.HitboxColor
            rootPart.Material = Enum.Material.ForceField -- تأثير متوهج مميز
            
            -- 3. تفعيل الضرب التلقائي (Kill Aura) إذا تم تفعيل الخيار وث ثبات الـ Hit Detection
            if Settings.KillAuraEnabled and CombatController and type(CombatController.runHitDetection) == "function" then
                -- محاكاة دالة كشف الضربات الخاصة باللعبة لتسجيل ضرر تلقائي
                task.spawn(function()
                    pcall(function()
                        CombatController.runHitDetection(character)
                    end)
                end)
            end
        end
    end
end

-- حلقة تكرارية مستمرة لفحص جميع الأعداء واللاعبين وتطبيق السكربت عليهم
RunService.RenderStepped:Connect(function()
    -- الفحص أولاً في مجلدات الأعداء المخصصة باللعبة (Enemies / Characters)
    local enemyFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Characters")
    
    if enemyFolder then
        for _, enemy in pairs(enemyFolder:GetChildren()) do
            modifyHitbox(enemy)
        end
    else
        -- في حال عدم وجود مجلد مخصص، يتم التطبيق على مجلد اللاعبين العام
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character then
                modifyHitbox(player.Character)
            end
        end
    end
end)

print("[+] تم تحميل سكربت الـ Hitbox بنجاح واستغلال ملفات القتال!")
