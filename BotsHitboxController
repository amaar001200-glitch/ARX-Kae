-- [[ Blox Fruits - Custom Hitbox Visualizer & Combat Script ]] --

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- إعدادات الـ Hitbox
local Settings = {
    HitboxSize = Vector3.new(40, 40, 40),
    HitboxTransparency = 0.6,
    HitboxColor = Color3.fromRGB(255, 0, 0),
    KillAuraEnabled = true
}

-- استدعاء دوال اللعبة الأساسية
local CombatController = nil
local WeaponToolShared = nil

pcall(function()
    CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    WeaponToolShared = require(ReplicatedStorage:WaitForChild("SharedComponents"):WaitForChild("WeaponToolShared"))
end)

-- حالة التشغيل
local IsActive = true
local RenderConnection = nil

-- وظيفة تعديل وتكبير الـ Hitbox للخصم
local function modifyHitbox(character)
    if not IsActive then return end
    if character and character.Name ~= LocalPlayer.Name then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.Health > 0 then
            pcall(function()
                rootPart.Size = Settings.HitboxSize
                rootPart.CanCollide = false
                rootPart.Transparency = Settings.HitboxTransparency
                rootPart.Color = Settings.HitboxColor
                rootPart.Material = Enum.Material.ForceField
                
                if Settings.KillAuraEnabled and CombatController and type(CombatController.runHitDetection) == "function" then
                    task.spawn(function()
                        pcall(function()
                            CombatController.runHitDetection(character)
                        end)
                    end)
                end
            end)
        end
    end
end

-- الحلقة الرئيسية
local function startLoop()
    if RenderConnection then return end
    RenderConnection = RunService.RenderStepped:Connect(function()
        if not IsActive then return end
        local enemyFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Characters")
        
        if enemyFolder then
            for _, enemy in pairs(enemyFolder:GetChildren()) do
                modifyHitbox(enemy)
            end
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character then
                    modifyHitbox(player.Character)
                end
            end
        end
    end)
end

-- دالة إيقاف الحلقة ومسح التعديلات
local function stopLoopAndClear()
    if RenderConnection then
        RenderConnection:Disconnect()
        RenderConnection = nil
    end
    
    -- إعادة حجم البوتات إلى الطبيعي
    local enemyFolder = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("Characters")
    if enemyFolder then
        for _, enemy in pairs(enemyFolder:GetChildren()) do
            pcall(function()
                local rootPart = enemy:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    rootPart.Size = Vector3.new(2, 2, 1)
                    rootPart.Transparency = 0
                    rootPart.Color = Color3.fromRGB(255, 255, 255)
                    rootPart.Material = Enum.Material.Plastic
                end
            end)
        end
    end
end

-- بدء التشغيل
startLoop()

print("[+] تم تحميل سكربت الـ Hitbox بنجاح")

-- ============================================
-- API للتحكم من الـ GUI الرئيسي
-- ============================================
local BotsHitboxAPI = {}

function BotsHitboxAPI:SetEnabled(State)
    IsActive = State
    if State then
        startLoop()
        print("[Bots Hitbox] تم التفعيل")
    else
        stopLoopAndClear()
        print("[Bots Hitbox] تم الإيقاف")
    end
end

function BotsHitboxAPI:SetSize(SizeValue)
    Settings.HitboxSize = Vector3.new(SizeValue, SizeValue, SizeValue)
    print("[Bots Hitbox] الحجم:", SizeValue)
end

function BotsHitboxAPI:IsEnabled()
    return IsActive
end

function BotsHitboxAPI:GetSize()
    return Settings.HitboxSize.X
end

return BotsHitboxAPI
