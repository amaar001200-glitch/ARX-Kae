-- [[ Blox Fruits - Custom Hitbox Visualizer & Combat Script (ULTRA OPTIMIZED) ]] --
-- التحديثات:
-- - استبدال RunService.RenderStepped بـ task.wait (10 مرات بالثانية بدل 60-120)
-- - تجميع الأعداء في Cache (تحديث كل 0.5 ثانية)
-- - استهلاك أقل للمعالج بنسبة 85-90%

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

-- إعدادات الـ Hitbox
local Settings = {
    HitboxSize = Vector3.new(40, 40, 40),
    HitboxTransparency = 0.6,
    HitboxColor = Color3.fromRGB(255, 0, 0),
    KillAuraEnabled = true
}

-- استدعاء دوال اللعبة الأساسية
local CombatController = nil
local WeaponToolShared = nil

pcall(function()
    CombatController = require(ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    WeaponToolShared = require(ReplicatedStorage:WaitForChild("SharedComponents"):WaitForChild("WeaponToolShared"))
end)

-- حالة التشغيل
local IsActive = false
local LoopRunning = false
local MainLoop = nil

-- تجميع الأعداء (Cache)
local CachedEnemies = {}
local LastEnemyScan = 0
local EnemyScanInterval = 0.5 -- كل 0.5 ثانية نبحث عن أعداء جدد

-- تحديث قائمة الأعداء المخزنة
local function UpdateCachedEnemies()
    local now = tick()
    if now - LastEnemyScan >= EnemyScanInterval then
        LastEnemyScan = now
        CachedEnemies = {}
        
        -- البحث في مجلد Enemies أولاً
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChildOfClass("Humanoid") then
                    CachedEnemies[#CachedEnemies + 1] = enemy
                end
            end
        end
        
        -- البحث في مجلد Characters
        local charactersFolder = Workspace:FindFirstChild("Characters")
        if charactersFolder then
            for _, character in pairs(charactersFolder:GetChildren()) do
                if character:IsA("Model") and character.Name ~= LocalPlayer.Name then
                    local isRealPlayer = false
                    for _, player in pairs(Players:GetPlayers()) do
                        if player.Character == character then
                            isRealPlayer = true
                            break
                        end
                    end
                    if not isRealPlayer and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
                        CachedEnemies[#CachedEnemies + 1] = character
                    end
                end
            end
        end
    end
    return CachedEnemies
end

-- وظيفة تعديل وتكبير الـ Hitbox للخصم
local function modifyHitbox(character)
    if not IsActive then return end
    if not character or character.Name == LocalPlayer.Name then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if rootPart and humanoid and humanoid.Health > 0 then
        pcall(function()
            rootPart.Size = Settings.HitboxSize
            rootPart.CanCollide = false
            rootPart.Transparency = Settings.HitboxTransparency
            rootPart.Color = Settings.HitboxColor
            rootPart.Material = Enum.Material.ForceField
            
            if Settings.KillAuraEnabled and CombatController and type(CombatController.runHitDetection) == "function" then
                task.spawn(function()
                    pcall(function()
                        CombatController.runHitDetection(character)
                    end)
                end)
            end
        end)
    end
end

-- إعادة حجم البوتات إلى الطبيعي
local function resetBotSize(bot)
    pcall(function()
        local rootPart = bot:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.Size = Vector3.new(2, 2, 1)
            rootPart.Transparency = 0
            rootPart.Color = Color3.fromRGB(255, 255, 255)
            rootPart.Material = Enum.Material.Plastic
        end
    end)
end

-- مسح جميع التعديلات
local function clearAllModifications()
    for _, enemy in ipairs(CachedEnemies) do
        resetBotSize(enemy)
    end
end

-- الحلقة الرئيسية (خفيفة جداً)
local function startLoop()
    if LoopRunning then return end
    LoopRunning = true
    
    MainLoop = task.spawn(function()
        while LoopRunning do
            if IsActive then
                local enemies = UpdateCachedEnemies()
                for _, enemy in ipairs(enemies) do
                    modifyHitbox(enemy)
                end
            end
            task.wait(0.1) -- 10 مرات بالثانية فقط
        end
    end)
end

local function stopLoop()
    LoopRunning = false
    if MainLoop then
        task.cancel(MainLoop)
        MainLoop = nil
    end
    clearAllModifications()
end

-- ============================================
-- API للتحكم من الـ GUI الرئيسي
-- ============================================
local BotsHitboxAPI = {}

function BotsHitboxAPI:SetEnabled(State)
    IsActive = State
    if State then
        startLoop()
        print("[Bots Hitbox] تم التفعيل")
    else
        stopLoop()
        print("[Bots Hitbox] تم الإيقاف")
    end
end

function BotsHitboxAPI:SetSize(SizeValue)
    Settings.HitboxSize = Vector3.new(SizeValue, SizeValue, SizeValue)
    print("[Bots Hitbox] الحجم:", SizeValue)
end

function BotsHitboxAPI:IsEnabled()
    return IsActive
end

function BotsHitboxAPI:GetSize()
    return Settings.HitboxSize.X
end

return BotsHitboxAPI
